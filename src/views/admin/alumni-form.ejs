<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= alumni ? 'Edit' : 'Tambah' %> Alumni | Tracer Study Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/admin/dashboard.css"/>
  <style>
    /* Styling Form Alumni */
    .form-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 12px;
      box-shadow: var(--shadow);
      margin-top: 20px;
      overflow: hidden;
    }
    .form-card-header {
      padding: 16px 24px;
      border-bottom: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #fafaf9;
    }
    .form-card-header h3 {
      font-size: 14px;
      font-weight: 800;
      color: var(--green-dark);
      margin: 0;
    }
    .alumni-form {
      padding: 24px 32px !important;
    }
    .form-section-title {
      font-size: 12px;
      font-weight: 800;
      color: var(--green-dark);
      margin: 32px 0 16px;
      padding-bottom: 6px;
      border-bottom: 1.5px solid var(--border);
      text-transform: uppercase;
      letter-spacing: 0.8px;
    }
    .form-section-title:first-of-type {
      margin-top: 0;
    }
    .form-row {
      display: flex;
      gap: 20px;
      margin-bottom: 18px;
      flex-wrap: wrap;
    }
    .form-group {
      flex: 1;
      min-width: 200px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .form-group.full {
      flex: 0 0 100%;
    }
    .form-group label {
      font-size: 12px;
      font-weight: 600;
      color: #374151;
      text-align: left;
    }
    .form-group input[type="text"],
    .form-group input[type="email"],
    .form-group input[type="number"],
    .form-group input[type="password"],
    .form-group input[type="date"],
    .form-group select,
    .form-group textarea {
      width: 100%;
      border: 1.5px solid var(--border);
      border-radius: 8px;
      padding: 9px 12px;
      font-size: 13px;
      outline: none;
      font-family: inherit;
      background: #fafaf9;
      color: #1f2937;
      transition: all 0.2s ease;
    }
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      border-color: var(--green-dark);
      background: #fff;
      box-shadow: 0 0 0 3px rgba(6, 78, 59, 0.1);
    }
    .required {
      color: #ef4444;
      margin-left: 2px;
    }
    .form-actions {
      display: flex;
      gap: 12px;
      justify-content: flex-end;
      margin-top: 36px;
      padding-top: 20px;
      border-top: 1px solid var(--border);
    }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 9px 16px;
      font-size: 13px;
      font-weight: 700;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.2s ease;
      text-decoration: none;
    }
    .btn-primary {
      background: var(--green-dark);
      color: #fff;
      border: none;
    }
    .btn-primary:hover {
      background: var(--green-accent);
    }
    .btn-primary svg {
      width: 16px; height: 16px; fill: currentColor;
    }
    .btn-outline {
      border: 1.5px solid #d1e7d9;
      background: #fff;
      color: var(--green-dark);
    }
    .btn-outline:hover {
      background: #f4faf6;
    }
  </style>
</head>
<body>

<%- include('_sidebar', { active: 'alumni' }) %>

<main class="main-content">
  <!-- Topbar -->
  <%- include('_topbar', { breadcrumbs: [{ label: 'Data Alumni', url: '/admin/alumni' }, { label: alumni ? 'Edit Alumni' : 'Tambah Alumni' }] }) %>

  <div class="page-content">
    <div class="page-header">
      <h1><%= alumni ? 'Edit Data Alumni' : 'Tambah Alumni Baru' %></h1>
      <p>Isi data lengkap alumni program studi Sistem Informasi Fakultas Teknik Universitas Hamzanwadi.</p>
    </div>

    <div class="form-card">
      <div class="form-card-header">
        <h3><%= alumni ? 'Edit Data Alumni' : 'Form Tambah Alumni' %></h3>
        <a href="/admin/alumni" class="btn btn-outline">← Kembali</a>
      </div>

      <% if (error) { %>
      <div style="padding:0 20px;margin-top:14px;"><div class="alert alert-error"><%= error %></div></div>
      <% } %>

      <form action="/admin/alumni/<%= alumni ? alumni.id + '/edit' : 'tambah' %>" method="POST" class="alumni-form" style="padding: 20px;">
        
        <!-- SECTION 1: Data Pribadi & Akademik -->
        <div class="form-section-title">Data Pribadi & Akademik</div>
        
        <div class="form-row">
          <div class="form-group">
            <label>NIM <span class="required">*</span></label>
            <input type="text" name="nim" value="<%= alumni ? alumni.nim : '' %>" required placeholder="Contoh: 20010101"/>
          </div>
          <div class="form-group">
            <label>Nama Lengkap <span class="required">*</span></label>
            <input type="text" name="nama" value="<%= alumni ? alumni.nama : '' %>" required placeholder="Nama lengkap alumni"/>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Email <span class="required">*</span></label>
            <input type="email" name="email" value="<%= alumni ? alumni.email : '' %>" required placeholder="email@example.com"/>
          </div>
          <div class="form-group">
            <label>No. HP</label>
            <input type="text" name="no_hp" value="<%= alumni ? alumni.no_hp || '' : '' %>" placeholder="08xxxxxxxxxx"/>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Fakultas</label>
            <input type="text" name="fakultas" value="<%= alumni ? alumni.fakultas || 'Fakultas Teknik' : 'Fakultas Teknik' %>" placeholder="Fakultas Teknik"/>
          </div>
          <div class="form-group">
            <label>Program Studi</label>
            <input type="text" name="program_studi" value="<%= alumni ? alumni.program_studi || 'Sistem Informasi' : 'Sistem Informasi' %>" placeholder="Sistem Informasi"/>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Tahun Masuk</label>
            <input type="number" name="tahun_masuk" value="<%= alumni ? alumni.tahun_masuk || '' : '' %>" min="2000" max="2035" placeholder="2020"/>
          </div>
          <div class="form-group">
            <label>Tahun Lulus <span class="required">*</span></label>
            <input type="number" name="tahun_lulus" value="<%= alumni ? alumni.tahun_lulus || '' : '' %>" required min="2000" max="2035" placeholder="2024"/>
          </div>
          <div class="form-group">
            <label>Angkatan</label>
            <input type="text" name="angkatan" value="<%= alumni ? alumni.angkatan || '' : '' %>" placeholder="2020"/>
          </div>
          <div class="form-group">
            <label>IPK Terakhir</label>
            <input type="number" name="ipk_terakhir" step="0.01" min="0" max="4" value="<%= alumni ? alumni.ipk_terakhir || '' : '' %>" placeholder="3.75"/>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Jenis Kelamin</label>
            <select name="jenis_kelamin">
              <option value="">-- Pilih --</option>
              <option value="L" <%= alumni && alumni.jenis_kelamin === 'L' ? 'selected' : '' %>>Laki-laki</option>
              <option value="P" <%= alumni && alumni.jenis_kelamin === 'P' ? 'selected' : '' %>>Perempuan</option>
            </select>
          </div>
          <div class="form-group">
            <label>Tempat Lahir</label>
            <input type="text" name="tempat_lahir" value="<%= alumni ? alumni.tempat_lahir || '' : '' %>" placeholder="Jakarta"/>
          </div>
          <div class="form-group">
            <label>Tanggal Lahir</label>
            <input type="date" name="tanggal_lahir" value="<%= alumni && alumni.tanggal_lahir ? new Date(alumni.tanggal_lahir).toISOString().split('T')[0] : '' %>"/>
          </div>
        </div>

        <div class="form-group">
          <label>Alamat Lengkap</label>
          <textarea name="alamat" rows="3" placeholder="Masukkan alamat lengkap alumni" style="width:100%; border:1px solid var(--border); border-radius:8px; padding:10px; font-family:inherit; font-size:13px; outline:none;"><%= alumni ? alumni.alamat || '' : '' %></textarea>
        </div>

        <!-- SECTION 2: Kredensial Login -->
        <div class="form-section-title">Kredensial Login</div>

        <div class="form-group" style="max-width: 480px;">
          <label>Password Alumni <span class="required">*</span></label>
          <div style="position:relative;">
            <input type="password" id="passwordInput" name="password" required value="<%= alumni ? (alumni.password_plain || 'alumni123') : 'alumni123' %>" placeholder="Masukkan password alumni" style="padding-right:44px;"/>
            <button type="button" id="togglePassword" onclick="togglePasswordVisibility()" style="position:absolute; right:8px; top:50%; transform:translateY(-50%); background:none; border:none; cursor:pointer; padding:6px; color:var(--text-light); display:flex; align-items:center;" title="Tampilkan/Sembunyikan Password">
              <svg id="eyeIcon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
              </svg>
            </button>
          </div>
          <small class="hint" style="color:var(--text-light); font-size:11px; display:block; margin-top:4px;">Ubah teks password di atas untuk mengganti password alumni secara langsung.</small>
        </div>

        <div class="form-actions" style="margin-top: 32px;">
          <a href="/admin/alumni" class="btn btn-outline">Batal</a>
          <button type="submit" class="btn btn-primary">
            <svg viewBox="0 0 24 24"><path d="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z"/></svg>
            Simpan Alumni
          </button>
        </div>
      </form>
    </div>
  </div>
</main>

<script>
function toggleSidebar() { document.getElementById('sidebar').classList.toggle('open'); }

function togglePasswordVisibility() {
  const input = document.getElementById('passwordInput');
  const icon = document.getElementById('eyeIcon');
  if (input.type === 'password') {
    input.type = 'text';
    icon.innerHTML = '<path d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z"/>';
  } else {
    input.type = 'password';
    icon.innerHTML = '<path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>';
  }
}
</script>
</body>
</html>
