<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Kelola Konselor Karir | Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/admin/dashboard.css"/>
  <style>
    .konselor-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 24px;
      margin-top: 24px;
    }
    .konselor-card {
      background: #ffffff;
      border: 1px solid var(--border, #e2e8f0);
      border-radius: 16px;
      padding: 28px 24px 20px;
      box-shadow: 0 4px 14px rgba(6, 78, 59, 0.04);
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      transition: all 0.25s ease;
      position: relative;
    }
    .konselor-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 28px rgba(6, 78, 59, 0.1);
      border-color: #a7f3d0;
    }
    .konselor-img {
      width: 90px;
      height: 90px;
      border-radius: 50%;
      object-fit: cover;
      border: 3.5px solid var(--border, #e2e8f0);
      background: #f3f4f6;
      margin-bottom: 16px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.06);
    }
    .konselor-name {
      font-size: 15px;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 4px;
    }
    .konselor-expertise {
      font-size: 12px;
      color: #047857;
      background: #ecfdf5;
      border: 1px solid #a7f3d0;
      padding: 4px 12px;
      border-radius: 20px;
      font-weight: 700;
      margin-bottom: 20px;
    }
    .btn-delete-konselor {
      border: 1px solid #fecaca;
      background: #fef2f2;
      color: #dc2626;
      padding: 8px 16px;
      border-radius: 8px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      width: 100%;
      transition: all 0.2s ease;
    }
    .btn-delete-konselor:hover {
      background: #fee2e2;
      color: #b91c1c;
    }
  </style>
</head>
<body>

<%- include('_sidebar', { active: 'konseling' }) %>

<main class="main-content">
  <!-- Topbar -->
  <%- include('_topbar', { breadcrumbs: [{ label: 'Admin', url: '/admin/dashboard' }, { label: 'Konselor Karir' }] }) %>

  <div class="page-content">
    <!-- Header -->
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
      <div>
        <h2 style="font-size: 20px; font-weight: 800; color: #064E3B;">Daftar Konselor Karir</h2>
        <p style="font-size:12px; color:#666; margin-top:4px;">Kelola daftar profil konselor karir untuk layanan bimbingan karir alumni.</p>
      </div>
      <a href="/admin/konseling/tambah-konselor" class="btn btn-primary" style="text-decoration:none; display:inline-flex; align-items:center; gap:6px;">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
        + Tambah Konselor
      </a>
    </div>

    <!-- Flash Messages -->
    <% if (flash_success) { %>
    <div class="alert alert-success" style="margin-top:20px; padding:12px; border-radius:8px; background:#f0fdf4; border:1px solid #bbf7d0; color:#16a34a; font-size:13px;"><%= flash_success %></div>
    <% } %>
    <% if (flash_error) { %>
    <div class="alert alert-error" style="margin-top:20px; padding:12px; border-radius:8px; background:#fef2f2; border:1px solid #fecaca; color:#dc2626; font-size:13px;"><%= flash_error %></div>
    <% } %>

    <!-- Counselor Grid -->
    <div class="konselor-grid">
      <% if (!konselorList || konselorList.length === 0) { %>
      <div style="grid-column:1/-1; text-align:center; padding:48px; color:#9ca3af; background:#fff; border:1px dashed var(--border); border-radius:12px;">
        Belum ada data konselor karir.
      </div>
      <% } else { %>
      <% konselorList.forEach(function(k) { %>
      <div class="konselor-card">
        <img src="<%= k.foto || '/images/default_avatar.jpg' %>" alt="<%= k.nama %>" class="konselor-img" onerror="this.src='/images/default_avatar.jpg'"/>
        <div class="konselor-name"><%= k.nama %></div>
        <div class="konselor-expertise"><%= k.bidang_keahlian %></div>
        
        <form action="/admin/konseling/delete/<%= k.id %>" method="POST" style="width:100%;" onsubmit="return confirm('Apakah Anda yakin ingin menghapus konselor ini?')">
          <button type="submit" class="btn-delete-konselor">Hapus Konselor</button>
        </form>
      </div>
      <% }) %>
      <% } %>
    </div>

    <!-- Footer -->
    <div style="text-align:center; border-top:1px solid #e2e8f0; padding-top:16px; font-size:11px; color:#777; margin-top:32px;">
      &copy; 2026 Information Systems Fakultas Teknik Hamzanwadi University. All Rights Reserved.
    </div>
  </div>
</main>

<script>
  function toggleSidebar() {
    document.getElementById('sidebar').classList.toggle('open');
  }
</script>
</body>
</html>
