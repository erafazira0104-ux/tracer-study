<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Kelola Konselor Karir | Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/admin/dashboard.css"/>
  <style>
    .konselor-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 24px;
      margin-top: 24px;
    }
    .konselor-card {
      background: #ffffff;
      border: 1px solid var(--border, #e2e8f0);
      border-radius: 16px;
      padding: 28px 24px 20px;
      box-shadow: 0 4px 14px rgba(6, 78, 59, 0.04);
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      transition: all 0.25s ease;
      position: relative;
    }
    .konselor-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 28px rgba(6, 78, 59, 0.1);
      border-color: #a7f3d0;
    }
    .konselor-img {
      width: 90px;
      height: 90px;
      border-radius: 50%;
      object-fit: cover;
      border: 3.5px solid #d1fae5;
      background: #f3f4f6;
      margin-bottom: 16px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.06);
      display: block;
    }
    .konselor-avatar-placeholder {
      width: 90px;
      height: 90px;
      border-radius: 50%;
      background: linear-gradient(135deg, #ecfdf5, #d1fae5);
      border: 3.5px solid #a7f3d0;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 16px;
      box-shadow: 0 4px 10px rgba(6,78,59,0.08);
      flex-shrink: 0;
    }
    .konselor-avatar-placeholder svg {
      width: 44px;
      height: 44px;
      fill: #059669;
      opacity: 0.85;
    }
    .konselor-name {
      font-size: 15px;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 4px;
    }
    .konselor-expertise {
      font-size: 12px;
      color: #047857;
      background: #ecfdf5;
      border: 1px solid #a7f3d0;
      padding: 4px 12px;
      border-radius: 20px;
      font-weight: 700;
      margin-bottom: 20px;
    }
    .btn-delete-konselor {
      border: 1px solid #fecaca;
      background: #fef2f2;
      color: #dc2626;
      padding: 8px 16px;
      border-radius: 8px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      width: 100%;
      transition: all 0.2s ease;
    }
    .btn-delete-konselor:hover {
      background: #fee2e2;
      color: #b91c1c;
    }
  </style>
</head>
<body>

<%- include('_sidebar', { active: 'konseling' }) %>

<main class="main-content">
  <!-- Topbar -->
  <%- include('_topbar', { breadcrumbs: [{ label: 'Admin', url: '/admin/dashboard' }, { label: 'Konselor Karir' }] }) %>

  <div class="page-content">
    <!-- Header -->
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
      <div>
        <h2 style="font-size: 20px; font-weight: 800; color: #064E3B;">Daftar Konselor Karir</h2>
        <p style="font-size:12px; color:#666; margin-top:4px;">Kelola daftar profil konselor karir untuk layanan bimbingan karir alumni.</p>
      </div>
      <div style="display:flex; gap:10px; flex-wrap:wrap;">
        <a href="/admin/konseling/booking" class="btn btn-outline" style="text-decoration:none; display:inline-flex; align-items:center; gap:6px;">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg>
          Daftar Booking Konseling
        </a>
        <a href="/admin/konseling/tambah-konselor" class="btn btn-primary" style="text-decoration:none; display:inline-flex; align-items:center; gap:6px;">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
          + Tambah Konselor
        </a>
      </div>
    </div>

    <!-- Flash Messages -->
    <% if (flash_success) { %>
    <div class="alert alert-success" style="margin-top:20px; padding:12px; border-radius:8px; background:#f0fdf4; border:1px solid #bbf7d0; color:#16a34a; font-size:13px;"><%= flash_success %></div>
    <% } %>
    <% if (flash_error) { %>
    <div class="alert alert-error" style="margin-top:20px; padding:12px; border-radius:8px; background:#fef2f2; border:1px solid #fecaca; color:#dc2626; font-size:13px;"><%= flash_error %></div>
    <% } %>

    <!-- Counselor Grid -->
    <div class="konselor-grid">
      <% if (!konselorList || konselorList.length === 0) { %>
      <div style="grid-column:1/-1; text-align:center; padding:48px; color:#9ca3af; background:#fff; border:1px dashed var(--border); border-radius:12px;">
        Belum ada data konselor karir.
      </div>
      <% } else { %>
      <% konselorList.forEach(function(k) { %>
      <div class="konselor-card">
        <% if (k.foto) { %>
        <img src="<%= k.foto %>" alt="<%= k.nama %>" class="konselor-img"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"/>
        <div class="konselor-avatar-placeholder" style="display:none;">
          <svg viewBox="0 0 24 24"><path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/></svg>
        </div>
        <% } else { %>
        <div class="konselor-avatar-placeholder">
          <svg viewBox="0 0 24 24"><path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/></svg>
        </div>
        <% } %>
        <div class="konselor-name"><%= k.nama %></div>
        <div class="konselor-expertise"><%= k.bidang_keahlian %></div>
        <div style="font-size:12px; color:#475569; font-weight:600; margin-bottom:14px; display:flex; align-items:center; justify-content:center; gap:6px;">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="#059669"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg>
          <%= k.whatsapp ? ('+' + (k.whatsapp.startsWith('62') ? k.whatsapp : ('62' + k.whatsapp.replace(/^0/, '')))) : 'WhatsApp Belum Diatur' %>
        </div>
        
        <div style="display:flex; gap:10px; width:100%; margin-top:auto;">
          <a href="/admin/konseling/edit/<%= k.id %>" class="btn btn-outline" style="flex:1; text-decoration:none; padding:8px 0; font-size:12px; font-weight:700; text-align:center; display:block; border-radius:8px;">Edit Profil</a>
          <form action="/admin/konseling/delete/<%= k.id %>" method="POST" style="flex:1;" onsubmit="return confirm('Apakah Anda yakin ingin menghapus konselor ini?')">
            <button type="submit" class="btn-delete-konselor" style="padding:8px 0;">Hapus</button>
          </form>
        </div>
      </div>
      <% }) %>
      <% } %>
    </div>

    <!-- SECTION TEMPLATE WHATSAPP -->
    <div style="margin-top:36px; background:#fff; border:1px solid #e2e8f0; border-radius:16px; padding:24px; box-shadow: 0 4px 14px rgba(0,0,0,0.03);">
      <div style="display:flex; align-items:center; gap:10px; margin-bottom:12px;">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="#059669"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg>
        <h3 style="font-size:16px; font-weight:800; color:#064E3B; margin:0;">Pengaturan Template Pesan WhatsApp Otomatis</h3>
      </div>
      <p style="font-size:12px; color:#64748b; margin-bottom:16px; line-height:1.6;">
        Atur redaksi kalimat default pesan WhatsApp yang akan dikirim oleh alumni saat menghubungi konselor. Gunakan tag variabel di bawah ini agar teks otomatis terisi sesuai data alumni &amp; konselor.
      </p>

      <div style="display:flex; flex-wrap:wrap; gap:8px; margin-bottom:16px;">
        <span style="font-size:11px; background:#ecfdf5; border:1px solid #a7f3d0; color:#047857; padding:4px 10px; border-radius:6px; font-weight:700;">{NAMA_KONSELOR}</span>
        <span style="font-size:11px; background:#ecfdf5; border:1px solid #a7f3d0; color:#047857; padding:4px 10px; border-radius:6px; font-weight:700;">{SAPAAN_KONSELOR}</span>
        <span style="font-size:11px; background:#ecfdf5; border:1px solid #a7f3d0; color:#047857; padding:4px 10px; border-radius:6px; font-weight:700;">{SAPAAN_PENDEK}</span>
        <span style="font-size:11px; background:#ecfdf5; border:1px solid #a7f3d0; color:#047857; padding:4px 10px; border-radius:6px; font-weight:700;">{NAMA_ALUMNI}</span>
        <span style="font-size:11px; background:#ecfdf5; border:1px solid #a7f3d0; color:#047857; padding:4px 10px; border-radius:6px; font-weight:700;">{TAHUN_LULUS}</span>
      </div>

      <form action="/admin/konseling/template-wa" method="POST" style="display:flex; flex-direction:column; gap:16px;">
        <div>
          <label style="font-size:12px; font-weight:700; color:#334155; display:block; margin-bottom:6px;">Draf Pesan WhatsApp Otomatis:</label>
          <textarea name="template_wa" rows="6" required style="width:100%; border:1.5px solid #cbd5e1; border-radius:10px; padding:12px; font-size:13px; font-family:inherit; outline:none; line-height:1.6; color:#1e293b; background:#f8fafc;"><%= typeof waTemplate !== 'undefined' ? waTemplate : '' %></textarea>
        </div>

        <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:12px; padding:16px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;">
          <div>
            <label style="font-size:12px; font-weight:800; color:#064E3B; display:block; margin-bottom:2px;">Nomor WhatsApp Resmi Administrator / IT Support:</label>
            <p style="font-size:11px; color:#64748b; margin:0;">Nomor aktif: <strong>+<%= typeof whatsappAdmin !== 'undefined' ? (whatsappAdmin.startsWith('62') ? whatsappAdmin : ('62' + whatsappAdmin.replace(/^0/, ''))) : '6281936791163' %></strong> (Terintegrasi penuh dengan seluruh tombol bantuan sistem).</p>
          </div>
          <a href="/admin/pengaturan" class="btn btn-outline" style="text-decoration:none; font-size:11px; font-weight:700; padding:6px 12px; border-radius:8px;">⚙️ Ubah di Profil Admin</a>
        </div>
        
        <div style="display:flex; justify-content:flex-end;">
          <button type="submit" class="btn btn-primary" style="cursor:pointer; display:inline-flex; align-items:center; gap:6px;">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z"/></svg>
            Simpan Pengaturan WhatsApp
          </button>
        </div>
      </form>
    </div>

    <!-- Footer -->
    <div style="text-align:center; border-top:1px solid #e2e8f0; padding-top:16px; font-size:11px; color:#777; margin-top:32px;">
      &copy; 2026 Information Systems Fakultas Teknik Universitas Hamzanwadi. All Rights Reserved.
    </div>
  </div>
</main>

<script>
  function toggleSidebar() {
    document.getElementById('sidebar').classList.toggle('open');
  }
</script>
</body>
</html>
