<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Pratinjau Laporan | Admin Tracer Study — Sistem Informasi FT Hamzanwadi</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/admin/dashboard.css"/>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
  <style>

    /* ===========================
       ACTION BAR (sticky top)
    =========================== */
    .preview-action-bar {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 16px 20px;
      margin-bottom: 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      box-shadow: var(--shadow);
    }
    .preview-bar-left h2 {
      font-size: 16px;
      font-weight: 800;
      color: var(--text);
      margin-bottom: 2px;
    }
    .preview-bar-left p {
      font-size: 12px;
      color: var(--text-secondary);
    }
    .preview-bar-right {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    .btn-bar {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 9px 18px;
      border-radius: 10px;
      font-size: 12.5px;
      font-weight: 700;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.22s ease;
      border: none;
      font-family: inherit;
    }
    .btn-bar svg { width: 14px; height: 14px; fill: currentColor; }
    .btn-bar.back {
      background: var(--gray-light);
      color: var(--text-secondary);
      border: 1.5px solid var(--border);
    }
    .btn-bar.back:hover { background: var(--gray-mid); color: var(--text); }
    .btn-bar.excel {
      background: #ecfdf5;
      color: #047857;
      border: 1.5px solid #a7f3d0;
    }
    .btn-bar.excel:hover { background: #d1fae5; border-color: #6ee7b7; }
    .btn-bar.pdf {
      background: linear-gradient(135deg, #064E3B 0%, #047857 100%);
      color: #fff;
      box-shadow: 0 3px 10px rgba(6, 78, 59, 0.22);
    }
    .btn-bar.pdf:hover {
      background: linear-gradient(135deg, #043d2e 0%, #036346 100%);
      box-shadow: 0 5px 16px rgba(6, 78, 59, 0.3);
      transform: translateY(-1px);
    }
    .btn-bar.pdf.loading {
      opacity: 0.75;
      pointer-events: none;
    }

    /* ===========================
       DOCUMENT PAPER WRAPPER
    =========================== */
    .doc-paper-shadow {
      background: #e8ecf0;
      border-radius: 16px;
      padding: 28px;
    }

    #printable-area {
      background: #fff;
      border-radius: 12px;
      box-shadow: 0 8px 40px rgba(0,0,0,0.10);
      overflow: hidden;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .doc-kop {
      background: linear-gradient(135deg, #064E3B 0%, #047857 60%, #059669 100%);
      padding: 32px 40px 28px;
      position: relative;
      overflow: hidden;
    }
    .doc-kop::before {
      content: '';
      position: absolute;
      top: -50px; right: -50px;
      width: 200px; height: 200px;
      border-radius: 50%;
      background: rgba(255,255,255,0.05);
    }
    .doc-kop::after {
      content: '';
      position: absolute;
      bottom: -30px; left: 40%;
      width: 140px; height: 140px;
      border-radius: 50%;
      background: rgba(255,255,255,0.04);
    }
    .doc-kop-inner {
      position: relative; z-index: 1;
      display: flex;
      align-items: center;
      gap: 24px;
    }
    .doc-kop-logo {
      width: 72px; height: 72px;
      border-radius: 50%;
      background: rgba(255,255,255,0.15);
      border: 2px solid rgba(255,255,255,0.3);
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .doc-kop-logo svg { width: 36px; height: 36px; fill: #fff; }
    .doc-kop-divider {
      width: 2px; height: 70px;
      background: rgba(255,255,255,0.25);
      flex-shrink: 0;
    }
    .doc-kop-text { flex: 1; }
    .doc-kop-univ {
      font-size: 20px;
      font-weight: 800;
      color: #fff;
      letter-spacing: 0.5px;
      line-height: 1.2;
      margin-bottom: 4px;
    }
    .doc-kop-fakultas {
      font-size: 13px;
      font-weight: 600;
      color: rgba(255,255,255,0.85);
      margin-bottom: 2px;
    }
    .doc-kop-prodi {
      font-size: 12px;
      color: rgba(255,255,255,0.70);
    }
    .doc-kop-alamat {
      font-size: 10.5px;
      color: rgba(255,255,255,0.55);
      margin-top: 6px;
    }

    .doc-kop-stripe {
      height: 4px;
      background: linear-gradient(90deg, #10b981, #fbbf24, #10b981);
    }

    .doc-title-bar {
      padding: 22px 40px 18px;
      border-bottom: 2px solid #f1f5f9;
      background: #f8fafc;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
    }
    .doc-title-bar-left h3 {
      font-size: 16px;
      font-weight: 800;
      color: #064E3B;
      margin-bottom: 3px;
    }
    .doc-title-bar-left p {
      font-size: 11px;
      color: #64748b;
    }
    .doc-meta-pills {
      display: flex; gap: 8px;
    }
    .doc-meta-pill {
      font-size: 11px; font-weight: 700;
      padding: 4px 12px; border-radius: 20px;
      display: inline-flex; align-items: center; gap: 5px;
    }
    .doc-meta-pill.green { background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; }
    .doc-meta-pill.blue  { background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; }
    .doc-meta-pill svg { width: 12px; height: 12px; fill: currentColor; }

    .doc-body { padding: 30px 40px 40px; }
    .doc-table-wrap { overflow-x: auto; }
    .doc-table {
      width: 100%; border-collapse: collapse; font-size: 12px;
    }
    .doc-table th {
      background: #064E3B; color: #fff;
      padding: 10px 12px; font-size: 11px; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.4px;
      border: 1px solid #043d2e; text-align: left;
    }
    .doc-table td {
      padding: 10px 12px; border: 1px solid #e2e8f0;
      color: #1e293b; vertical-align: middle;
    }
    .doc-table tbody tr:nth-child(even) { background: #f8fafc; }
    .doc-table tbody tr:hover { background: #f1f5f9; }
    .doc-no { text-align: center; font-weight: 700; color: #64748b; }
    .doc-nama { font-weight: 700; color: #064E3B; }
    .doc-nim { font-family: monospace; font-size: 11px; color: #475569; }
    .doc-empty { text-align: center; padding: 40px; color: #94a3b8; font-size: 13px; }

    .st-badge {
      display: inline-block; padding: 3px 9px; border-radius: 12px;
      font-size: 10.5px; font-weight: 700;
    }
    .st-bekerja       { background: #ecfdf5; color: #047857; }
    .st-wirausaha     { background: #eff6ff; color: #1d4ed8; }
    .st-studi         { background: #f5f3ff; color: #7c3aed; }
    .st-belum_bekerja { background: #fffbeb; color: #b45309; }
    .st-sudah         { background: #ecfdf5; color: #047857; }
    .st-belum         { background: #fffbeb; color: #b45309; }

    .doc-footer {
      padding: 20px 40px 28px;
      border-top: 1px solid #e2e8f0;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      flex-wrap: wrap;
      gap: 16px;
    }
    .doc-footer-left { font-size: 11px; color: #6b7280; line-height: 1.8; }
    .doc-footer-left strong { color: #374151; display: block; margin-bottom: 2px; }
    .doc-footer-right { text-align: right; font-size: 11px; color: #6b7280; line-height: 1.8; }
    .doc-footer-right .doc-total {
      font-size: 15px; font-weight: 800; color: #064E3B;
    }

    .toast-notify {
      position: fixed;
      bottom: 28px; right: 28px;
      background: #064E3B;
      color: #fff;
      border-radius: 12px;
      padding: 14px 20px;
      font-size: 13px;
      font-weight: 600;
      display: flex; align-items: center; gap: 10px;
      box-shadow: 0 8px 30px rgba(6, 78, 59, 0.3);
      transform: translateY(120%);
      transition: transform 0.35s cubic-bezier(0.4,0,0.2,1);
      z-index: 9999;
    }
    .toast-notify.show { transform: translateY(0); }
    .toast-notify svg { width: 18px; height: 18px; fill: currentColor; flex-shrink: 0; }

    @media print {
      body * { visibility: hidden; }
      #printable-area, #printable-area * { visibility: visible; }
      #printable-area {
        position: fixed;
        left: 0; top: 0;
        width: 100%;
        border: none;
        box-shadow: none;
        border-radius: 0;
      }
      .doc-kop { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .doc-table thead tr { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    }
  </style>
</head>
<body>

<%- include('_sidebar', { active: 'laporan' }) %>

<main class="main-content">
  <%- include('_topbar', {
    breadcrumbs: [{ label: 'Laporan', url: '/admin/laporan' }, { label: 'Pratinjau' }],
    showSearch: false
  }) %>

  <div class="page-content" style="background:#f1f5f9; min-height: calc(100vh - 60px); padding: 24px 28px 40px;">

    <!-- ACTION BAR -->
    <div class="preview-action-bar">
      <div class="preview-bar-left">
        <h2>
          <% if (type === 'konseling') { %>Pratinjau: Laporan Konseling Karir
          <% } else if (type === 'lowongan') { %>Pratinjau: Laporan Akses Lowongan
          <% } else if (type === 'prodi') { %>Pratinjau: Laporan Penilaian Program Studi
          <% } else { %>Pratinjau: Laporan Hasil Tracer Study<% } %>
        </h2>
        <p>Periksa dokumen sebelum diunduh. Pastikan data sudah benar.</p>
      </div>
      <div class="preview-bar-right">
        <a href="/admin/laporan" class="btn-bar back" id="btn-kembali">
          <svg viewBox="0 0 24 24"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
          Kembali
        </a>
        <%
          let exportUrl = '/admin/laporan/export/tracer';
          if (typeof statusFilter !== 'undefined' && statusFilter) {
            exportUrl += '?status=' + statusFilter;
          }
          if (type === 'konseling') exportUrl = '/admin/laporan/export/konseling';
          else if (type === 'lowongan') exportUrl = '/admin/laporan/export/lowongan';
          else if (type === 'prodi') exportUrl = '/admin/laporan/export/prodi';
        %>
        <a href="<%= exportUrl %>" class="btn-bar excel" id="btn-unduh-excel">
          <svg viewBox="0 0 24 24"><path d="M21.17 3.25c-.27-.27-.63-.42-1-.42H3.83c-.37 0-.73.15-1 .42-.27.27-.42.63-.42 1v15.5c0 .37.15.73.42 1 .27.27.63.42 1 .42h16.34c.37 0 .73-.15 1-.42.27-.27.42-.63.42-1V4.25c0-.37-.15-.73-.42-1zm-1.5 16.5H4.33V4.83h15.34v14.92zM7 7h10v2H7zm0 4h10v2H7zm0 4h7v2H7z"/></svg>
          Unduh Excel
        </a>
        <button onclick="downloadPDF()" class="btn-bar pdf" id="btn-unduh-pdf">
          <svg viewBox="0 0 24 24"><path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm-1 7V3.5L18.5 9H13zm-2 9H7v-2h4v2zm2-4H7v-2h6v2zm2-6h-1V4l5 5h-4z"/></svg>
          Unduh PDF
        </button>
      </div>
    </div>

    <% if (type === 'tracer') { %>
      <div style="background: #ffffff; border: 1.5px solid #cbd5e1; border-radius: 14px; padding: 14px 20px; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.03);">
        <div style="font-size: 13px; font-weight: 800; color: #064E3B; display: flex; align-items: center; gap: 8px;">
          <span>🔍 Filter Status Karir:</span>
        </div>
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
          <% const activeSt = typeof statusFilter !== 'undefined' ? statusFilter : 'semua'; %>
          <a href="/admin/laporan/preview?type=tracer&status=semua" style="padding: 7px 16px; border-radius: 20px; font-size: 12px; font-weight: 800; text-decoration: none; transition: all 0.2s ease; <%= activeSt === 'semua' ? 'background: #064E3B; color: #ffffff; box-shadow: 0 4px 12px rgba(6,78,59,0.2);' : 'background: #f8fafc; color: #475569; border: 1px solid #cbd5e1;' %>">🌐 Semua Status</a>
          <a href="/admin/laporan/preview?type=tracer&status=bekerja" style="padding: 7px 16px; border-radius: 20px; font-size: 12px; font-weight: 800; text-decoration: none; transition: all 0.2s ease; <%= activeSt === 'bekerja' ? 'background: #064E3B; color: #ffffff; box-shadow: 0 4px 12px rgba(6,78,59,0.2);' : 'background: #f8fafc; color: #475569; border: 1px solid #cbd5e1;' %>">💼 Bekerja</a>
          <a href="/admin/laporan/preview?type=tracer&status=wirausaha" style="padding: 7px 16px; border-radius: 20px; font-size: 12px; font-weight: 800; text-decoration: none; transition: all 0.2s ease; <%= activeSt === 'wirausaha' ? 'background: #064E3B; color: #ffffff; box-shadow: 0 4px 12px rgba(6,78,59,0.2);' : 'background: #f8fafc; color: #475569; border: 1px solid #cbd5e1;' %>">🏪 Wirausaha</a>
          <a href="/admin/laporan/preview?type=tracer&status=kuliah" style="padding: 7px 16px; border-radius: 20px; font-size: 12px; font-weight: 800; text-decoration: none; transition: all 0.2s ease; <%= activeSt === 'kuliah' ? 'background: #064E3B; color: #ffffff; box-shadow: 0 4px 12px rgba(6,78,59,0.2);' : 'background: #f8fafc; color: #475569; border: 1px solid #cbd5e1;' %>">🎓 Studi Lanjut</a>
          <a href="/admin/laporan/preview?type=tracer&status=belum_bekerja" style="padding: 7px 16px; border-radius: 20px; font-size: 12px; font-weight: 800; text-decoration: none; transition: all 0.2s ease; <%= activeSt === 'belum_bekerja' ? 'background: #064E3B; color: #ffffff; box-shadow: 0 4px 12px rgba(6,78,59,0.2);' : 'background: #f8fafc; color: #475569; border: 1px solid #cbd5e1;' %>">⏳ Belum Bekerja</a>
        </div>
      </div>
    <% } %>

    <!-- DOKUMEN RESMI (PRINTABLE) -->
    <div class="doc-paper-shadow">
      <div id="printable-area">

        <!-- KOP SURAT -->
        <div class="doc-kop">
          <div class="doc-kop-inner">
            <div class="doc-kop-logo">
              <svg viewBox="0 0 24 24"><path d="M12 3L1 9l11 6 9-4.91V17h2V9M5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82z"/></svg>
            </div>
            <div class="doc-kop-divider"></div>
            <div class="doc-kop-text">
              <div class="doc-kop-univ">UNIVERSITAS HAMZANWADI</div>
              <div class="doc-kop-fakultas">Fakultas Teknik — Program Studi Sistem Informasi</div>
              <div class="doc-kop-prodi">SK BAN-PT: Terakreditasi | PDDIKTI: Terdaftar</div>
              <div class="doc-kop-alamat">Jl. TGKH. Muhammad Zainuddin Abdul Madjid No.132, Pancor, Selong, Lombok Timur, NTB 83612</div>
            </div>
          </div>
        </div>
        <div class="doc-kop-stripe"></div>

        <!-- JUDUL LAPORAN -->
        <div class="doc-title-bar">
          <div class="doc-title-bar-left">
            <h3>
              <% if (type === 'konseling') { %>
                LAPORAN SESI KONSELING KARIR ALUMNI
              <% } else if (type === 'lowongan') { %>
                LAPORAN AKSES LOWONGAN KERJA ALUMNI
              <% } else if (type === 'prodi') { %>
                LAPORAN PENILAIAN PROGRAM STUDI & EVALUASI KURIKULUM
              <% } else { %>
                LAPORAN HASIL TRACER STUDY ALUMNI
                <% if (typeof statusFilter !== 'undefined' && statusFilter !== 'semua') { %>
                  <br><span style="font-size: 0.72em; color: #047857; text-transform: uppercase; font-weight: 800; letter-spacing: 0.5px;">
                    [ KATEGORI: <%= statusFilter === 'kuliah' ? 'STUDI LANJUT' : statusFilter.replace('_', ' ').toUpperCase() %> ]
                  </span>
                <% } %>
              <% } %>
            </h3>
            <p>Program Studi Sistem Informasi &mdash; Fakultas Teknik &mdash; Universitas Hamzanwadi</p>
          </div>
          <div class="doc-meta-pills">
            <span class="doc-meta-pill green">
              <svg viewBox="0 0 24 24"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z"/></svg>
              Tahun <%= new Date().getFullYear() %>
            </span>
            <span class="doc-meta-pill blue">
              <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/></svg>
              <%= totalResponden %> Data
            </span>
          </div>
        </div>

        <!-- TABEL DATA -->
        <div class="doc-body">
          <div class="doc-table-wrap">

            <% if (type === 'konseling') { %>
              <table class="doc-table">
                <thead>
                  <tr>
                    <th style="width:40px; text-align:center;">No</th>
                    <th style="width:200px;">Nama Alumni</th>
                    <th style="width:130px;">NIM</th>
                    <th style="width:70px; text-align:center;">Lulus</th>
                    <th style="width:180px;">Konselor</th>
                    <th>Topik / Masalah</th>
                    <th style="width:130px; text-align:center;">Status</th>
                    <th style="width:110px; text-align:center;">Tanggal</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (!data || data.length === 0) { %>
                  <tr><td colspan="8" class="doc-empty">Belum ada data konseling.</td></tr>
                  <% } else { %>
                  <% data.forEach((r, i) => { %>
                  <tr>
                    <td class="doc-no"><%= i+1 %></td>
                    <td class="doc-nama"><%= r.nama %></td>
                    <td class="doc-nim"><%= r.nim || '-' %></td>
                    <td style="text-align:center; font-weight:600; color:#6b7280;"><%= r.tahun_lulus || '-' %></td>
                    <td style="font-weight:600; color:#064E3B;"><%= r.konselor || '-' %></td>
                    <td style="color:#374151;"><%= r.topik %></td>
                    <td style="text-align:center;">
                      <span class="st-badge <%= r.status === 'sudah_dilayani' ? 'st-sudah' : 'st-belum' %>">
                        <%= r.status === 'sudah_dilayani' ? '✓ Sudah Dilayani' : '⏳ Belum Dilayani' %>
                      </span>
                    </td>
                    <td style="text-align:center; font-size:11px; color:#9ca3af;">
                      <%= new Date(r.created_at).toLocaleDateString('id-ID', {day:'numeric', month:'short', year:'numeric'}) %>
                    </td>
                  </tr>
                  <% }) %>
                  <% } %>
                </tbody>
              </table>

            <% } else if (type === 'lowongan') { %>
              <table class="doc-table">
                <thead>
                  <tr>
                    <th style="width:40px; text-align:center;">No</th>
                    <th style="width:200px;">Nama Alumni</th>
                    <th style="width:130px;">NIM</th>
                    <th style="width:170px;">Email</th>
                    <th style="width:110px;">No. HP</th>
                    <th>Lowongan Dilamar</th>
                    <th style="width:160px;">Perusahaan</th>
                    <th style="width:110px; text-align:center;">Tgl Akses</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (!data || data.length === 0) { %>
                  <tr><td colspan="8" class="doc-empty">Belum ada log akses lowongan.</td></tr>
                  <% } else { %>
                  <% data.forEach((r, i) => { %>
                  <tr>
                    <td class="doc-no"><%= i+1 %></td>
                    <td class="doc-nama"><%= r.nama %></td>
                    <td class="doc-nim"><%= r.nim || '-' %></td>
                    <td style="font-size:11px; color:#6b7280;"><%= r.email %></td>
                    <td style="font-size:12px;"><%= r.no_hp || '-' %></td>
                    <td style="font-weight:600; color:#064E3B;"><%= r.nama_lowongan %></td>
                    <td><%= r.perusahaan %></td>
                    <td style="text-align:center; font-size:11px; color:#9ca3af;">
                      <%= new Date(r.created_at).toLocaleDateString('id-ID', {day:'numeric', month:'short', year:'numeric'}) %>
                    </td>
                  </tr>
                  <% }) %>
                  <% } %>
                </tbody>
              </table>

            <% } else if (type === 'prodi') { %>
              <table class="doc-table">
                <thead>
                  <tr>
                    <th style="width:40px; text-align:center;">No</th>
                    <th style="width:180px;">Nama Alumni</th>
                    <th style="width:110px;">NIM</th>
                    <th style="width:60px; text-align:center;">Lulus</th>
                    <th style="width:100px; text-align:center;">Kurikulum</th>
                    <th style="width:90px; text-align:center;">Dosen</th>
                    <th style="width:90px; text-align:center;">Fasilitas</th>
                    <th style="width:90px; text-align:center;">Layanan</th>
                    <th>Saran / Masukan</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (!data || data.length === 0) { %>
                  <tr><td colspan="9" class="doc-empty">Belum ada data penilaian prodi.</td></tr>
                  <% } else { %>
                  <% data.forEach((r, i) => { %>
                  <tr>
                    <td class="doc-no"><%= i+1 %></td>
                    <td class="doc-nama"><%= r.nama %></td>
                    <td class="doc-nim"><%= r.nim || '-' %></td>
                    <td style="text-align:center; font-weight:600; color:#6b7280;"><%= r.tahun_lulus || '-' %></td>
                    <td style="text-align:center; font-weight:700; color:#064E3B;"><%= r.eval_kurikulum || '-' %> / 5</td>
                    <td style="text-align:center; font-weight:700; color:#064E3B;"><%= r.eval_dosen || '-' %> / 5</td>
                    <td style="text-align:center; font-weight:700; color:#064E3B;"><%= r.eval_fasilitas || '-' %> / 5</td>
                    <td style="text-align:center; font-weight:700; color:#064E3B;"><%= r.kepuasan_layanan || '-' %> / 5</td>
                    <td style="font-size:11px; color:#475569;"><%= r.saran || '-' %></td>
                  </tr>
                  <% }) %>
                  <% } %>
                </tbody>
              </table>

            <% } else { %>
              <!-- Tabel Tracer Study Dynamic Question Headers -->
              <% 
                const curStatus = typeof statusFilter !== 'undefined' ? statusFilter : 'semua'; 
                const qCols = (typeof pertanyaanList !== 'undefined' && pertanyaanList && pertanyaanList.length > 0) ? pertanyaanList : [];

                function getAnswerVal(r, q) {
                  if (!r) return '-';
                  let obj = {};
                  if (r.jawaban_kustom) {
                    try {
                      obj = typeof r.jawaban_kustom === 'string' ? JSON.parse(r.jawaban_kustom) : r.jawaban_kustom;
                    } catch(e) {}
                  }
                  if (obj && obj[q.id] !== undefined && obj[q.id] !== null && obj[q.id] !== '') {
                    return obj[q.id];
                  }
                  const text = (q.pertanyaan || '').toLowerCase();
                  if (q.kategori === 'bekerja') {
                    if (text.includes('saat ini sudah bekerja')) return r.status_kerja_detail || (r.status_pekerjaan === 'bekerja' ? 'Sudah bekerja' : '-');
                    if (text.includes('kapan anda mulai mencari')) return r.kapan_mulai_cari_kerja || '-';
                    if (text.includes('berapa lama') || text.includes('waktu yang dibutuhkan')) return r.lama_mencari_kerja || '-';
                    if (text.includes('nama instansi') || text.includes('nama perusahaan')) return r.nama_perusahaan || '-';
                    if (text.includes('jenis instansi')) return r.jenis_instansi || '-';
                    if (text.includes('bidang usaha')) return r.bidang_perusahaan || '-';
                    if (text.includes('jabatan')) return r.jabatan || '-';
                    if (text.includes('lokasi')) return r.lokasi_perusahaan || '-';
                    if (text.includes('status kepegawaian') || text.includes('status pekerjaan')) return r.status_kerja_detail || '-';
                    if (text.includes('penghasilan pertama') || text.includes('gaji pertama')) return r.gaji_pertama || '-';
                    if (text.includes('penghasilan anda saat ini') || text.includes('gaji saat ini')) return r.penghasilan_bulanan || '-';
                    if (text.includes('sesuai dengan bidang studi') || text.includes('kesesuaian bidang')) return r.kesesuaian_bidang || '-';
                    if (text.includes('kompetensi yang diperoleh') || text.includes('kesesuaian pekerjaan')) return r.kesesuaian_kompetensi ? r.kesesuaian_kompetensi + ' / 5' : '-';
                  }
                  if (q.kategori === 'wirausaha') {
                    if (text.includes('memiliki usaha sendiri')) return r.status_pekerjaan === 'wirausaha' ? 'Sudah Memiliki Usaha' : '-';
                    if (text.includes('nama usaha')) return r.nama_perusahaan || '-';
                    if (text.includes('bidang usaha')) return r.bidang_perusahaan || '-';
                    if (text.includes('tahun memulai')) return r.kapan_mulai_cari_kerja || '-';
                    if (text.includes('jumlah karyawan')) return r.jabatan || '-';
                    if (text.includes('omzet')) return r.gaji_pertama || r.penghasilan_bulanan || '-';
                    if (text.includes('sumber modal')) return r.media_mencari_kerja || '-';
                    if (text.includes('sesuai dengan bidang studi') || text.includes('kesesuaian')) return r.kesesuaian_bidang || '-';
                    if (text.includes('perkuliahan membantu')) return r.kesesuaian_kompetensi ? r.kesesuaian_kompetensi + ' / 5' : '-';
                  }
                  if (q.kategori === 'kuliah') {
                    if (text.includes('melanjutkan pendidikan')) return r.status_pekerjaan === 'kuliah' ? 'Ya' : '-';
                    if (text.includes('perguruan tinggi') || text.includes('universitas')) return r.nama_universitas || '-';
                    if (text.includes('jenjang')) return r.jenjang_lanjut || '-';
                    if (text.includes('program studi')) return r.program_studi_lanjut || '-';
                    if (text.includes('tahun masuk')) return r.kapan_mulai_cari_kerja || '-';
                    if (text.includes('alasan')) return r.saran || '-';
                    if (text.includes('sumber pembiayaan')) return r.media_mencari_kerja || '-';
                  }
                  if (q.kategori === 'belum_bekerja') {
                    if (text.includes('mencari pekerjaan')) return r.status_pekerjaan === 'belum_bekerja' ? 'Ya' : '-';
                    if (text.includes('melamar pekerjaan')) return r.kapan_mulai_cari_kerja || '-';
                    if (text.includes('wawancara kerja')) return r.status_kerja_detail || '-';
                    if (text.includes('kendala')) return r.lama_mencari_kerja || '-';
                    if (text.includes('rencana anda')) return r.saran || '-';
                  }
                  return '-';
                }
              %>
              <table class="doc-table">
                <thead>
                  <tr>
                    <th style="width:40px; text-align:center;">No</th>
                    <th style="width:100px;">NIM</th>
                    <th style="width:180px;">Nama Alumni</th>
                    <th style="width:60px; text-align:center;">Lulus</th>
                    <% if (curStatus !== 'semua' && qCols.length > 0) { %>
                      <% qCols.forEach(q => { %>
                        <th style="min-width:140px; font-size:11px; text-transform:none;"><%= q.pertanyaan %></th>
                      <% }) %>
                    <% } else { %>
                      <th style="width:120px; text-align:center;">Status</th>
                      <th>Instansi / Usaha / Kampus</th>
                      <th style="width:140px;">Jabatan / Jenjang</th>
                      <th style="width:140px;">Gaji / Detail</th>
                    <% } %>
                  </tr>
                </thead>
                <tbody>
                  <% if (!data || data.length === 0) { %>
                  <tr><td colspan="<%= 4 + (curStatus !== 'semua' && qCols.length > 0 ? qCols.length : 4) %>" class="doc-empty">Belum ada data tracer study untuk kategori ini.</td></tr>
                  <% } else { %>
                  <% data.forEach((r, i) => { %>
                  <tr>
                    <td class="doc-no"><%= i+1 %></td>
                    <td class="doc-nim"><%= r.nim || '-' %></td>
                    <td class="doc-nama"><%= r.nama %></td>
                    <td style="text-align:center; font-weight:600; color:#6b7280;"><%= r.tahun_lulus || '-' %></td>
                    <% if (curStatus !== 'semua' && qCols.length > 0) { %>
                      <% qCols.forEach(q => { %>
                        <td style="color:#374151; font-weight:500; font-size:11px;"><%= getAnswerVal(r, q) %></td>
                      <% }) %>
                    <% } else { %>
                      <td style="text-align:center;">
                        <%
                          let sc = 'st-belum', sl = 'Belum Mengisi';
                          if (r.status_pekerjaan === 'bekerja')       { sc = 'st-bekerja';       sl = '💼 Bekerja'; }
                          else if (r.status_pekerjaan === 'wirausaha') { sc = 'st-wirausaha';    sl = '🚀 Wirausaha'; }
                          else if (r.status_pekerjaan === 'kuliah')    { sc = 'st-studi';        sl = '🎓 Studi Lanjut'; }
                          else if (r.status_pekerjaan === 'belum_bekerja') { sc = 'st-belum_bekerja'; sl = '⏳ Belum Bekerja'; }
                        %>
                        <span class="st-badge <%= sc %>"><%= sl %></span>
                      </td>
                      <td style="color:#374151;"><%= r.nama_perusahaan || r.nama_universitas || '-' %></td>
                      <td style="color:#374151;"><%= r.jabatan || r.jenjang_lanjut || '-' %></td>
                      <td style="font-weight:700; color:#064E3B;"><%= r.gaji_pertama || r.penghasilan_bulanan || r.lama_mencari_kerja || '-' %></td>
                    <% } %>
                  </tr>
                  <% }) %>
                  <% } %>
                </tbody>
              </table>
            <% } %>

          </div>
        </div>

        <!-- FOOTER DOKUMEN -->
        <div class="doc-footer">
          <div class="doc-footer-left">
            <strong>Universitas Hamzanwadi — Sistem Informasi Tracer Study</strong>
            Dokumen ini dibuat secara otomatis oleh sistem.<br>
            Dicetak pada: <%= new Date().toLocaleDateString('id-ID', {weekday:'long', day:'numeric', month:'long', year:'numeric'}) %>,
            pukul <%= new Date().toLocaleTimeString('id-ID', {hour:'2-digit', minute:'2-digit'}) %> WITA
          </div>
          <div class="doc-footer-right">
            <div class="doc-total">
              <% if (type === 'konseling') { %>
                Total: <%= totalResponden %> Sesi
              <% } else if (type === 'lowongan') { %>
                Total: <%= totalResponden %> Log Akses
              <% } else if (type === 'prodi') { %>
                Total: <%= totalResponden %> Penilaian
              <% } else { %>
                Total: <%= totalResponden %> Alumni
              <% } %>
            </div>
            <div style="font-size:10px; color:#9ca3af;">Program Studi Sistem Informasi FT Hamzanwadi</div>
          </div>
        </div>

      </div>
    </div>

    <!-- TOAST NOTIFIKASI -->
    <div id="toast" class="toast-notify">
      <svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
      <span id="toast-msg">PDF berhasil diunduh!</span>
    </div>

  </div>
</main>

<script>
  function showToast(msg) {
    const t = document.getElementById('toast');
    document.getElementById('toast-msg').innerText = msg;
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 3500);
  }

  function downloadPDF() {
    const element = document.getElementById('printable-area');
    const btn = document.getElementById('btn-unduh-pdf');

    btn.classList.add('loading');
    btn.innerHTML = `
      <svg viewBox="0 0 24 24" style="animation:spin 1s linear infinite;"><path d="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46A7.93 7.93 0 0020 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74A7.93 7.93 0 004 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z"/></svg>
      Memproses PDF...
    `;

    const typeStr = '<%= type %>';
    let filename = `Laporan_Tracer_Study_${new Date().getFullYear()}.pdf`;
    if (typeStr === 'konseling') filename = `Laporan_Konseling_Karir_${new Date().getFullYear()}.pdf`;
    if (typeStr === 'lowongan')  filename = `Laporan_Akses_Lowongan_${new Date().getFullYear()}.pdf`;
    if (typeStr === 'prodi')     filename = `Laporan_Penilaian_Prodi_${new Date().getFullYear()}.pdf`;

    const opt = {
      margin:       [8, 8, 8, 8],
      filename:     filename,
      image:        { type: 'jpeg', quality: 0.98 },
      html2canvas:  { scale: 2, useCORS: true, logging: false },
      jsPDF:        { unit: 'mm', format: 'a4', orientation: 'landscape' }
    };

    html2pdf().set(opt).from(element).save()
      .then(() => {
        btn.classList.remove('loading');
        btn.innerHTML = `
          <svg viewBox="0 0 24 24"><path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm-1 7V3.5L18.5 9H13z"/></svg>
          Unduh PDF
        `;
        showToast('PDF Laporan berhasil diunduh!');
      })
      .catch(err => {
        console.error('PDF error:', err);
        btn.classList.remove('loading');
        btn.innerHTML = `Unduh PDF`;
        alert('Gagal membuat PDF: ' + err.message);
      });
  }

  function toggleSidebar() {
    document.getElementById('sidebar').classList.toggle('open');
  }
</script>

<style>
  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
</style>

</body>
</html>
