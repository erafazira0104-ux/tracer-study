<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Log Akses Lowongan | Tracer Study Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/admin/dashboard.css"/>
</head>
<body>

<%- include('_sidebar', { active: 'lowongan' }) %>

<main class="main-content">
  <!-- Topbar -->
  <%- include('_topbar', { breadcrumbs: [{ label: 'Lowongan Kerja', url: '/admin/lowongan' }, { label: 'Log Akses Lowongan' }] }) %>

  <div class="page-content">
    <div class="page-header">
      <h1>Log Akses Lowongan Kerja</h1>
      <p>Berikut adalah data alumni yang melakukan klik "Lamar Sekarang" pada info lowongan pekerjaan.</p>
    </div>

    <!-- Table Card -->
    <div class="data-card" style="margin-top: 20px;">
      <div class="data-card-header">
        <h3>Daftar Akses Lowongan</h3>
        <a href="/admin/lowongan" class="btn btn-outline">← Kembali</a>
      </div>

      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>NAMA ALUMNI</th>
              <th style="width:110px;">NIM</th>
              <th>EMAIL</th>
              <th>NO. HP</th>
              <th>LOWONGAN DI-AKSES</th>
              <th>TANGGAL AKSES</th>
            </tr>
          </thead>
          <tbody>
            <% if (!logs || logs.length === 0) { %>
            <tr>
              <td colspan="6" style="text-align:center; padding:24px; color:#9ca3af;">Belum ada log akses lowongan.</td>
            </tr>
            <% } else { %>
            <% logs.forEach(function(log) { %>
            <tr>
              <td style="font-weight:600;"><%= log.nama %></td>
              <td><span class="nim-code"><%= log.nim || '-' %></span></td>
              <td><%= log.email %></td>
              <td><%= log.no_hp || '-' %></td>
              <td>
                <div style="font-weight:600; color:var(--green-dark);"><%= log.nama_lowongan %></div>
                <div style="font-size:11px; color:#666;"><%= log.perusahaan %></div>
              </td>
              <td><%= new Date(log.created_at).toLocaleString('id-ID', {day:'numeric', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit'}) %></td>
            </tr>
            <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Footer -->
    <div style="text-align:center; padding:16px 0 4px; font-size:11px; color:#aaa; margin-top:24px;">
      &copy; 2026 Information Systems Fakultas Teknik Hamzanwadi University. All Rights Reserved.
    </div>
  </div>
</main>

<script>
  function toggleSidebar() {
    document.getElementById('sidebar').classList.toggle('open');
  }
</script>
</body>
</html>
