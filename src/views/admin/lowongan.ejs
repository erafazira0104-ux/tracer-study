<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Manajemen Karir | Admin Tracer Study</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/admin/dashboard.css"/>
  <link rel="stylesheet" href="/css/admin/lowongan.css"/>
</head>
<body>

<!-- SIDEBAR -->
<%- include('_sidebar', { active: 'lowongan' }) %>

<main class="main-content">
  <!-- Topbar -->
  <%- include('_topbar', { breadcrumbs: [{ label: 'Admin', url: '/admin/dashboard' }, { label: 'Daftar Lowongan' }], showSearch: true, searchAction: '/admin/lowongan', searchPlaceholder: 'Cari lowongan...' }) %>

  <div class="page-content">

    <!-- Flash Alerts -->
    <% if (flash_success) { %>
      <div class="alert alert-success"><%= flash_success %></div>
    <% } %>
    <% if (flash_error) { %>
      <div class="alert alert-error"><%= flash_error %></div>
    <% } %>

    <!-- Header Card -->
    <div class="karir-header-card">
      <div class="karir-header-text">
        <h1>Manajemen Karir</h1>
        <p>Kelola informasi lowongan pekerjaan untuk para alumni Program Studi Sistem Informasi.</p>
      </div>
      <a href="/admin/lowongan/tambah" class="btn-solid-green">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
        <span>+ Tambah Lowongan</span>
      </a>
    </div>

    <!-- Data Table Card -->
    <div class="karir-table-card">
      <div class="table-responsive">
        <table class="karir-table">
          <thead>
            <tr>
              <th style="width: 35px;">NO</th>
              <th style="width: 60px;">FOTO</th>
              <th style="width: 180px;">NAMA JABATAN</th>
              <th style="width: 180px;">DESKRIPSI</th>
              <th style="width: 130px;">LINK</th>
              <th style="width: 95px; text-align: right;">AKSI</th>
            </tr>
          </thead>
          <tbody>
            <% if (lowongan.length === 0) { %>
              <tr>
                <td colspan="6" class="empty-row">
                  Belum ada data lowongan kerja terdaftar.
                </td>
              </tr>
            <% } else { %>
              <% lowongan.forEach((l, i) => { %>
                <tr>
                  <td><span class="no-text"><%= i + 1 %></span></td>
                  <td>
                    <% if (l.gambar) { %>
                      <img src="<%= l.gambar %>" class="loker-thumb-box" alt="Poster Loker"/>
                    <% } else { %>
                      <div class="loker-thumb-placeholder">
                        <svg viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M20 6h-2.18c.07-.44.18-.88.18-1.35C18 2.53 15.47 0 12 0S6 2.53 6 4.65c0 .47.11.91.18 1.35H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-8 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"/></svg>
                      </div>
                    <% } %>
                  </td>
                  <td>
                    <span class="jabatan-title"><%= l.judul %></span>
                    <span class="company-name"><%= l.perusahaan || 'Perusahaan' %></span>
                  </td>
                  <td>
                    <div class="deskripsi-text" title="<%= l.deskripsi %>">
                      <%= l.deskripsi %>
                    </div>
                  </td>
                  <td>
                    <% if (l.link) { %>
                      <a href="<%= l.link %>" target="_blank" class="link-loker-btn">
                        <span><%= l.link.replace('https://','').replace('http://','').split('/')[0] %></span>
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor"><path d="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"/></svg>
                      </a>
                    <% } else { %>
                      <span style="color: #94a3b8; font-size: 0.8rem;">-</span>
                    <% } %>
                  </td>
                  <td style="text-align: right;">
                    <div class="table-actions-group">
                      <a href="<%= l.link || '#' %>" target="_blank" class="icon-action-btn view" title="Lihat Detail">
                        <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
                      </a>
                      <a href="/admin/lowongan/<%= l.id %>/edit" class="icon-action-btn edit" title="Edit Lowongan">
                        <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
                      </a>
                      <form action="/admin/lowongan/<%= l.id %>/hapus" method="POST" style="display:inline; margin:0;" onsubmit="return confirm('Apakah Anda yakin ingin menghapus lowongan ini?')">
                        <button type="submit" class="icon-action-btn delete" title="Hapus Lowongan">
                          <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Pagination Footer -->
      <div class="karir-table-pagination">
        <span class="pagination-info">Menampilkan <strong>1 - <%= lowongan.length %></strong> dari <strong><%= lowongan.length %></strong> lowongan</span>
        <div class="pagination-buttons">
          <a href="#" class="page-btn disabled">‹</a>
          <a href="#" class="page-btn active">1</a>
          <a href="#" class="page-btn">2</a>
          <a href="#" class="page-btn">3</a>
          <span class="page-btn disabled">...</span>
          <a href="#" class="page-btn">›</a>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div style="text-align: center; padding: 24px 0 8px; font-size: 0.76rem; color: #94a3b8;">
      &copy; <%= new Date().getFullYear() %> Information Systems Fakultas Teknik Universitas Hamzanwadi. All Rights Reserved.
    </div>

  </div>
</main>

<script>
  function toggleSidebar() {
    document.getElementById('sidebar').classList.toggle('open');
  }
  setTimeout(() => {
    document.querySelectorAll('.alert').forEach(el => el.style.opacity = '0');
  }, 4000);
</script>
</body>
</html>