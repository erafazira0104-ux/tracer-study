<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Daftar Lowongan | Admin Tracer Study</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet" />
    <link rel="stylesheet" href="/css/admin/dashboard.css" />
    <style>
        .loker-foto-thumb {
            width: 48px;
            height: 34px;
            object-fit: cover;
            border-radius: 6px;
            background: #fafaf9;
            border: 1px solid var(--border);
        }

        .loker-foto-placeholder {
            width: 48px;
            height: 34px;
            background: #e8f4ec;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #2d6a4f;
            border: 1px solid #d1e7d9;
        }

        .loker-foto-placeholder svg {
            width: 18px;
            height: 18px;
            fill: currentColor;
        }

        .badge-tipe {
            background: #e0f2fe;
            color: #0369a1;
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 10px;
            font-weight: 600;
            text-transform: uppercase;
        }

        .loker-link {
            color: #2d6a4f;
            text-decoration: none;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 12px;
        }

        .loker-link:hover {
            text-decoration: underline;
        }

        .loker-link svg {
            width: 12px;
            height: 12px;
            fill: currentColor;
        }

        /* Action toolbar matching the mockup */
        .topbar-search-wrap {
            position: relative;
            display: flex;
            align-items: center;
            max-width: 320px;
            width: 100%;
        }

        .topbar-search-wrap svg {
            position: absolute;
            left: 12px;
            width: 16px;
            height: 16px;
            fill: #aaa;
        }

        .topbar-search-wrap input {
            width: 100%;
            padding: 8px 12px 8px 36px;
            border: 1px solid var(--border);
            border-radius: 20px;
            font-size: 12px;
            outline: none;
            background: #f3f4f6;
            transition: all var(--transition);
        }

        .topbar-search-wrap input:focus {
            background: #fff;
            border-color: #2d6a4f;
            box-shadow: 0 0 0 3px rgba(45, 106, 79, 0.1);
        }

        .topbar-icon-bell {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #555;
            cursor: pointer;
            transition: all var(--transition);
        }

        .topbar-icon-bell:hover {
            background: #f1f5f9;
        }

        .topbar-icon-bell svg {
            width: 18px;
            height: 18px;
            fill: currentColor;
        }

        .btn-tambah-custom:hover {
            background: #f4faf6 !important;
            border-color: #053d2f !important;
            color: #053d2f !important;
        }
    </style>
</head>

<body>

    <%- include('_sidebar', { active: 'lowongan' }) %>

        <main class="main-content">
            <!-- Topbar matching mockup -->
            <%- include('_topbar', { title: 'Daftar Lowongan' , showSearch: true, searchAction: '/admin/lowongan' ,
                searchPlaceholder: 'Cari lowongan...' }) %>

                <div class="page-content" style="background:#fcfcf7; min-height: calc(100vh - 60px); padding: 24px;">
                    <!-- Flash -->
                    <% if (flash_success) { %>
                        <div class="alert alert-success" style="margin-bottom:16px;">
                            <%= flash_success %>
                        </div>
                        <% } %>
                            <% if (flash_error) { %>
                                <div class="alert alert-error" style="margin-bottom:16px;">
                                    <%= flash_error %>
                                </div>
                                <% } %>

                                    <!-- Card header matching mockup -->
                                    <div class="form-container-box"
                                        style="padding: 24px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
                                        <div>
                                            <h2 style="font-size: 16px; font-weight: 800; color: #064E3B;">Manajemen
                                                Karir</h2>
                                            <p style="font-size: 12px; color: #555; margin-top: 4px;">Kelola informasi
                                                lowongan pekerjaan untuk para alumni Program Studi Sistem Informasi.</p>
                                        </div>
                                        <a href="/admin/lowongan/tambah" class="btn-tambah-custom"
                                            style="text-decoration:none; background:#fff; color:#064E3B; border: 1.5px solid #064E3B; font-weight:700; padding: 10px 20px; border-radius:8px; display:inline-flex; align-items:center; gap:6px; font-size:13px; transition: all var(--transition);">
                                            <svg viewBox="0 0 24 24"
                                                style="width:14px; height:14px; fill:currentColor;">
                                                <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
                                            </svg>
                                            Tambah Lowongan
                                        </a>
                                    </div>

                                    <!-- Data Table -->
                                    <div class="data-card" style="border-radius:12px; overflow:hidden;">
                                        <div class="table-responsive">
                                            <table class="data-table">
                                                <thead>
                                                    <tr>
                                                        <th style="width:40px; text-align:center;">NO</th>
                                                        <th style="width:70px; text-align:center;">FOTO</th>
                                                        <th style="width:220px;">NAMA JABATAN</th>
                                                        <th>DESKRIPSI</th>
                                                        <th style="width:180px;">LINK</th>
                                                        <th style="width:110px; text-align:center;">AKSI</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% if (lowongan.length===0) { %>
                                                        <tr>
                                                            <td colspan="6" class="empty-row"
                                                                style="text-align:center; padding:32px; color:#888;">
                                                                Belum ada lowongan terdaftar.</td>
                                                        </tr>
                                                        <% } else { %>
                                                            <% lowongan.forEach((l, i)=> { %>
                                                                <tr>
                                                                    <td
                                                                        style="text-align:center; font-weight:600; color:#555;">
                                                                        <%= i+1 %>
                                                                    </td>
                                                                    <td style="text-align:center;">
                                                                        <% if (l.gambar) { %>
                                                                            <img src="<%= l.gambar %>"
                                                                                class="loker-foto-thumb"
                                                                                alt="Poster Loker" />
                                                                            <% } else { %>
                                                                                <div class="loker-foto-placeholder">
                                                                                    <svg viewBox="0 0 24 24">
                                                                                        <path
                                                                                            d="M20 6h-2.18c.07-.44.18-.88.18-1.35C18 2.53 15.47 0 12 0S6 2.53 6 4.65c0 .47.11.91.18 1.35H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-8 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z" />
                                                                                    </svg>
                                                                                </div>
                                                                                <% } %>
                                                                    </td>
                                                                    <td>
                                                                        <strong
                                                                            style="font-size:13px; color:#111; line-height:1.3;">
                                                                            <%= l.judul %>
                                                                        </strong>
                                                                    </td>
                                                                    <td style="font-size:12px; color:#444; max-width: 320px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"
                                                                        title="<%= l.deskripsi %>">
                                                                        <%= l.deskripsi %>
                                                                    </td>
                                                                    <td>
                                                                        <% if (l.link) { %>
                                                                            <a href="<%= l.link %>" target="_blank"
                                                                                class="loker-link">
                                                                                <%= l.link.replace('https://','').replace('http://','').split('/')[0]
                                                                                    %>
                                                                                    <svg viewBox="0 0 24 24">
                                                                                        <path
                                                                                            d="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z" />
                                                                                    </svg>
                                                                            </a>
                                                                            <% } else { %>
                                                                                <span
                                                                                    style="color:#aaa; font-size:11px;">-</span>
                                                                                <% } %>
                                                                    </td>
                                                                    <td style="text-align:center;">
                                                                        <form action="/admin/lowongan/<%= l.id %>/hapus"
                                                                            method="POST" style="display:inline"
                                                                            onsubmit="return confirm('Apakah Anda yakin ingin menghapus lowongan ini?')">
                                                                            <button type="submit"
                                                                                class="btn-icon btn-delete"
                                                                                style="color:#ef4444; border:none; background:none; cursor:pointer;"
                                                                                title="Hapus">
                                                                                <svg viewBox="0 0 24 24"
                                                                                    style="width:18px; height:18px; fill:currentColor;">
                                                                                    <path
                                                                                        d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" />
                                                                                </svg>
                                                                            </button>
                                                                        </form>
                                                                    </td>
                                                                </tr>
                                                                <% }) %>
                                                                    <% } %>
                                                </tbody>
                                            </table>
                                        </div>
                                        <div class="pagination-wrap"
                                            style="padding: 16px 24px; border-top:1px solid var(--border); display:flex; justify-content:space-between; align-items:center;">
                                            <span style="font-size:12px; color:#666;">Menampilkan 1 - <%=
                                                    lowongan.length %> dari <%= lowongan.length %> lowongan</span>
                                        </div>
                                    </div>

                                    <!-- Footer -->
                                    <div
                                        style="text-align:center; border-top:1px solid #e2e8f0; padding-top:16px; font-size:11px; color:#777; margin-top:32px;">
                                        &copy; 2026 Information Systems Fakultas Teknik Hamzanwadi University. All
                                        Rights Reserved.
                                    </div>
                </div>
        </main>

        <script>
            function toggleSidebar() {
                document.getElementById('sidebar').classList.toggle('open');
            }
            setTimeout(() => {
                document.querySelectorAll('.alert').forEach(el => el.style.opacity = '0');
            }, 4000);
        </script>
</body>

</html>