<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Pengaturan Akun | Admin Tracer Study — Sistem Informasi FT Hamzanwadi</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/admin/dashboard.css"/>
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
    .settings-wrapper {
      display: grid;
      grid-template-columns: 1.5fr 1fr;
      gap: 24px;
      margin-bottom: 24px;
    }
    .settings-main-card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 28px;
      box-shadow: var(--shadow);
    }
    .settings-title-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 24px;
      font-size: 14px;
      font-weight: 800;
      color: #064E3B;
      padding-bottom: 14px;
      border-bottom: 1px solid var(--border);
    }
    .settings-title-row svg {
      width: 18px; height: 18px; fill: currentColor;
    }
    .profile-flex-box {
      display: flex;
      gap: 24px;
    }
    .profile-avatar-wrap {
      width: 140px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 12px;
    }
    .profile-circle {
      width: 110px; height: 110px;
      border-radius: 50%;
      background: #2d3748;
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 32px;
      font-weight: 700;
      border: 3px solid #e2e8f0;
      cursor: pointer;
      overflow: hidden;
      position: relative;
      transition: all var(--transition);
    }
    .profile-circle:hover {
      border-color: #2d6a4f;
      opacity: 0.9;
    }
    .profile-circle img {
      width: 100%; height: 100%;
      object-fit: cover;
    }
    .profile-circle-text {
      font-size: 9px;
      color: #888;
      line-height: 1.3;
    }
    .profile-fields-wrap {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .grid-fields-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    .settings-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .settings-group label {
      font-size: 12px; font-weight: 600; color: #333;
    }
    .settings-group input, .settings-group select {
      padding: 10px 12px;
      border: 1px solid var(--border);
      border-radius: 8px;
      font-size: 13px;
      outline: none;
      transition: all var(--transition);
      font-family: inherit;
    }
    .settings-group input:focus, .settings-group select:focus {
      border-color: #2d6a4f;
      box-shadow: 0 0 0 3px rgba(45,106,79,0.1);
    }
    .settings-buttons {
      display: flex;
      justify-content: flex-end;
      gap: 12px;
      margin-top: 24px;
      padding-top: 16px;
      border-top: 1px solid var(--border);
    }
    .btn-sett-outline {
      padding: 10px 20px;
      border: 1.5px solid var(--border);
      background: #fff;
      color: #555;
      font-weight: 600;
      border-radius: 8px;
      cursor: pointer;
      text-decoration: none;
      font-size: 13px;
    }
    .btn-sett-outline:hover {
      background: #f5f5f5;
    }
    .btn-sett-solid {
      padding: 10px 20px;
      border: none;
      background: #064E3B;
      color: #fff;
      font-weight: 600;
      border-radius: 8px;
      cursor: pointer;
      font-size: 13px;
    }
    .btn-sett-solid:hover {
      background: #053d2f;
    }
    /* Bottom Horizontal Cards */
    .status-cards-row {
      display: grid;
      grid-template-columns: 1.2fr 1.2fr;
      gap: 20px;
      margin-top: 24px;
    }
    .status-card-small {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 16px 20px;
      display: flex;
      align-items: center;
      gap: 14px;
      box-shadow: var(--shadow);
    }
    .status-card-icon-box {
      width: 44px; height: 44px;
      border-radius: 8px;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .status-card-icon-box.green {
      background: #e8f4ec; color: #2d6a4f;
    }
    .status-card-icon-box.grey {
      background: #f3f4f6; color: #555;
    }
    .status-card-icon-box svg {
      width: 20px; height: 20px; fill: currentColor;
    }
    .status-card-body h6 {
      font-size: 11px; font-weight: 600; color: #888; text-transform: uppercase; margin-bottom: 2px;
    }
    .status-card-body p {
      font-size: 12px; font-weight: 700; color: #2d6a4f;
    }
    .status-card-body.grey-body p {
      color: #444; font-weight: 600;
    }
    /* Right Side Password forms */
    .password-input-wrapper {
      position: relative;
      display: flex;
      align-items: center;
    }
    .password-input-wrapper input {
      width: 100%;
      padding-right: 38px;
    }
    .password-toggle-eye {
      position: absolute;
      right: 12px;
      cursor: pointer;
      color: #777;
      display: flex; align-items: center; justify-content: center;
    }
    .password-toggle-eye svg {
      width: 16px; height: 16px; fill: currentColor;
    }
    /* Password Strength bar */
    .strength-bar-wrap {
      display: flex;
      gap: 4px;
      margin-top: 6px;
    }
    .strength-segment {
      flex: 1;
      height: 4px;
      background: #e2e8f0;
      border-radius: 2px;
    }
    .strength-segment.active {
      background: #10b981;
    }
    .strength-text {
      font-size: 10px; font-weight: 700; color: #10b981; margin-top: 4px;
    }
    /* Security Tips Card */
    .security-tips-card {
      background: #fff;
      border: 1px solid var(--border);
      border-left: 4px solid #f59e0b; /* Yellow border left */
      border-radius: 0 12px 12px 0;
      padding: 20px;
      margin-top: 20px;
      box-shadow: var(--shadow);
    }
    .security-tips-title {
      font-size: 12px; font-weight: 700; color: #d97706; display: flex; align-items: center; gap: 8px; margin-bottom: 12px;
    }
    .security-tips-title svg {
      width: 16px; height: 16px; fill: currentColor;
    }
    .tips-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .tips-list-item {
      font-size: 12px;
      color: #555;
      display: flex;
      align-items: flex-start;
      gap: 8px;
      line-height: 1.4;
    }
    .tips-list-item svg {
      width: 15px; height: 15px; fill: #10b981; flex-shrink: 0; margin-top: 2px;
    }
  </style>
</head>
<body>

<%- include('_sidebar', { active: 'pengaturan' }) %>

<main class="main-content">
  <!-- Topbar -->
  <%- include('_topbar', { breadcrumbs: [{ label: 'Admin', url: '/admin/dashboard' }, { label: 'Pengaturan Akun' }] }) %>

  <div class="page-content" style="background:#fcfcf7; min-height: calc(100vh - 60px); padding: 24px;">
    <% if (error) { %><div class="alert alert-error" style="margin-bottom:16px;"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success" style="margin-bottom:16px;"><%= success %></div><% } %>

    <div class="settings-wrapper">
      <!-- Left side: Profil Admin Form & bottom status grid -->
      <div>
        <form action="/admin/penganturan/../pengaturan/profil" method="POST" enctype="multipart/form-data" class="settings-main-card">
          <div class="settings-title-row">
            <svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
            <span>Profil Admin</span>
          </div>

          <div class="profile-flex-box">
            <!-- Avatar Upload Circle -->
            <div class="profile-avatar-wrap">
              <div class="profile-circle" onclick="triggerAvatarSelect()">
                <% if (admin.foto) { %>
                  <img src="<%= admin.foto %>" id="avatarPreview" alt="Foto Profil"/>
                <% } else { %>
                  <span id="avatarPlaceholderText">●</span>
                  <img id="avatarPreview" style="display:none;" alt="Foto Profil"/>
                <% } %>
              </div>
              <input type="file" name="foto" id="avatarInput" accept="image/*" style="display:none;" onchange="previewAvatar(this)"/>
              <span class="profile-circle-text">Format: JPG, PNG.<br/>Maks 2MB.</span>
            </div>

            <!-- Fields Grid -->
            <div class="profile-fields-wrap">
              <div class="grid-fields-2">
                <div class="settings-group">
                  <label for="nama">Nama Lengkap</label>
                  <input type="text" id="nama" name="nama" value="<%= admin.nama %>" required/>
                </div>
                <div class="settings-group">
                  <label for="email">Email Instansi</label>
                  <input type="email" id="email" name="email" value="<%= admin.email %>" required/>
                </div>
              </div>

              <div class="grid-fields-2">
                <div class="settings-group">
                  <label for="nuptk">NUPTK / NIK</label>
                  <input type="text" id="nuptk" name="nuptk" value="<%= admin.nuptk || '' %>" placeholder="Contoh: 19870512..."/>
                </div>
                <div class="settings-group">
                  <label for="prodi">Program Studi / Departemen</label>
                  <input type="text" id="prodi" name="prodi" value="<%= admin.prodi || '' %>" placeholder="Contoh: Sistem Informasi"/>
                </div>
              </div>

              <div class="settings-group" style="margin-top: 4px;">
                <label for="no_wa_pengirim">Nomor WhatsApp Pengirim &amp; Administrator Official (Digunakan Sistem)</label>
                <input type="text" id="no_wa_pengirim" name="no_wa_pengirim" value="<%= admin.no_wa_pengirim || '081936791163' %>" placeholder="Contoh: 081936791163" style="font-weight:700; color:#064E3B;"/>
                <small style="font-size:11px; color:#64748b; margin-top:2px;">Nomor ini terintegrasi penuh secara otomatis ke seluruh tombol "Tanya Admin / Hubungi IT Support" &amp; pesan pengingat alumni.</small>
              </div>
            </div>
          </div>

          <div class="settings-buttons">
            <a href="/admin/dashboard" class="btn-sett-outline">Batal</a>
            <button type="submit" class="btn-sett-solid">Simpan Perubahan</button>
          </div>
        </form>

        <!-- Bottom Grid Cards -->
        <div class="status-cards-row">
          <div class="status-card-small">
            <div class="status-card-icon-box green">
              <svg viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"/></svg>
            </div>
            <div class="status-card-body">
              <h6>Terakhir Login</h6>
              <p style="color: #2d6a4f; font-size:12px; font-weight:600;"><%= admin.terakhir_login || 'Senin, 24 Mei 2024 - 08:45 WITA' %></p>
            </div>
          </div>

          <div class="status-card-small">
            <div class="status-card-icon-box grey">
              <svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/></svg>
            </div>
            <div class="status-card-body grey-body">
              <h6>Status Keamanan</h6>
              <p style="color:#555; font-size:12px; font-weight:600;">Otentikasi Dua Faktor Aktif</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right side: Ubah Password & Tips Keamanan -->
      <div>
        <form action="/admin/pengaturan/password" method="POST" class="settings-main-card">
          <div class="settings-title-row">
            <svg viewBox="0 0 24 24"><path d="M12.65 10C11.83 7.67 9.61 6 7 6c-3.31 0-6 2.69-6 6s2.69 6 6 6c2.61 0 4.83-1.67 5.65-4H17v4h4v-4h2v-4H12.65zM7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"/></svg>
            <span>Ubah Password</span>
          </div>

          <div style="display:flex; flex-direction:column; gap:16px;">
            <div class="settings-group">
              <label for="password_lama">Password Lama</label>
              <div class="password-input-wrapper">
                <input type="password" id="password_lama" name="password_lama" placeholder="••••••••" required/>
                <div class="password-toggle-eye" onclick="togglePasswordVisibility('password_lama')">
                  <svg viewBox="0 0 24 24" width="16"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
                </div>
              </div>
            </div>

            <div class="settings-group">
              <label for="password_baru">Password Baru</label>
              <div class="password-input-wrapper">
                <input type="password" id="password_baru" name="password_baru" placeholder="••••••••" onkeyup="checkPasswordStrength(this.value)" required/>
                <div class="password-toggle-eye" onclick="togglePasswordVisibility('password_baru')">
                  <svg viewBox="0 0 24 24" width="16"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
                </div>
              </div>
              <div class="strength-bar-wrap">
                <div class="strength-segment active" id="seg1"></div>
                <div class="strength-segment active" id="seg2"></div>
                <div class="strength-segment active" id="seg3"></div>
                <div class="strength-segment" id="seg4"></div>
              </div>
              <div class="strength-text" id="strengthText">Kekuatan: Kuat</div>
            </div>

            <div class="settings-group">
              <label for="konfirmasi_password">Konfirmasi Password</label>
              <input type="password" id="konfirmasi_password" name="konfirmasi_password" placeholder="••••••••" required/>
            </div>

            <button type="submit" class="btn-sett-solid" style="width:100%; display:flex; justify-content:center; padding:12px;">Perbarui Password</button>
          </div>
        </form>

        <!-- Security Tips Card -->
        <div class="security-tips-card">
          <div class="security-tips-title">
            <svg viewBox="0 0 24 24"><path d="M12 22c5.52 0 10-4.48 10-10S17.52 2 12 2 2 6.48 2 12s4.48 10 10 10zm-1-17h2v6h-2V5zm0 8h2v2h-2v-2z"/></svg>
            <span>Tips Keamanan</span>
          </div>
          <ul class="tips-list">
            <li class="tips-list-item">
              <svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              <span>Gunakan minimal 12 karakter untuk password.</span>
            </li>
            <li class="tips-list-item">
              <svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              <span>Kombinasikan huruf besar, angka, dan simbol (!$@#).</span>
            </li>
            <li class="tips-list-item">
              <svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              <span>Hindari menggunakan nama instansi atau tanggal lahir.</span>
            </li>
            <li class="tips-list-item">
              <svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              <span>Perbarui password Anda setiap 3-6 bulan sekali.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div style="display:flex; justify-content:space-between; align-items:center; border-top:1px solid #e2e8f0; padding-top:16px; font-size:11px; color:#777; margin-top:20px;">
      <span>© 2024 Prodi Sistem Informasi Universitas Hamzanwadi. Seluruh Hak Cipta Dilindungi.</span>
      <div style="display:flex; gap:16px;">
        <a href="#" style="color:inherit; text-decoration:none;">Syarat &amp; Ketentuan</a>
        <a href="#" style="color:inherit; text-decoration:none;">Pusat Bantuan</a>
      </div>
    </div>
  </div>
</main>

<script>
  function toggleSidebar() {
    document.getElementById('sidebar').classList.toggle('open');
  }

  function triggerAvatarSelect() {
    document.getElementById('avatarInput').click();
  }

  function previewAvatar(input) {
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        const preview = document.getElementById('avatarPreview');
        preview.src = e.target.result;
        preview.style.display = 'block';
        
        const text = document.getElementById('avatarPlaceholderText');
        if (text) text.style.display = 'none';
      };
      reader.readAsDataURL(input.files[0]);
    }
  }

  function togglePasswordVisibility(id) {
    const input = document.getElementById(id);
    if (input.type === 'password') {
      input.type = 'text';
    } else {
      input.type = 'password';
    }
  }

  function checkPasswordStrength(val) {
    const s1 = document.getElementById('seg1');
    const s2 = document.getElementById('seg2');
    const s3 = document.getElementById('seg3');
    const s4 = document.getElementById('seg4');
    const text = document.getElementById('strengthText');

    s1.classList.remove('active');
    s2.classList.remove('active');
    s3.classList.remove('active');
    s4.classList.remove('active');

    if (val.length === 0) {
      text.textContent = 'Kekuatan: -';
      return;
    }

    let strength = 0;
    if (val.length >= 6) strength++;
    if (val.length >= 10) strength++;
    if (/[A-Z]/.test(val) && /[0-9]/.test(val)) strength++;
    if (/[!@#\$%\^&\*]/.test(val)) strength++;

    if (strength === 1) {
      s1.classList.add('active');
      text.textContent = 'Kekuatan: Lemah';
      text.style.color = '#ef4444';
    } else if (strength === 2) {
      s1.classList.add('active');
      s2.classList.add('active');
      text.textContent = 'Kekuatan: Sedang';
      text.style.color = '#f59e0b';
    } else if (strength === 3) {
      s1.classList.add('active');
      s2.classList.add('active');
      s3.classList.add('active');
      text.textContent = 'Kekuatan: Kuat';
      text.style.color = '#10b981';
    } else if (strength === 4) {
      s1.classList.add('active');
      s2.classList.add('active');
      s3.classList.add('active');
      s4.classList.add('active');
      text.textContent = 'Kekuatan: Sangat Kuat';
      text.style.color = '#064E3B';
    }
  }
</script>
</body>
</html>
