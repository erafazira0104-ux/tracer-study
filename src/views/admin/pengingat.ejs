<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Pengingat Alumni | Admin Tracer Study</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/admin/dashboard.css"/>
  <link rel="stylesheet" href="/css/admin/pengingat.css"/>
</head>
<body>

<%- include('_sidebar', { active: 'pengingat' }) %>

<main class="main-content">
  <%- include('_topbar', { breadcrumbs: [{ label: 'Admin', url: '/admin/dashboard' }, { label: 'Pengingat Alumni' }] }) %>

  <div class="page-content">

    <!-- Header Section -->
    <div class="pengingat-header-section">
      <h1>Diseminasi & Pengingat Alumni</h1>
      <p>Kirim pesan pengingat resmi tracer study secara langsung ke nomor WhatsApp & Email alumni.</p>
    </div>

    <!-- Summary Stat Cards -->
    <div class="pengingat-stat-grid">
      <div class="p-stat-card">
        <div class="p-stat-icon red">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg>
        </div>
        <div>
          <div class="p-stat-val"><%= totalBelumMengisi %></div>
          <div class="p-stat-lbl">Belum Mengisi Tracer</div>
        </div>
      </div>

      <div class="p-stat-card">
        <div class="p-stat-icon emerald">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
        </div>
        <div>
          <div class="p-stat-val"><%= totalTerkirimBerhasil %></div>
          <div class="p-stat-lbl">Berhasil Terkirim</div>
        </div>
      </div>

      <div class="p-stat-card">
        <div class="p-stat-icon amber">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
        </div>
        <div>
          <div class="p-stat-val"><%= totalTerkirimGagal %></div>
          <div class="p-stat-lbl">Kontak Kosong/Gagal</div>
        </div>
      </div>

      <div class="p-stat-card">
        <div class="p-stat-icon slate">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M17 1.01L7 1c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-1.99-2-1.99zM17 19H7V5h10v14z"/></svg>
        </div>
        <div>
          <div class="p-stat-val"><%= totalTanpaHp %></div>
          <div class="p-stat-lbl">Tanpa No. HP</div>
        </div>
      </div>
    </div>

    <!-- Alerts -->
    <% if (flash_success) { %>
      <div class="alert alert-success" style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <div><%- flash_success %></div>
        <% if (penerimaDetail && penerimaDetail.length > 0) { %>
          <button type="button" onclick="showPenerimaModal('<%= encodeURIComponent(JSON.stringify(penerimaDetail)) %>')" class="btn-detail-sm" style="background: #064E3B; color: #ffffff; border: none; padding: 6px 14px; border-radius: 8px;">
            👁️ Lihat Daftar Penerima (<%= penerimaDetail.length %> Alumni)
          </button>
        <% } %>
      </div>
    <% } %>

    <% if (flash_error) { %>
      <div class="alert alert-error" style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <div><%- flash_error %></div>
        <% if (penerimaDetail && penerimaDetail.length > 0) { %>
          <button type="button" onclick="showPenerimaModal('<%= encodeURIComponent(JSON.stringify(penerimaDetail)) %>')" class="btn-detail-sm" style="background: #991b1b; color: #ffffff; border: none; padding: 6px 14px; border-radius: 8px; cursor: pointer;">
            👁️ Lihat Detail Kesalahan (<%= penerimaDetail.length %> Alumni)
          </button>
        <% } %>
      </div>
    <% } %>

    <!-- Form & Info Layout -->
    <div class="pengingat-form-grid">
      <!-- FORM KIRIM PENGINGAT -->
      <div class="form-card">
        <div class="form-card-header">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
          <span>Formulir Pengiriman Pengingat</span>
        </div>
        <form action="/admin/pengingat" method="POST" onsubmit="handlePengingatSubmit(this)">
          <div class="form-group">
            <label class="form-label" for="judul">Subjek / Judul Notifikasi</label>
            <input type="text" id="judul" name="judul" class="form-input" placeholder="Contoh: Undangan Pengisian Tracer Study Universitas Hamzanwadi" required/>
          </div>

          <div class="form-group">
            <label class="form-label">Target Penerima Alumni</label>
            <div class="radio-pill-group">
              <label class="radio-pill">
                <input type="radio" name="target_alumni" value="Belum Mengisi Kuesioner" checked/>
                <span>Belum Mengisi Tracer</span>
              </label>
              <label class="radio-pill">
                <input type="radio" name="target_alumni" value="Sudah Mengisi Kuesioner"/>
                <span>Sudah Mengisi</span>
              </label>
              <label class="radio-pill">
                <input type="radio" name="target_alumni" value="Semua Alumni"/>
                <span>Seluruh Alumni</span>
              </label>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Kanal Pengiriman Notifikasi</label>
            <div class="radio-pill-group">
              <label class="radio-pill">
                <input type="radio" name="saluran" value="Email & WhatsApp" checked/>
                <span>Multi-Kanal (Email & WA)</span>
              </label>
              <label class="radio-pill">
                <input type="radio" name="saluran" value="WhatsApp Saja"/>
                <span>WhatsApp Official</span>
              </label>
              <label class="radio-pill">
                <input type="radio" name="saluran" value="Email Saja"/>
                <span>Email Official</span>
              </label>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="pesan">Isi Pesan Pengingat</label>
            <textarea id="pesan" name="pesan" class="form-textarea" rows="4" placeholder="Kepada Yth. Alumni, sehubungan dengan Tracer Study Universitas Hamzanwadi..." required></textarea>
          </div>

          <div style="display: flex; justify-content: flex-end; margin-top: 12px;">
            <button type="submit" class="btn-submit-green">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
              <span>Proses & Diseminasikan Pengingat</span>
            </button>
          </div>
        </form>
      </div>

      <!-- SIDEBAR INFO DISIMINASI -->
      <div class="info-card">
        <h4>Panduan Diseminasi</h4>
        <p>
          Sistem menguji kelayakan kontak setiap alumni sebelum pengiriman. Alumni tanpa No. HP atau email valid akan otomatis dicatat sebagai <strong>gagal terkirim</strong> beserta alasannya.
        </p>
        <div class="info-box-tip">
          <strong>Tips:</strong> Klik tombol <em>"Detail"</em> di tabel riwayat untuk membuka tautan pesan WhatsApp langsung ke alumni yang bersangkutan.
        </div>
      </div>
    </div>

    <!-- LOG RIWAYAT DISIMINASI TABLE -->
    <div class="pengingat-table-card">
      <div class="table-card-header" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
        <div>
          <h3>Riwayat Log Pengingat Alumni</h3>
          <span style="font-size: 0.8rem; font-weight: 700; color: #64748B;">Total <%= totalRows %> Laporan Diseminasi</span>
        </div>
        <% if (typeof penerimaDetail !== 'undefined' && penerimaDetail && penerimaDetail.length > 0) { %>
          <button type="button" onclick="showPenerimaModal('<%= encodeURIComponent(JSON.stringify(penerimaDetail)) %>')" style="background: linear-gradient(135deg, #059669, #047857); color: #fff; border: none; padding: 8px 16px; border-radius: 8px; font-weight: 700; font-size: 0.82rem; cursor: pointer; display: flex; align-items: center; gap: 6px; box-shadow: 0 4px 12px rgba(5,150,105,0.25);">
            <span>📱 Buka Broadcast WA 1-Klik (<%= penerimaDetail.length %> Alumni)</span>
          </button>
        <% } %>
      </div>

      <div class="table-responsive">
        <table class="pengingat-table">
          <thead>
            <tr>
              <th>SUBJEK PENGINGAT</th>
              <th style="width: 180px;">TARGET ALUMNI</th>
              <th style="width: 140px; text-align: center;">KANAL</th>
              <th style="width: 160px;">WAKTU KIRIM</th>
              <th style="width: 140px; text-align: center;">STATUS</th>
              <th style="width: 110px; text-align: right;">AKSI</th>
            </tr>
          </thead>
          <tbody>
            <% if (pengingatList.length === 0) { %>
              <tr>
                <td colspan="6" class="empty-row">
                  Belum ada log pengiriman pengingat.
                </td>
              </tr>
            <% } else { %>
              <% pengingatList.forEach(p => { %>
                <tr>
                  <td><strong style="font-weight: 700; color: #0F172A;"><%= p.judul %></strong></td>
                  <td><span style="font-size: 0.84rem; font-weight: 600; color: #475569;"><%= p.target_alumni %></span></td>
                  <td style="text-align: center;"><span style="font-size: 0.8rem; font-weight: 600; color: #059669;"><%= p.saluran %></span></td>
                  <td><span style="font-size: 0.82rem; color: #64748B;"><%= new Date(p.created_at || Date.now()).toLocaleDateString('id-ID', {day:'numeric',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) %></span></td>
                  <td style="text-align: center;">
                    <% if (p.status === 'TERKIRIM') { %>
                      <span class="status-pill-sub terkirim">Berhasil Terkirim</span>
                    <% } else if (p.status === 'PARSIAL') { %>
                      <span class="status-pill-sub parsial">Parsial</span>
                    <% } else { %>
                      <span class="status-pill-sub gagal">Gagal Terkirim</span>
                    <% } %>
                  </td>
                  <td style="text-align: right;">
                    <div style="display: flex; align-items: center; justify-content: flex-end; gap: 6px;">
                      <% if (p.detail_penerima) { %>
                        <button type="button" onclick="showPenerimaModal('<%= encodeURIComponent(p.detail_penerima) %>')" class="btn-detail-sm" title="Lihat Penerima">
                          👁️ Detail
                        </button>
                      <% } %>
                      <form action="/admin/pengingat/<%= p.id %>/hapus" method="POST" style="display:inline; margin:0;" onsubmit="return confirm('Hapus log pengingat ini?')">
                        <button type="submit" class="icon-action-btn delete" title="Hapus Log">
                          <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Footer -->
    <div style="text-align: center; padding: 24px 0 8px; font-size: 0.76rem; color: #94a3b8;">
      &copy; <%= new Date().getFullYear() %> Information Systems Fakultas Teknik Universitas Hamzanwadi. All Rights Reserved.
    </div>

  </div>
</main>

<!-- MODAL LIHAT DETAIL PENERIMA (BERHASIL & GAGAL) -->
<div id="penerimaModal" class="modal-backdrop" onclick="if(event.target===this) closePenerimaModal();">
  <div class="modal-box">
    <div class="modal-box-header">
      <h3>Detail Penerima Notifikasi Pengingat</h3>
      <button type="button" onclick="closePenerimaModal()" style="background:none; border:none; color:#fff; font-size:22px; cursor:pointer;">&times;</button>
    </div>
    <div class="modal-box-body">
      <div id="penerimaModalContent"></div>
    </div>
    <div class="modal-box-footer">
      <button type="button" onclick="closePenerimaModal()" class="btn-detail-sm">Tutup</button>
    </div>
  </div>
</div>

<script>
  function handlePengingatSubmit(form) {
    const btn = form.querySelector('.btn-submit-green');
    if (btn) {
      btn.style.opacity = '0.75';
      btn.style.pointerEvents = 'none';
      btn.innerHTML = '<span>Memproses Diseminasi...</span>';
    }
  }

  function toggleSidebar() {
    document.getElementById('sidebar').classList.toggle('open');
  }

  function showPenerimaModal(encodedJson) {
    try {
      const list = JSON.parse(decodeURIComponent(encodedJson));
      const container = document.getElementById('penerimaModalContent');

      if (!list || list.length === 0) {
        container.innerHTML = '<p style="text-align:center; color:#94a3b8; padding:20px;">Tidak ada rincian penerima.</p>';
      } else {
        let html = `
          <div style="display:flex; gap:12px; margin-bottom:16px;">
            <span style="font-size:0.8rem; font-weight:700; color:#059669; background:#ecfdf5; padding:4px 12px; border-radius:20px; border:1px solid #a7f3d0;">
              Berhasil: ${list.filter(x => x.status === 'BERHASIL').length} Alumni
            </span>
            <span style="font-size:0.8rem; font-weight:700; color:#dc2626; background:#fef2f2; padding:4px 12px; border-radius:20px; border:1px solid #fecaca;">
              Gagal: ${list.filter(x => x.status === 'GAGAL').length} Alumni
            </span>
          </div>
          <table style="width:100%; border-collapse:collapse; font-size:0.85rem;">
            <thead>
              <tr style="background:#f8fafc; border-bottom:1px solid #e2e8f0; text-align:left;">
                <th style="padding:10px 12px;">NAMA ALUMNI</th>
                <th style="padding:10px 12px;">KONTAK (HP / EMAIL)</th>
                <th style="padding:10px 12px; text-align:center;">STATUS DISIMINASI</th>
                <th style="padding:10px 12px; text-align:right;">AKSI KIRIM WA</th>
              </tr>
            </thead>
            <tbody>
        `;

        list.forEach(item => {
          const isGagal = item.status === 'GAGAL';
          const badgeClass = isGagal ? 'background:#fef2f2; color:#dc2626; border:1px solid #fecaca;' : 'background:#ecfdf5; color:#059669; border:1px solid #a7f3d0;';
          const statusText = isGagal ? 'Gagal Terkirim' : 'Berhasil';

          html += `
            <tr style="border-bottom:1px solid #f1f5f9;">
              <td style="padding:12px; font-weight:700; color:#0f172a;">${item.nama}</td>
              <td style="padding:12px; color:#475569;">
                <div>📱 ${item.no_hp || '-'}</div>
                <div style="font-size:0.78rem; color:#64748b;">✉️ ${item.email || '-'}</div>
              </td>
              <td style="padding:12px; text-align:center;">
                <span style="display:inline-block; padding:4px 10px; border-radius:50px; font-size:0.75rem; font-weight:700; ${badgeClass}">
                  ${statusText}
                </span>
                ${item.alasan ? `<div style="font-size:0.72rem; color:#94a3b8; margin-top:2px;">${item.alasan}</div>` : ''}
              </td>
              <td style="padding:12px; text-align:right;">
                ${item.waUrl ? `<a href="${item.waUrl}" target="_blank" style="display:inline-block; padding:5px 12px; background:#064E3B; color:#fff; font-weight:700; font-size:0.78rem; border-radius:6px; text-decoration:none;">Chat WA →</a>` : '<span style="color:#cbd5e1; font-size:0.78rem;">-</span>'}
              </td>
            </tr>
          `;
        });

        html += `</tbody></table>`;
        container.innerHTML = html;
      }

      document.getElementById('penerimaModal').style.display = 'flex';
    } catch(e) {
      console.error('Error rendering penerima modal:', e);
    }
  }

  function closePenerimaModal() {
    document.getElementById('penerimaModal').style.display = 'none';
  }
</script>
</body>
</html>