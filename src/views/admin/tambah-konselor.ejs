<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Tambah Konselor Karir | Tracer Study Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/admin/dashboard.css"/>
  <style>
    .form-box {
      max-width: 540px;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 24px;
      box-shadow: var(--shadow);
      margin-top: 20px;
    }
  </style>
</head>
<body>

<%- include('_sidebar', { active: 'konseling' }) %>

<main class="main-content">
  <!-- Topbar -->
  <%- include('_topbar', { breadcrumbs: [{ label: 'Konselor Karir', url: '/admin/konseling' }, { label: 'Tambah Konselor' }] }) %>

  <div class="page-content">
    <div class="page-header">
      <h1>Tambah Konselor Karir Baru</h1>
      <p>Lengkapi form berikut untuk menambahkan konselor karir baru ke dalam sistem.</p>
    </div>

    <!-- Form Box -->
    <div class="form-box">
      <% if (error) { %>
      <div class="alert alert-error" style="margin-bottom:16px;"><%= error %></div>
      <% } %>

      <form action="/admin/konseling/tambah-konselor" method="POST" enctype="multipart/form-data" style="display:flex; flex-direction:column; gap:16px;">
        <div class="form-group">
          <label for="nama">Nama Lengkap Konselor <span class="required">*</span></label>
          <input type="text" id="nama" name="nama" placeholder="Contoh: Ahmad Naufal, M.T." required style="border:1px solid var(--border); border-radius:8px; padding:10px 12px; font-size:13px; outline:none; font-family:inherit; width:100%;"/>
        </div>

        <div class="form-group">
          <label for="bidang_keahlian">Bidang Keahlian / Kompetensi <span class="required">*</span></label>
          <input type="text" id="bidang_keahlian" name="bidang_keahlian" placeholder="Contoh: UI/UX & Product Management" required style="border:1px solid var(--border); border-radius:8px; padding:10px 12px; font-size:13px; outline:none; font-family:inherit; width:100%;"/>
        </div>

        <div class="form-group">
          <label for="foto">Foto Profil Konselor</label>
          <input type="file" id="foto" name="foto" accept="image/*" style="border:1px solid var(--border); border-radius:8px; padding:8px; font-size:13px; outline:none; width:100%;"/>
          <small style="color:#666; font-size:11px; margin-top:4px;">Format file: JPG, PNG, GIF. Maksimal 2MB.</small>
        </div>

        <div class="form-actions" style="margin-top:16px; display:flex; gap:12px; justify-content:flex-end;">
          <a href="/admin/konseling" class="btn btn-outline" style="text-decoration:none;">Batal</a>
          <button type="submit" class="btn btn-primary" style="cursor:pointer; display:flex; align-items:center; gap:6px;">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z"/></svg>
            Simpan Konselor
          </button>
        </div>
      </form>
    </div>

    <!-- Footer -->
    <div style="text-align:center; border-top:1px solid #e2e8f0; padding-top:16px; font-size:11px; color:#777; margin-top:32px;">
      &copy; 2026 Information Systems Fakultas Teknik Hamzanwadi University. All Rights Reserved.
    </div>
  </div>
</main>

<script>
  function toggleSidebar() {
    document.getElementById('sidebar').classList.toggle('open');
  }
</script>
</body>
</html>
