<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Data Respon Tracer Study | Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/admin/dashboard.css"/>
  <style>
    .status-badge {
      display: inline-block;
      padding: 4px 8px;
      border-radius: 6px;
      font-size: 11px;
      font-weight: 600;
      text-transform: capitalize;
    }
    .status-bekerja { background: #e8f4ec; color: #2d6a4f; }
    .status-wirausaha { background: #fef3c7; color: #d97706; }
    .status-kuliah { background: #e0f2fe; color: #0369a1; }
    .status-belum_bekerja { background: #f3f4f6; color: #4b5563; }
  </style>
</head>
<body>

<%- include('_sidebar', { active: 'tracer' }) %>

<main class="main-content">
  <!-- Topbar -->
  <%- include('_topbar', { breadcrumbs: [{ label: 'Tracer Study', url: '/admin/tracer' }, { label: 'Respon Terbaru' }] }) %>

  <div class="page-content">
    <div class="page-header">
      <h1>Data Pengisian Tracer Study</h1>
      <p>Berikut adalah seluruh data respon tracer study dari alumni program studi Sistem Informasi Fakultas Teknik.</p>
    </div>

    <!-- Toolbar -->
    <div class="page-toolbar" style="margin-bottom: 20px;">
      <form method="GET" action="/admin/tracer/data" class="search-form" style="flex:1; display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
        <div class="search-wrap" style="max-width:300px; flex:1;">
          <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0016 9.5 6.5 6.5 0 109.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
          <input type="text" name="search" value="<%= search %>" placeholder="Cari Nama atau NIM..."/>
        </div>

        <div class="filter-group" style="display:flex; align-items:center; gap:8px;">
          <label style="font-size:12px; font-weight:600; color:#555;">Status:</label>
          <select name="status" onchange="this.form.submit()" style="border:1px solid var(--border); border-radius:8px; padding:6px 12px; font-size:13px; outline:none; background:#fff;">
            <option value="">Semua Status</option>
            <option value="bekerja" <%= filterStatus === 'bekerja' ? 'selected' : '' %>>Bekerja</option>
            <option value="wirausaha" <%= filterStatus === 'wirausaha' ? 'selected' : '' %>>Wirausaha</option>
            <option value="kuliah" <%= filterStatus === 'kuliah' ? 'selected' : '' %>>Studi Lanjut</option>
            <option value="belum_bekerja" <%= filterStatus === 'belum_bekerja' ? 'selected' : '' %>>Belum Bekerja</option>
          </select>
        </div>

        <div class="filter-group" style="display:flex; align-items:center; gap:8px;">
          <label style="font-size:12px; font-weight:600; color:#555;">Periode:</label>
          <select name="periode" onchange="this.form.submit()" style="border:1px solid var(--border); border-radius:8px; padding:6px 12px; font-size:13px; outline:none; background:#fff;">
            <option value="">Semua Periode</option>
            <% periodeList.forEach(function(p) { %>
              <option value="<%= p %>" <%= filterPeriode === p ? 'selected' : '' %>><%= p %></option>
            <% }); %>
          </select>
        </div>
        
        <button type="submit" class="btn btn-primary" style="padding:8px 16px; font-size:12px; cursor:pointer;">Cari</button>
        <a href="/admin/tracer/export" class="btn btn-ghost" style="padding:8px 16px; font-size:12px; display:inline-flex; align-items:center; gap:6px; text-decoration:none;">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z"/></svg>
          Export CSV
        </a>
      </form>
    </div>

    <!-- Table Card -->
    <div class="data-card">
      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th style="width:110px;">NIM</th>
              <th>NAMA ALUMNI</th>
              <th style="width:110px;">TAHUN LULUS</th>
              <th>STATUS PEKERJAAN</th>
              <th>INSTANSI / PERUSAHAAN</th>
              <th style="width:90px; text-align:center;">AKSI</th>
            </tr>
          </thead>
          <tbody>
            <% if (!tracers || tracers.length === 0) { %>
            <tr>
              <td colspan="6" style="text-align:center; padding:24px; color:#9ca3af;">Tidak ada data respon kuesioner.</td>
            </tr>
            <% } else { %>
            <% tracers.forEach(function(t) { %>
            <tr>
              <td><span class="nim-code"><%= t.nim %></span></td>
              <td style="font-weight:600; display:flex; align-items:center; gap:6px; border:none; padding:12px 10px;">
                <%= t.nama %>
                <% if (t.jumlah_pengisian > 1) { %>
                  <span style="background:#fef3c7; color:#ca8a04; border:1px solid #fde68a; font-size:9px; font-weight:800; padding:2px 6px; border-radius:4px; text-transform:uppercase; letter-spacing:0.5px;">Sudah Update</span>
                <% } %>
              </td>
              <td><%= t.tahun_lulus || '-' %></td>
              <td>
                <span class="status-badge status-<%= t.status_pekerjaan %>">
                  <%= t.status_pekerjaan === 'kuliah' ? 'Studi Lanjut' : t.status_pekerjaan.replace('_', ' ') %>
                </span>
              </td>
              <td><%= t.nama_perusahaan || t.nama_universitas || '-' %></td>
              <td style="text-align:center;">
                <a href="/admin/tracer/detail/<%= t.id %>" class="btn-action-text tracer-btn" style="color:#059669; border: 1px solid #a7f3d0; background:#f0fdf4; padding:4px 8px; border-radius:6px; font-size:11px; font-weight:600; text-decoration:none; display:inline-block;" title="Lihat detail jawaban">Detail</a>
              </td>
            </tr>
            <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Footer -->
    <div style="text-align:center; padding:16px 0 4px; font-size:11px; color:#aaa; margin-top:24px;">
      &copy; 2026 Information Systems Fakultas Teknik Hamzanwadi University. All Rights Reserved.
    </div>
  </div>
</main>

<script>
  function toggleSidebar() {
    document.getElementById('sidebar').classList.toggle('open');
  }
</script>
</body>
</html>
