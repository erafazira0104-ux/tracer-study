<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Kelola Tracer Study | Admin — Sistem Informasi FT Hamzanwadi</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/admin/dashboard.css"/>
  <style>
    /* Premium Tracer Category dashboard styling */
    .tambah-kategori-form {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 20px;
      padding: 32px;
      margin-bottom: 32px;
      box-shadow: 0 4px 20px -2px rgba(6, 78, 59, 0.05);
      position: relative;
      overflow: hidden;
    }
    .tambah-kategori-form::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 4px;
      background: linear-gradient(90deg, #064E3B, #eab308);
    }
    .tambah-kategori-form h3 {
      font-size: 17px; 
      font-weight: 800; 
      color: #064E3B; 
      display: flex; 
      align-items: center; 
      gap: 10px; 
      margin-bottom: 6px;
    }
    .tambah-kategori-form p {
      font-size: 13px; 
      color: #64748b; 
      margin-bottom: 24px;
    }
    .tambah-form-row {
      display: flex;
      gap: 24px;
      align-items: flex-end;
      flex-wrap: wrap;
    }
    .settings-group input[type="text"] {
      border: 1.5px solid #cbd5e1;
      border-radius: 12px;
      padding: 12px 16px;
      font-size: 14px;
      outline: none;
      background: #fafaf9;
      font-family: inherit;
      color: #1e293b;
      transition: all 0.3s ease;
      width: 100%;
    }
    .settings-group input[type="text"]:focus {
      border-color: #064E3B;
      background: #ffffff;
      box-shadow: 0 0 0 4px rgba(6, 78, 59, 0.1);
    }
    .icon-picker-grid {
      display: grid;
      grid-template-columns: repeat(9, 1fr);
      gap: 8px;
      margin-top: 8px;
      max-width: 440px;
    }
    @media (max-width: 480px) {
      .icon-picker-grid {
        grid-template-columns: repeat(6, 1fr);
      }
    }
    .icon-option {
      width: 42px; 
      height: 42px;
      border: 1.5px solid #e2e8f0;
      background: #fafaf9;
      border-radius: 12px;
      cursor: pointer;
      font-size: 20px;
      display: flex; 
      align-items: center; 
      justify-content: center;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .icon-option:hover {
      border-color: #064E3B;
      background: #f0fdf4;
      transform: scale(1.1);
    }
    .icon-option.selected {
      border-color: #064E3B;
      background: #ecfdf5;
      box-shadow: 0 0 0 3px rgba(6, 78, 59, 0.15);
      transform: scale(1.1);
    }
    
    .btn-simpan-kategori {
      background: linear-gradient(135deg, #064E3B, #043e2f);
      color: #ffffff;
      font-weight: 700;
      border: none;
      padding: 12px 24px;
      border-radius: 12px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      box-shadow: 0 4px 10px rgba(6, 78, 59, 0.2);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      height: 45px;
    }
    .btn-simpan-kategori:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(6, 78, 59, 0.35);
      background: linear-gradient(135deg, #053e2f, #032b20);
    }
    
    /* Kategori Cards Grid */
    .kategori-flex-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
      gap: 28px;
      margin-bottom: 36px;
    }
    .kategori-card-custom {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 20px;
      padding: 32px 24px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.03), 0 2px 4px -1px rgba(0, 0, 0, 0.02);
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      position: relative;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .kategori-card-custom:hover {
      transform: translateY(-8px);
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.08), 0 10px 10px -5px rgba(0, 0, 0, 0.03);
      border-color: #064E3B;
    }
    .kategori-circle {
      width: 68px; 
      height: 68px;
      border-radius: 50%;
      display: flex; 
      align-items: center; 
      justify-content: center;
      font-size: 30px;
      margin-bottom: 20px;
      background: linear-gradient(135deg, #f0fdf4, #dcfce7);
      color: #065f46;
      box-shadow: 0 4px 10px rgba(6, 78, 59, 0.05);
      transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .kategori-card-custom:hover .kategori-circle {
      transform: scale(1.12) rotate(6deg);
    }
    .kategori-card-custom h4 {
      font-size: 17px; 
      font-weight: 750; 
      color: #0f172a; 
      margin-bottom: 8px;
    }
    .kategori-card-meta {
      font-size: 13px; 
      color: #64748b; 
      display: flex; 
      align-items: center; 
      gap: 6px; 
      margin-bottom: 28px;
    }
    .kategori-card-meta svg {
      width: 14px; 
      height: 14px; 
      fill: #94a3b8;
    }
    .btn-kelola-custom {
      width: 100%;
      padding: 11px 18px;
      border: 2px solid #064E3B;
      color: #064E3B;
      background: transparent;
      font-weight: 700;
      font-size: 13px;
      border-radius: 12px;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex; 
      align-items: center; 
      justify-content: center;
      gap: 6px;
      transition: all 0.25s ease;
      margin-top: auto;
    }
    .btn-kelola-custom:hover {
      background: #064E3B;
      color: #ffffff;
      box-shadow: 0 6px 16px rgba(6, 78, 59, 0.2);
    }
    
    /* Absolute Floating Action Buttons (Edit & Delete) */
    .actions-btn-absolute {
      position: absolute;
      top: 16px;
      right: 16px;
      opacity: 0;
      transform: scale(0.9);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      display: flex;
      gap: 6px;
    }
    .kategori-card-custom:hover .actions-btn-absolute {
      opacity: 1;
      transform: scale(1);
    }
    .btn-edit-custom {
      background: #eff6ff;
      color: #3b82f6;
      border: 1.5px solid #bfdbfe;
      width: 36px;
      height: 36px;
      border-radius: 10px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
    }
    .btn-edit-custom:hover {
      background: #3b82f6;
      color: #ffffff;
      border-color: #3b82f6;
      box-shadow: 0 4px 10px rgba(59, 130, 246, 0.2);
      transform: scale(1.05);
    }
    .btn-hapus-custom {
      background: #fee2e2; 
      color: #ef4444; 
      border: 1.5px solid #fecaca; 
      width: 36px; 
      height: 36px; 
      border-radius: 10px; 
      cursor: pointer; 
      display: flex; 
      align-items: center; 
      justify-content: center; 
      transition: all 0.2s ease;
    }
    .btn-hapus-custom:hover {
      background: #ef4444;
      color: #ffffff;
      border-color: #ef4444;
      box-shadow: 0 4px 10px rgba(239, 68, 68, 0.2);
      transform: scale(1.05);
    }
    
    /* Campus Banner */
    .campus-banner-custom {
      height: 180px;
      border-radius: 20px;
      background: linear-gradient(135deg, rgba(6, 78, 59, 0.85), rgba(5, 61, 47, 0.95)), url('/images/students-hero.jpg');
      background-size: cover;
      background-position: center;
      display: flex;
      align-items: center;
      padding: 0 40px;
      color: #fff;
      box-shadow: 0 10px 20px -5px rgba(6, 78, 59, 0.1);
      margin-bottom: 24px;
      overflow: hidden;
      position: relative;
    }
    .campus-badge {
      background: rgba(255,255,255,0.2);
      backdrop-filter: blur(4px);
      border: 1px solid rgba(255,255,255,0.3);
      padding: 6px 14px;
      border-radius: 30px;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      display: inline-block;
      margin-bottom: 12px;
    }
    .campus-banner-custom h3 {
      font-size: 26px; 
      font-weight: 800;
      text-shadow: 0 2px 4px rgba(0,0,0,0.2);
    }
  </style>
</head>
<body>

<%- include('_sidebar', { active: 'tracer' }) %>

<main class="main-content">
  <!-- Topbar -->
  <%- include('_topbar', { breadcrumbs: [{ label: 'Admin', url: '/admin/dashboard' }, { label: 'Tracer Study' }] }) %>

  <div class="page-content" style="background:#fcfcfa; min-height: calc(100vh - 60px); padding: 32px;">
    <!-- Header info -->
    <div class="kategori-header-section" style="margin-bottom: 28px; display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; flex-wrap: wrap;">
      <div style="flex: 1; min-width: 300px;">
        <h2 style="font-size: 22px; font-weight: 800; color: #064E3B; display: flex; align-items: center; gap: 8px;">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
          TRACER STUDY FAKULTAS TEKNIK HAMZANWADI
        </h2>
        <p style="font-size:13px; color:#64748b; margin-top:6px; line-height:1.5; max-width: 900px;">
          Kelola kuesioner tracer study dan atur periode/masa pengisian berkala bagi alumni program studi Sistem Informasi.
        </p>
      </div>
      <div style="display: flex; gap: 12px; align-items: center;">
        <a href="/admin/tracer/periode" class="btn btn-secondary" style="background: linear-gradient(135deg, #eab308, #ca8a04); color: #fff; font-weight: 700; padding: 12px 20px; border-radius: 12px; font-size: 13px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 4px 12px rgba(202, 138, 4, 0.2); transition: all 0.3s ease;">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
          Atur Masa Pengisian
        </a>
        <a href="/admin/tracer/data" class="btn btn-primary" style="background: linear-gradient(135deg, #064E3B, #043e2f); color: #fff; font-weight: 700; padding: 12px 20px; border-radius: 12px; font-size: 13px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 4px 12px rgba(6, 78, 59, 0.2); transition: all 0.3s ease;">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
          Lihat Respon Alumni
        </a>
      </div>
    </div>




    <!-- Tambah Kategori Form -->
    <div class="tambah-kategori-form">
      <h3>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
        Tambah Kategori Baru
      </h3>
      <p>Buat kategori kuesioner baru untuk segmentasi alumni</p>
      
      <form action="/admin/tracer/kategori/tambah" method="POST" class="tambah-form-row">
        <div class="settings-group" style="flex:1; min-width:240px; display:flex; flex-direction:column; gap:6px;">
          <label for="nama" style="font-size:13px; font-weight:600; color:#475569;">Nama Kategori</label>
          <input type="text" id="nama" name="nama" placeholder="Contoh: Penilaian Prodi" required/>
        </div>

        <div class="settings-group" style="display:flex; flex-direction:column; gap:6px;">
          <label style="font-size:13px; font-weight:600; color:#475569;">Pilih Icon</label>
          <div class="icon-picker-grid">
            <button type="button" class="icon-option selected" onclick="selectIcon(this,'💼')" title="Bekerja">💼</button>
            <button type="button" class="icon-option" onclick="selectIcon(this,'🏪')" title="Wirausaha">🏪</button>
            <button type="button" class="icon-option" onclick="selectIcon(this,'🎓')" title="Studi Lanjut">🎓</button>
            <button type="button" class="icon-option" onclick="selectIcon(this,'👤')" title="Belum Bekerja">👤</button>
            <button type="button" class="icon-option" onclick="selectIcon(this,'📚')" title="Penilaian">📚</button>
            <button type="button" class="icon-option" onclick="selectIcon(this,'🏢')" title="Perusahaan">🏢</button>
            <button type="button" class="icon-option" onclick="selectIcon(this,'💻')" title="Teknologi">💻</button>
            <button type="button" class="icon-option" onclick="selectIcon(this,'📊')" title="Statistik">📊</button>
            <button type="button" class="icon-option" onclick="selectIcon(this,'🌐')" title="Global">🌐</button>
            <button type="button" class="icon-option" onclick="selectIcon(this,'📈')" title="Karir">📈</button>
            <button type="button" class="icon-option" onclick="selectIcon(this,'🛠️')" title="Fasilitas">🛠️</button>
            <button type="button" class="icon-option" onclick="selectIcon(this,'📝')" title="Kuesioner">📝</button>
            <button type="button" class="icon-option" onclick="selectIcon(this,'💬')" title="Saran">💬</button>
            <button type="button" class="icon-option" onclick="selectIcon(this,'🏫')" title="Akademik">🏫</button>
            <button type="button" class="icon-option" onclick="selectIcon(this,'🏆')" title="Prestasi">🏆</button>
            <button type="button" class="icon-option" onclick="selectIcon(this,'🔍')" title="Evaluasi">🔍</button>
            <button type="button" class="icon-option" onclick="selectIcon(this,'⭐')" title="Kepuasan">⭐</button>
            <button type="button" class="icon-option" onclick="selectIcon(this,'🤝')" title="Relasi">🤝</button>
            <input type="hidden" name="icon" id="selectedIcon" value="💼"/>
          </div>
        </div>

        <button type="submit" class="btn-simpan-kategori" style="margin-left:auto;">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z"/></svg>
          Simpan Kategori
        </button>
      </form>
    </div>

    <!-- Kategori Cards Grid -->
    <div class="kategori-flex-grid">
      <% kategoris.forEach(function(kat) { %>
      <div class="kategori-card-custom">
        <!-- Floating Absolute Actions (Edit & Delete) -->
        <div class="actions-btn-absolute">
          <button type="button" class="btn-edit-custom" title="Edit Kategori" onclick='openEditKategoriModal(<%= JSON.stringify(kat) %>)'>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
          </button>
          <form action="/admin/tracer/kategori/<%= kat.id %>/hapus" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus kategori ini dan semua pertanyaan terkait?')" style="display:inline;">
            <button type="submit" class="btn-hapus-custom" title="Hapus Kategori">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="stroke: currentColor;"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
            </button>
          </form>
        </div>

        <div class="kategori-circle">
          <%= kat.icon || '💼' %>
        </div>
        <h4><%= kat.label %></h4>
        <div class="kategori-card-meta">
          <svg viewBox="0 0 24 24"><path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/></svg>
          <span><%= kat.jumlah_pertanyaan %> Pertanyaan</span>
        </div>
        <a href="/admin/tracer/<%= kat.slug %>" class="btn-kelola-custom">Kelola Kuesioner &rarr;</a>
      </div>
      <% }) %>
    </div>

    <!-- Campus Banner -->
    <div class="campus-banner-custom">
      <div>
        <span class="campus-badge">Campus Environment</span>
        <h3>Membangun Masa Depan Alumni</h3>
      </div>
    </div>

    <!-- Footer -->
    <div style="text-align:center; border-top:1px solid #e2e8f0; padding-top:16px; font-size:11px; color:#777; margin-top:32px;">
      &copy; 2026 Information Systems Fakultas Teknik Universitas Hamzanwadi. All Rights Reserved.
    </div>
  </div>
</main>

<!-- MODAL EDIT KATEGORI -->
<div id="modalEditKategori" class="modal-admin-backdrop" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(15,23,42,0.3); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); z-index:9999; align-items:center; justify-content:center;">
  <div style="background:#fff; border-radius:24px; border:1px solid rgba(6,78,59,0.08); width:100%; max-width:500px; padding:32px; box-shadow:0 24px 50px -12px rgba(0,0,0,0.15); position:relative;">
    <h3 style="font-size:18px; font-weight:800; color:#064E3B; margin-bottom:6px; display:flex; align-items:center; gap:8px;">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
      Edit Kategori Kuesioner
    </h3>
    <p style="font-size:13px; color:#64748b; margin-bottom:24px;">Perbarui nama dan ikon pengenal kategori kuesioner.</p>
    
    <form id="formEditKategori" action="" method="POST" style="display:flex; flex-direction:column; gap:20px;">
      <div style="display:flex; flex-direction:column; gap:6px;">
        <label for="edit_nama" style="font-size:12px; font-weight:700; color:#334155; text-transform:uppercase;">Nama Kategori</label>
        <input type="text" id="edit_nama" name="nama" required style="border:1.5px solid #cbd5e1; border-radius:12px; padding:12px 16px; font-size:14px; outline:none; background:#fafaf9; width:100%; box-sizing:border-box;"/>
      </div>
      
      <div style="display:flex; flex-direction:column; gap:6px;">
        <label style="font-size:12px; font-weight:700; color:#334155; text-transform:uppercase;">Pilih Icon</label>
        <div class="icon-picker-grid" style="max-width:100%;">
          <button type="button" class="icon-option edit-icon-opt" onclick="selectEditIcon(this,'💼')" title="Bekerja">💼</button>
          <button type="button" class="icon-option edit-icon-opt" onclick="selectEditIcon(this,'🏪')" title="Wirausaha">🏪</button>
          <button type="button" class="icon-option edit-icon-opt" onclick="selectEditIcon(this,'🎓')" title="Studi Lanjut">🎓</button>
          <button type="button" class="icon-option edit-icon-opt" onclick="selectEditIcon(this,'👤')" title="Belum Bekerja">👤</button>
          <button type="button" class="icon-option edit-icon-opt" onclick="selectEditIcon(this,'📚')" title="Penilaian">📚</button>
          <button type="button" class="icon-option edit-icon-opt" onclick="selectEditIcon(this,'🏢')" title="Perusahaan">🏢</button>
          <button type="button" class="icon-option edit-icon-opt" onclick="selectEditIcon(this,'💻')" title="Teknologi">💻</button>
          <button type="button" class="icon-option edit-icon-opt" onclick="selectEditIcon(this,'📊')" title="Statistik">📊</button>
          <button type="button" class="icon-option edit-icon-opt" onclick="selectEditIcon(this,'🌐')" title="Global">🌐</button>
          <button type="button" class="icon-option edit-icon-opt" onclick="selectEditIcon(this,'📈')" title="Karir">📈</button>
          <button type="button" class="icon-option edit-icon-opt" onclick="selectEditIcon(this,'🛠️')" title="Fasilitas">🛠️</button>
          <button type="button" class="icon-option edit-icon-opt" onclick="selectEditIcon(this,'📝')" title="Kuesioner">📝</button>
          <button type="button" class="icon-option edit-icon-opt" onclick="selectEditIcon(this,'💬')" title="Saran">💬</button>
          <button type="button" class="icon-option edit-icon-opt" onclick="selectEditIcon(this,'🏫')" title="Akademik">🏫</button>
          <button type="button" class="icon-option edit-icon-opt" onclick="selectEditIcon(this,'🏆')" title="Prestasi">🏆</button>
          <button type="button" class="icon-option edit-icon-opt" onclick="selectEditIcon(this,'🔍')" title="Evaluasi">🔍</button>
          <button type="button" class="icon-option edit-icon-opt" onclick="selectEditIcon(this,'⭐')" title="Kepuasan">⭐</button>
          <button type="button" class="icon-option edit-icon-opt" onclick="selectEditIcon(this,'🤝')" title="Relasi">🤝</button>
          <input type="hidden" name="icon" id="selectedEditIcon" value="💼"/>
        </div>
      </div>
      
      <div style="display:flex; justify-content:flex-end; gap:12px; margin-top:12px;">
        <button type="button" class="btn btn-ghost" onclick="closeEditKategoriModal()" style="padding:12px 20px; font-weight:700; font-size:14px; border:none; cursor:pointer; background:none; color:#64748b;">Batal</button>
        <button type="submit" class="btn-simpan-kategori" style="height:44px; padding:0 24px;">Simpan Perubahan</button>
      </div>
    </form>
  </div>
</div>

<script>
  function toggleSidebar() {
    document.getElementById('sidebar').classList.toggle('open');
  }
  function selectIcon(btn, icon) {
    document.querySelectorAll('.icon-option').forEach(el => el.classList.remove('selected'));
    btn.classList.add('selected');
    document.getElementById('selectedIcon').value = icon;
  }
  
  // Edit Kategori Modal Functions
  function openEditKategoriModal(kat) {
    const modal = document.getElementById('modalEditKategori');
    const form = document.getElementById('formEditKategori');
    const nameInput = document.getElementById('edit_nama');
    const hiddenIconInput = document.getElementById('selectedEditIcon');
    
    // Set Action URL
    form.action = `/admin/tracer/kategori/${kat.id}/edit`;
    
    // Set Fields
    nameInput.value = kat.label;
    hiddenIconInput.value = kat.icon || '💼';
    
    // Select the active icon in grid
    document.querySelectorAll('.edit-icon-opt').forEach(btn => {
      btn.classList.remove('selected');
      if (btn.innerText.trim() === (kat.icon || '💼').trim()) {
        btn.classList.add('selected');
      }
    });
    
    modal.style.display = 'flex';
  }
  
  function closeEditKategoriModal() {
    document.getElementById('modalEditKategori').style.display = 'none';
  }
  
  function selectEditIcon(btn, icon) {
    document.querySelectorAll('.edit-icon-opt').forEach(el => el.classList.remove('selected'));
    btn.classList.add('selected');
    document.getElementById('selectedEditIcon').value = icon;
  }
  
  // Close modal when clicking outer backdrop
  window.addEventListener('click', function(e) {
    const modal = document.getElementById('modalEditKategori');
    if (e.target === modal) {
      closeEditKategoriModal();
    }
  });
</script>
<%- include('components/custom-toast-confirm') %>
</body>
</html>
