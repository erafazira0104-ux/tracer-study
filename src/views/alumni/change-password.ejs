<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Reset Password | Alumni Tracer Study</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/alumni/dashboard.css"/>
  <link rel="stylesheet" href="/css/alumni/profile.css"/>
  <style>
    /* Custom Styling Enhancements for Change Password Page */
    .pw-input-wrap {
      position: relative;
      width: 100%;
    }
    .pw-input-wrap input {
      width: 100%;
      padding: 12px 46px 12px 16px;
      border: 1.5px solid #cbd5e1;
      border-radius: 12px;
      font-size: 0.92rem;
      font-family: inherit;
      color: #0f172a;
      background-color: #f8fafc;
      transition: all 0.25s ease;
      box-sizing: border-box;
    }
    .pw-input-wrap input:focus {
      background-color: #ffffff;
      border-color: #059669;
      box-shadow: 0 0 0 4px rgba(5, 150, 105, 0.12);
      outline: none;
    }
    .pw-toggle-btn {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      cursor: pointer;
      padding: 6px;
      color: #64748b;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      transition: color 0.2s ease, background 0.2s ease;
    }
    .pw-toggle-btn:hover {
      color: #064e3b;
      background-color: #f1f5f9;
    }
    
    /* Password Strength Meter */
    .pw-meter-wrap {
      margin-top: 8px;
    }
    .pw-meter-bars {
      display: flex;
      gap: 6px;
      height: 5px;
      margin-bottom: 6px;
    }
    .pw-meter-bar {
      flex: 1;
      height: 100%;
      border-radius: 10px;
      background-color: #e2e8f0;
      transition: background-color 0.3s ease;
    }
    .pw-meter-text {
      font-size: 0.78rem;
      font-weight: 600;
      color: #64748b;
    }

    /* Buttons */
    .btn-save-pw {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: linear-gradient(135deg, #064e3b 0%, #047857 100%);
      color: #ffffff;
      font-weight: 700;
      font-size: 0.9rem;
      padding: 12px 26px;
      border-radius: 12px;
      border: none;
      cursor: pointer;
      transition: all 0.25s ease;
      box-shadow: 0 4px 14px rgba(6, 78, 59, 0.2);
    }
    .btn-save-pw:hover {
      background: linear-gradient(135deg, #043e2f 0%, #064e3b 100%);
      box-shadow: 0 8px 20px rgba(6, 78, 59, 0.35);
      transform: translateY(-1px);
    }

    .btn-back-dash {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #ffffff;
      color: #475569;
      border: 1.5px solid #cbd5e1;
      font-weight: 700;
      font-size: 0.88rem;
      padding: 12px 20px;
      border-radius: 12px;
      text-decoration: none;
      transition: all 0.2s ease;
    }
    .btn-back-dash:hover {
      background: #f8fafc;
      color: #0f172a;
      border-color: #94a3b8;
    }
  </style>
</head>
<body>

<div class="dashboard-container">
  <!-- SIDEBAR PARTIAL -->
  <%- include('../partials/alumni-sidebar') %>

  <!-- MAIN CONTENT -->
  <div class="main-content">
    
    <!-- TOP HEADER -->
    <%- include('../partials/alumni-topbar', { topbarTitle: 'Reset Password', topbarSub: 'Keamanan & Perlindungan Akun Alumni' }) %>

    <!-- CONTENT WRAPPER -->
    <div class="content-body">
      
      <!-- BREADCRUMBS -->
      <div class="breadcrumbs">
        <a href="/alumni/dashboard">Beranda</a>
        <span>/</span>
        <span class="active">Reset Password</span>
      </div>

      <!-- HERO BANNER -->
      <div class="welcome-hero" style="background: linear-gradient(135deg, #064E3B 0%, #047857 60%, #059669 100%); border-radius: 20px; padding: 28px 32px; color: #ffffff; position: relative; overflow: hidden; box-shadow: 0 10px 30px rgba(6, 78, 59, 0.18); margin-bottom: 24px;">
        <div style="position: absolute; top: -40px; right: -40px; width: 220px; height: 220px; background: rgba(255,255,255,0.06); border-radius: 50%; pointer-events: none;"></div>
        <div style="position: relative; z-index: 2; display: flex; align-items: center; gap: 20px; flex-wrap: wrap;">
          <div style="width: 60px; height: 60px; border-radius: 50%; border: 2.5px solid #a7f3d0; background: rgba(255,255,255,0.15); display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 26px;">
            🔐
          </div>
          <div>
            <h2 style="font-size: 1.4rem; font-weight: 800; margin: 0 0 4px 0; color: #ffffff;">Keamanan Akun Alumni</h2>
            <p style="font-size: 0.88rem; color: #d1fae5; margin: 0; opacity: 0.95;">Perbarui password Anda secara berkala untuk menjaga kerahasiaan dan integritas data akun Tracer Study Anda.</p>
          </div>
        </div>
      </div>

      <!-- Flash Alert -->
      <% if (success) { %>
        <div class="alert alert-success" style="border-radius:14px; margin-bottom:20px;">
          <div class="alert-icon">✓</div>
          <div class="alert-content"><%= success %></div>
        </div>
      <% } %>
      <% if (error) { %>
        <div class="alert alert-error" style="border-radius:14px; margin-bottom:20px;">
          <div class="alert-icon">⚠️</div>
          <div class="alert-content"><%= error %></div>
        </div>
      <% } %>

      <!-- FORM GRID -->
      <div class="profile-grid">
        
        <!-- LEFT: FORM DATA -->
        <div class="profile-form-area">
          <div class="form-card" style="border-radius: 20px; border: 1px solid #e2e8f0; box-shadow: 0 8px 24px rgba(0,0,0,0.04);">
            <div class="form-card-header" style="background: #ffffff; padding: 20px 24px; border-bottom: 1px solid #f1f5f9; display: flex; align-items: center; gap: 10px;">
              <span style="background: #ecfdf5; color: #047857; padding: 8px; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
              </span>
              <h3 style="font-size: 1.1rem; font-weight: 800; color: #064e3b; margin: 0;">Ubah Password Akun</h3>
            </div>

            <div class="form-card-body" style="padding: 24px;">
              <form action="/alumni/change-password" method="POST" id="changePasswordForm">
                
                <!-- PASSWORD LAMA -->
                <div class="form-row" style="margin-bottom: 22px;">
                  <div class="form-group" style="width:100%;">
                    <label for="current_password" style="font-weight: 700; font-size: 0.88rem; color: #1e293b; display: block; margin-bottom: 8px;">Password Saat Ini <span style="color:#ef4444;">*</span></label>
                    <div class="pw-input-wrap">
                      <input type="password" id="current_password" name="current_password" placeholder="Masukkan password lama Anda" required />
                      <button type="button" class="pw-toggle-btn" onclick="togglePwVis('current_password')" title="Tampilkan/Sembunyikan">
                        <svg class="eye-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
                      </button>
                    </div>
                  </div>
                </div>

                <div style="height: 1px; background: #f1f5f9; margin-bottom: 22px;"></div>

                <!-- PASSWORD BARU & KONFIRMASI -->
                <div class="form-row two-cols" style="margin-bottom: 24px;">
                  <!-- NEW PW -->
                  <div class="form-group">
                    <label for="new_password" style="font-weight: 700; font-size: 0.88rem; color: #1e293b; display: block; margin-bottom: 8px;">Password Baru <span style="color:#ef4444;">*</span></label>
                    <div class="pw-input-wrap">
                      <input type="password" id="new_password" name="new_password" placeholder="Minimal 6 karakter" required minlength="6" oninput="evalPwStrength(this.value); checkPwMatch();" />
                      <button type="button" class="pw-toggle-btn" onclick="togglePwVis('new_password')" title="Tampilkan/Sembunyikan">
                        <svg class="eye-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
                      </button>
                    </div>
                    <!-- Strength meter -->
                    <div class="pw-meter-wrap">
                      <div class="pw-meter-bars">
                        <div class="pw-meter-bar" id="bar1"></div>
                        <div class="pw-meter-bar" id="bar2"></div>
                        <div class="pw-meter-bar" id="bar3"></div>
                      </div>
                      <span class="pw-meter-text" id="pwStrengthLabel">Kekuatan Password: -</span>
                    </div>
                  </div>

                  <!-- CONFIRM PW -->
                  <div class="form-group">
                    <label for="confirm_password" style="font-weight: 700; font-size: 0.88rem; color: #1e293b; display: block; margin-bottom: 8px;">Konfirmasi Password Baru <span style="color:#ef4444;">*</span></label>
                    <div class="pw-input-wrap">
                      <input type="password" id="confirm_password" name="confirm_password" placeholder="Ulangi password baru" required minlength="6" oninput="checkPwMatch()" />
                      <button type="button" class="pw-toggle-btn" onclick="togglePwVis('confirm_password')" title="Tampilkan/Sembunyikan">
                        <svg class="eye-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
                      </button>
                    </div>
                    <div id="pwMatchBadge" style="display:none; font-size:0.78rem; font-weight:700; margin-top:8px;"></div>
                  </div>
                </div>

                <!-- ACTIONS ROW -->
                <div style="display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: 28px; padding-top: 20px; border-top: 1px solid #f1f5f9; flex-wrap: wrap;">
                  <a href="/alumni/dashboard" class="btn-back-dash">← Kembali ke Dashboard</a>
                  <button type="submit" class="btn-save-pw">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z"/></svg>
                    <span>Simpan Password Baru</span>
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>

        <!-- RIGHT: WIDGET PANELS -->
        <div class="profile-widgets-area">
          
          <!-- TIPS CARD -->
          <div class="card widget-card tips-card" style="border-radius: 20px; border: 1px solid #e2e8f0; box-shadow: 0 8px 24px rgba(0,0,0,0.03);">
            <div class="widget-header" style="display:flex; align-items:center; gap:8px; margin-bottom:16px;">
              <span style="font-size: 20px;">🛡️</span>
              <h4 style="font-size: 1rem; font-weight: 800; color: #064e3b; margin:0;">Panduan Keamanan</h4>
            </div>
            <ul class="tips-list" style="display:flex; flex-direction:column; gap:12px; padding:0; margin:0; list-style:none;">
              <li style="display:flex; align-items:flex-start; gap:10px; font-size:0.84rem; color:#475569; line-height:1.5;">
                <span style="color:#059669; font-weight:800;">🔑</span>
                <span><strong>Kombinasi Karakter:</strong> Gunakan kombinasi huruf besar, huruf kecil, angka & simbol untuk password yang kuat.</span>
              </li>
              <li style="display:flex; align-items:flex-start; gap:10px; font-size:0.84rem; color:#475569; line-height:1.5;">
                <span style="color:#059669; font-weight:800;">🙈</span>
                <span><strong>Privasi Terjamin:</strong> Jangan pernah membagikan kata sandi Anda kepada siapapun.</span>
              </li>
              <li style="display:flex; align-items:flex-start; gap:10px; font-size:0.84rem; color:#475569; line-height:1.5;">
                <span style="color:#059669; font-weight:800;">🔄</span>
                <span><strong>Pembaruan Berkala:</strong> Disarankan memperbarui password secara berkala setiap 3-6 bulan sekali.</span>
              </li>
            </ul>
          </div>

          <!-- USER META WIDGET -->
          <div class="card widget-card" style="border-radius: 20px; border: 1px solid #e2e8f0; background: #ffffff; padding: 20px; box-shadow: 0 8px 24px rgba(0,0,0,0.03);">
            <div style="display: flex; align-items: center; gap: 14px;">
              <div style="width: 48px; height: 48px; border-radius: 50%; background: #064e3b; color: #ffffff; font-weight: 800; font-size: 18px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <%= (alumni && alumni.nama) ? alumni.nama[0].toUpperCase() : 'A' %>
              </div>
              <div style="min-width: 0;">
                <h5 style="margin: 0 0 2px; font-size: 0.92rem; font-weight: 800; color: #0f172a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                  <%= alumni ? alumni.nama : 'Alumni' %>
                </h5>
                <p style="margin: 0; font-size: 0.78rem; color: #64748b;">NIM: <%= alumni ? alumni.nim : '-' %></p>
                <span style="display: inline-block; margin-top: 6px; background: #ecfdf5; color: #047857; font-size: 10px; font-weight: 800; padding: 2px 8px; border-radius: 12px; border: 1px solid #a7f3d0;">
                  Akun Alumni Terdaftar
                </span>
              </div>
            </div>
          </div>

        </div>

      </div>

    </div>

    <!-- FOOTER -->
    <footer class="main-footer">
      <p>&copy; <%= new Date().getFullYear() %> Information Systems Fakultas Teknik Universitas Hamzanwadi. All Rights Reserved.</p>
    </footer>

  </div>
</div>

<script>
  // Toggle password visibility
  function togglePwVis(fieldId) {
    const input = document.getElementById(fieldId);
    const btn = input.parentElement.querySelector('.eye-icon');
    if (input.type === 'password') {
      input.type = 'text';
      btn.innerHTML = '<path d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z"/>';
    } else {
      input.type = 'password';
      btn.innerHTML = '<path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>';
    }
  }

  // Password Strength Evaluator
  function evalPwStrength(pw) {
    const b1 = document.getElementById('bar1');
    const b2 = document.getElementById('bar2');
    const b3 = document.getElementById('bar3');
    const label = document.getElementById('pwStrengthLabel');

    if (!pw || pw.length === 0) {
      b1.style.backgroundColor = '#e2e8f0';
      b2.style.backgroundColor = '#e2e8f0';
      b3.style.backgroundColor = '#e2e8f0';
      label.textContent = 'Kekuatan Password: -';
      label.style.color = '#64748b';
      return;
    }

    let score = 0;
    if (pw.length >= 6) score++;
    if (pw.length >= 9 && /[A-Z]/.test(pw)) score++;
    if (/[0-9]/.test(pw) && /[^A-Za-z0-9]/.test(pw)) score++;

    if (score === 1) {
      b1.style.backgroundColor = '#ef4444';
      b2.style.backgroundColor = '#e2e8f0';
      b3.style.backgroundColor = '#e2e8f0';
      label.textContent = 'Kekuatan Password: Lemah ⚠️';
      label.style.color = '#ef4444';
    } else if (score === 2) {
      b1.style.backgroundColor = '#f59e0b';
      b2.style.backgroundColor = '#f59e0b';
      b3.style.backgroundColor = '#e2e8f0';
      label.textContent = 'Kekuatan Password: Sedang 👍';
      label.style.color = '#d97706';
    } else {
      b1.style.backgroundColor = '#10b981';
      b2.style.backgroundColor = '#10b981';
      b3.style.backgroundColor = '#10b981';
      label.textContent = 'Kekuatan Password: Sangat Kuat 🛡️';
      label.style.color = '#059669';
    }
  }

  // Password match validation
  const newPw = document.getElementById('new_password');
  const confirmPw = document.getElementById('confirm_password');
  const matchBadge = document.getElementById('pwMatchBadge');

  function checkPwMatch() {
    if (!confirmPw.value) {
      matchBadge.style.display = 'none';
      return;
    }
    matchBadge.style.display = 'block';
    if (newPw.value === confirmPw.value) {
      matchBadge.textContent = '✓ Password cocok';
      matchBadge.style.color = '#059669';
    } else {
      matchBadge.textContent = '✕ Password belum cocok';
      matchBadge.style.color = '#ef4444';
    }
  }

  document.getElementById('changePasswordForm').addEventListener('submit', function(e) {
    if (newPw.value !== confirmPw.value) {
      e.preventDefault();
      alert('Password baru dan konfirmasi password tidak cocok!');
      confirmPw.focus();
    }
  });

  // Auto dismiss flash alerts
  setTimeout(() => {
    document.querySelectorAll('.alert').forEach(el => {
      el.style.opacity = '0';
      setTimeout(() => el.remove(), 500);
    });
  }, 4000);
</script>
</body>
</html>
