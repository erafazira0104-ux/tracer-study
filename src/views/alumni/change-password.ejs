<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Ganti Sandi | Alumni Tracer Study</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/alumni/dashboard.css"/>
  <link rel="stylesheet" href="/css/alumni/profile.css"/>
</head>
<body>

<div class="dashboard-container">
  <!-- SIDEBAR PARTIAL -->
  <%- include('../partials/alumni-sidebar') %>

  <!-- MAIN CONTENT -->
  <div class="main-content">
    
    <!-- TOP HEADER -->
    <%- include('../partials/alumni-topbar', { topbarTitle: 'Ganti Sandi', topbarSub: 'Keamanan Akun Alumni' }) %>

    <!-- CONTENT WRAPPER -->
    <div class="content-body">
      
      <!-- BREADCRUMBS -->
      <div class="breadcrumbs">
        <a href="/alumni/dashboard">Beranda</a>
        <span>/</span>
        <span class="active">Ganti Sandi</span>
      </div>

      <!-- PAGE TITLE -->
      <div class="page-title-section">
        <h2>Ganti Sandi</h2>
        <p>Ubah password akun alumni Anda untuk keamanan yang lebih baik</p>
      </div>

      <!-- Flash Alert -->
      <% if (success) { %>
        <div class="alert alert-success">
          <div class="alert-icon">✓</div>
          <div class="alert-content"><%= success %></div>
        </div>
      <% } %>
      <% if (error) { %>
        <div class="alert alert-error">
          <div class="alert-icon">⚠️</div>
          <div class="alert-content"><%= error %></div>
        </div>
      <% } %>

      <!-- FORM GRID -->
      <div class="profile-grid">
        
        <!-- LEFT: FORM DATA -->
        <div class="profile-form-area">
          <div class="form-card">
            <div class="form-card-header">
              <span class="header-icon-box">🔒</span>
              <h3>Ubah Password</h3>
            </div>
            <div class="form-card-body">
              <form action="/alumni/change-password" method="POST" id="changePasswordForm">
                <div class="form-row">
                  <div class="form-group" style="width:100%;">
                    <label for="current_password">Password Lama <span style="color:#e53e3e;">*</span></label>
                    <div style="position:relative; width:100%;">
                      <input type="password" id="current_password" name="current_password" placeholder="Masukkan password saat ini" required style="width:100%; padding-right:44px; box-sizing:border-box;"/>
                      <button type="button" onclick="togglePwVis('current_password')" style="position:absolute; right:12px; top:50%; transform:translateY(-50%); background:none; border:none; cursor:pointer; padding:4px; color:#666; display:flex; align-items:center; justify-content:center;" title="Tampilkan/Sembunyikan Password">
                        <svg class="eye-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
                      </button>
                    </div>
                  </div>
                </div>
                <div class="form-row two-cols">
                  <div class="form-group">
                    <label for="new_password">Password Baru <span style="color:#e53e3e;">*</span></label>
                    <div style="position:relative; width:100%;">
                      <input type="password" id="new_password" name="new_password" placeholder="Minimal 6 karakter" required minlength="6" style="width:100%; padding-right:44px; box-sizing:border-box;"/>
                      <button type="button" onclick="togglePwVis('new_password')" style="position:absolute; right:12px; top:50%; transform:translateY(-50%); background:none; border:none; cursor:pointer; padding:4px; color:#666; display:flex; align-items:center; justify-content:center;" title="Tampilkan/Sembunyikan Password">
                        <svg class="eye-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
                      </button>
                    </div>
                  </div>
                  <div class="form-group">
                    <label for="confirm_password">Konfirmasi Password Baru <span style="color:#e53e3e;">*</span></label>
                    <div style="position:relative; width:100%;">
                      <input type="password" id="confirm_password" name="confirm_password" placeholder="Ulangi password baru" required minlength="6" style="width:100%; padding-right:44px; box-sizing:border-box;"/>
                      <button type="button" onclick="togglePwVis('confirm_password')" style="position:absolute; right:12px; top:50%; transform:translateY(-50%); background:none; border:none; cursor:pointer; padding:4px; color:#666; display:flex; align-items:center; justify-content:center;" title="Tampilkan/Sembunyikan Password">
                        <svg class="eye-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
                      </button>
                    </div>
                    <small id="pw-match-msg" style="display:none; font-size:11px; margin-top:4px;"></small>
                  </div>
                </div>
                <div class="form-actions-row" style="margin-top:20px;">
                  <a href="/alumni/dashboard" class="btn btn-secondary-outline">Kembali</a>
                  <button type="submit" class="btn btn-primary-green">🔐 Simpan Password Baru</button>
                </div>
              </form>
            </div>
          </div>
        </div>

        <!-- RIGHT: WIDGET PANELS -->
        <div class="profile-widgets-area">
          
          <!-- TIPS CARD -->
          <div class="card widget-card tips-card">
            <div class="widget-header">
              <span class="widget-icon">🔐</span>
              <h4>Tips Keamanan</h4>
            </div>
            <ul class="tips-list">
              <li>
                <strong>Password Kuat:</strong> Gunakan kombinasi huruf besar, huruf kecil, angka, dan simbol untuk keamanan maksimal.
              </li>
              <li>
                <strong>Jangan Berbagi:</strong> Jangan bagikan password Anda kepada siapapun termasuk pihak kampus.
              </li>
              <li>
                <strong>Rutin Ganti:</strong> Ganti password secara berkala untuk menjaga keamanan akun Anda.
              </li>
            </ul>
          </div>

          <!-- BANNER HERO WIDGET -->
          <div class="widget-banner-card">
            <div class="banner-gradient-overlay"></div>
            <div class="banner-content">
              <h3>Bersatu Membangun Bangsa</h3>
              <p>Alumni Hamzanwadi University</p>
            </div>
          </div>

        </div>

      </div>

    </div>

    <!-- FOOTER -->
    <footer class="main-footer">
      <p>&copy; <%= new Date().getFullYear() %> Information Systems Hamzanwadi University. All Rights Reserved.</p>
    </footer>

  </div>
</div>

<script>
  // Toggle password visibility
  function togglePwVis(fieldId) {
    const input = document.getElementById(fieldId);
    const btn = input.parentElement.querySelector('.eye-icon');
    if (input.type === 'password') {
      input.type = 'text';
      btn.innerHTML = '<path d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z"/>';
    } else {
      input.type = 'password';
      btn.innerHTML = '<path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>';
    }
  }

  // Password match validation
  const newPw = document.getElementById('new_password');
  const confirmPw = document.getElementById('confirm_password');
  const matchMsg = document.getElementById('pw-match-msg');

  function checkPwMatch() {
    if (!confirmPw.value) { matchMsg.style.display = 'none'; return; }
    matchMsg.style.display = 'block';
    if (newPw.value === confirmPw.value) {
      matchMsg.textContent = '✓ Password cocok';
      matchMsg.style.color = '#38a169';
    } else {
      matchMsg.textContent = '✗ Password tidak cocok';
      matchMsg.style.color = '#e53e3e';
    }
  }
  newPw.addEventListener('input', checkPwMatch);
  confirmPw.addEventListener('input', checkPwMatch);

  document.getElementById('changePasswordForm').addEventListener('submit', function(e) {
    if (newPw.value !== confirmPw.value) {
      e.preventDefault();
      alert('Password baru dan konfirmasi password tidak cocok!');
      confirmPw.focus();
    }
  });

  // Auto dismiss flash alerts
  setTimeout(() => {
    document.querySelectorAll('.alert').forEach(el => {
      el.style.opacity = '0';
      setTimeout(() => el.remove(), 500);
    });
  }, 4000);
</script>
</body>
</html>
