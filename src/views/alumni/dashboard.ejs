<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Dashboard Alumni | Tracer Study Sistem Informasi</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/alumni/dashboard.css"/>
</head>
<body>

<div class="dashboard-container">
  <!-- SIDEBAR PARTIAL -->
  <%- include('../partials/alumni-sidebar') %>

  <!-- MAIN CONTENT -->
  <div class="main-content">
    
    <!-- TOP HEADER -->
    <%- include('../partials/alumni-topbar', { topbarTitle: 'Dashboard Overview', topbarSub: 'Portal Tracer Study Sistem Informasi Universitas Hamzanwadi' }) %>

    <!-- CONTENT BODY -->
    <div class="content-body">
      
      <!-- Flash Alert Messages -->
      <% if (typeof flash_success !== 'undefined' && flash_success) { %>
        <div class="alert alert-success">
          <div class="alert-icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
          </div>
          <div class="alert-content"><%= flash_success %></div>
        </div>
      <% } %>
      <% if (typeof flash_error !== 'undefined' && flash_error) { %>
        <div class="alert alert-error">
          <div class="alert-icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
          </div>
          <div class="alert-content"><%= flash_error %></div>
        </div>
      <% } %>

      <!-- WELCOME HERO BANNER (BEAUTIFIED) -->
      <div class="welcome-hero" style="background: linear-gradient(135deg, #064E3B 0%, #047857 60%, #059669 100%); border-radius: 20px; padding: 32px 36px; color: #ffffff; position: relative; overflow: hidden; box-shadow: 0 10px 30px rgba(6, 78, 59, 0.2); margin-bottom: 24px;">
        <div class="welcome-hero-backdrop" style="position: absolute; top: -50px; right: -50px; width: 260px; height: 260px; background: rgba(255,255,255,0.06); border-radius: 50%; pointer-events: none;"></div>
        <div class="welcome-hero-content" style="position: relative; z-index: 2; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 24px;">
          <div class="welcome-user-meta" style="display: flex; align-items: center; gap: 20px;">
            <div class="user-avatar-ring" style="width: 72px; height: 72px; border-radius: 50%; border: 3px solid #a7f3d0; background: rgba(255,255,255,0.15); display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 6px 16px rgba(0,0,0,0.15);">
              <div class="user-avatar-initials" style="font-size: 28px; font-weight: 800; color: #ffffff; text-transform: uppercase;">
                <%= (alumni && alumni.nama) ? alumni.nama[0].toUpperCase() : 'A' %>
              </div>
            </div>
            <div class="user-text-info">
              <div style="display:flex; align-items:center; gap:8px; margin-bottom:6px;">
                <span class="user-role-badge" style="background: #ecfdf5; color: #047857; font-size: 11px; font-weight: 800; padding: 4px 12px; border-radius: 20px; text-transform: uppercase; letter-spacing: 0.5px;">
                  Alumni Terdaftar
                </span>
                <span style="background: rgba(255,255,255,0.2); color: #ffffff; font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 20px;">
                  Profil <%= profilKelengkapan %>% Lengkap
                </span>
              </div>
              <h1 style="font-size: 1.45rem; font-weight: 800; margin: 0 0 4px 0; color: #ffffff;">Selamat Datang Kembali, <%= alumni ? alumni.nama : 'Alumni' %>!</h1>
              <p style="font-size: 0.85rem; color: #d1fae5; margin: 0; opacity: 0.95;">NIM: <%= alumni ? alumni.nim : '-' %> • Prodi <%= (alumni && alumni.program_studi) ? alumni.program_studi : 'Sistem Informasi' %> (<%= (alumni && (alumni.fakultas)) ? alumni.fakultas : 'Fakultas Teknik' %>)</p>
            </div>
          </div>

          <div class="welcome-hero-actions" style="display: flex; gap: 12px; flex-wrap: wrap;">
            <a href="/alumni/tracer" class="btn-hero-primary" style="display: inline-flex; align-items: center; gap: 8px; background: #ffffff; color: #064E3B; font-weight: 800; font-size: 0.85rem; padding: 12px 22px; border-radius: 12px; text-decoration: none; transition: all 0.25s ease; box-shadow: 0 4px 14px rgba(0,0,0,0.1);">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10H7v-2h10v2zm0-4H7V7h10v2zm0 8H7v-2h10v2z"/></svg>
              <span><%= tracer ? 'Update Data Kuesioner' : 'Isi Kuesioner Tracer' %></span>
            </a>
            <a href="/alumni/profile" class="btn-hero-secondary" style="display: inline-flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.18); color: #ffffff; font-weight: 700; font-size: 0.85rem; padding: 12px 22px; border-radius: 12px; text-decoration: none; border: 1.5px solid rgba(255,255,255,0.4); transition: all 0.25s ease;">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/></svg>
              <span>Lengkapi Profil (<%= profilKelengkapan %>%)</span>
            </a>
          </div>
        </div>
      </div>

      <!-- METRICS GRID (4 CARDS) -->
      <div class="metrics-grid">
        
        <!-- CARD 1: STATUS TRACER STUDY -->
        <div class="metric-card card-emerald">
          <div class="metric-icon-box">
            <svg viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10H7v-2h10v2zm0-4H7V7h10v2z"/></svg>
          </div>
          <div class="metric-details">
            <span class="metric-label">STATUS TRACER</span>
            <div class="metric-value-row">
              <% if (tracer) { %>
                <span class="badge-status-pill success">SUDAH MENGISI</span>
              <% } else { %>
                <span class="badge-status-pill warning">BELUM MENGISI</span>
              <% } %>
            </div>
            <p class="metric-sub"><%= tracer ? 'Tercatat ' + jumlahPengisian + 'x Pengisian Kuesioner' : 'Harap melengkapi kuesioner pelacakan' %></p>
          </div>
        </div>

        <!-- CARD 2: KELENGKAPAN PROFIL -->
        <div class="metric-card card-teal">
          <div class="metric-icon-box">
            <svg viewBox="0 0 24 24"><path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/></svg>
          </div>
          <div class="metric-details">
            <span class="metric-label">KELENGKAPAN PROFIL</span>
            <div class="metric-value-row">
              <strong class="metric-num"><%= profilKelengkapan %>%</strong>
            </div>
            <div class="metric-progress-bar">
              <div class="metric-progress-fill teal" style="width: <%= profilKelengkapan %>%"></div>
            </div>
          </div>
        </div>

        <!-- CARD 3: TANGGAL PENGISIAN TERAKHIR -->
        <div class="metric-card card-indigo">
          <div class="metric-icon-box">
            <svg viewBox="0 0 24 24"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zm0-12H5V6h14v2z"/></svg>
          </div>
          <div class="metric-details">
            <span class="metric-label">PENGISIAN TERAKHIR</span>
            <div class="metric-value-row">
              <strong class="metric-num-sm"><%= tracer ? new Date(tracer.tanggal_isi).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : 'Belum Mengisi' %></strong>
            </div>
            <p class="metric-sub"><%= tracer ? 'Data siap dijadikan laporan akreditasi' : 'Belum ada riwayat kuesioner' %></p>
          </div>
        </div>

        <!-- CARD 4: STATUS PEKERJAAN SAAT INI -->
        <div class="metric-card card-amber">
          <div class="metric-icon-box">
            <svg viewBox="0 0 24 24"><path d="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .9-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.9 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z"/></svg>
          </div>
          <div class="metric-details">
            <span class="metric-label">STATUS KARIR</span>
            <div class="metric-value-row">
              <span class="badge-status-pill amber"><%= tracer ? tracer.status_pekerjaan.toUpperCase().replace('_', ' ') : 'BELUM MENGISI' %></span>
            </div>
            <p class="metric-sub"><%= (tracer && tracer.nama_perusahaan) ? tracer.nama_perusahaan : 'Informasi karir alumni' %></p>
          </div>
        </div>

      </div>

      <!-- MAIN CONTENT SPLIT GRID (LOWONGAN & KONSELING) -->
      <div class="dashboard-split-grid">
        
        <!-- COLUMN 1: REKOMENDASI LOWONGAN KERJA -->
        <div class="panel-card">
          <div class="panel-header">
            <div class="panel-title-wrap">
              <div class="panel-title-icon">
                <svg viewBox="0 0 24 24"><path d="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .9-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.9 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z"/></svg>
              </div>
              <div>
                <h3>Lowongan Kerja Terbaru</h3>
                <p>Peluang karir eksklusif bagi alumni Sistem Informasi</p>
              </div>
            </div>
            <a href="/lowongan" class="btn-link-more">Lihat Semua →</a>
          </div>

          <div class="panel-body">
            <% if (typeof lowongan !== 'undefined' && lowongan && lowongan.length > 0) { %>
              <div class="job-items-list">
                <% lowongan.forEach(function(job) { %>
                  <div class="job-item">
                    <div class="job-company-icon">
                      <%= job.perusahaan ? job.perusahaan.charAt(0).toUpperCase() : 'J' %>
                    </div>
                    <div class="job-info">
                      <h4><%= job.judul %></h4>
                      <div class="job-company-name"><%= job.perusahaan %> • <%= job.lokasi || 'Indonesia' %></div>
                      <div class="job-tags">
                        <span class="job-tag"><%= job.tipe ? job.tipe.replace('_', ' ').toUpperCase() : 'FULL TIME' %></span>
                        <% if (job.gaji) { %>
                          <span class="job-tag salary"><%= job.gaji %></span>
                        <% } %>
                      </div>
                    </div>
                    <a href="/lowongan" class="btn-apply-sm">Lamar</a>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <div class="panel-empty">
                <p>Belum ada lowongan baru saat ini.</p>
              </div>
            <% } %>
          </div>
        </div>

        <!-- COLUMN 2: LAYANAN KONSELING & BIMBINGAN KARIR -->
        <div class="panel-card">
          <div class="panel-header">
            <div class="panel-title-wrap">
              <div class="panel-title-icon konseling-icon">
                <svg viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg>
              </div>
              <div>
                <h3>Konseling &amp; Bimbingan Karir</h3>
                <p>Konsultasi langsung dengan dosen &amp; praktisi industri</p>
              </div>
            </div>
            <a href="/konseling" class="btn-link-more">Lihat Detail →</a>
          </div>

          <div class="panel-body">
            <div class="counseling-promo-box">
              <h4>Butuh Arahan Pengembangan Karir?</h4>
              <p>Tim Konselor Karir Sistem Informasi siap membantu Anda dalam bedah CV, persiapan wawancara kerja, dan pemetaan jalur karir teknologi.</p>
              
              <div class="counseling-features">
                <div class="counsel-feat-item">
                  <svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                  <span>Review CV ATS-Friendly</span>
                </div>
                <div class="counsel-feat-item">
                  <svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                  <span>Simulasi Wawancara Kerja</span>
                </div>
              </div>

              <a href="/konseling/form" class="btn-counsel-action">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
                <span>Ajukan Sesi Konsultasi Now</span>
              </a>
            </div>
          </div>
        </div>

      </div>

    </div>

    <!-- FOOTER -->
    <footer class="main-footer">
      <p>&copy; <%= new Date().getFullYear() %> Information Systems Fakultas Teknik Universitas Hamzanwadi. All Rights Reserved.</p>
    </footer>

  </div>
</div>

<script>
  setTimeout(() => {
    document.querySelectorAll('.alert').forEach(el => {
      el.style.opacity = '0';
      setTimeout(() => el.remove(), 400);
    });
  }, 4000);
</script>
</body>
</html>
