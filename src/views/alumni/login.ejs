<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Login Alumni | Tracer Study</title>
  <link rel="stylesheet" href="/css/admin/login.css"/>
</head>
<body>

<!-- MAIN -->
<main class="main">
  <div class="login-card">

    <!-- LEFT -->
    <div class="left-panel">
      <!-- BRAND LOGO SECTION -->
      <div class="left-logo-row" style="display:flex; align-items:center; gap:14px; margin-bottom: 36px;">
        <div class="logo-box" style="height:44px; width:auto; flex-shrink:0; display:flex; align-items:center; justify-content:center;">
          <img src="/images/logo-ft.png" alt="Logo Universitas Hamzanwadi" style="height:44px; width:auto; object-fit:contain;" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
          <svg viewBox="0 0 24 24" width="24" height="24" fill="#ffffff" style="display:none;"><path d="M12 3L1 9l11 6 9-4.91V17h2V9L12 3z"/></svg>
        </div>
        <div class="logo-text" style="display:flex; flex-direction:column; line-height:1.2;">
          <strong style="font-size:15px; font-weight:850; color:#ffffff; letter-spacing:0.5px; text-transform:uppercase;">TRACER STUDY</strong>
          <span style="font-size:12px; color:rgba(255,255,255,0.88); font-weight:500;">Sistem Informasi</span>
        </div>
      </div>

      <div class="left-content">
        <span class="left-badge-tag">Portal Tracer Study</span>
        <h1>Selamat Datang Kembali</h1>
        <p>Pantau perkembangan karir Anda dan berkontribusi bagi almamater melalui platform Tracer Study Program Studi Sistem Informasi Fakultas Teknik Universitas Hamzanwadi.</p>
        <div class="left-features">
          <div class="left-feature">
            <svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 4l5 2.18V11c0 3.5-2.33 6.79-5 7.93C9.33 17.79 7 14.5 7 11V7.18L12 5z"/></svg>
            <span>Data Keamanan Terjamin</span>
          </div>
          <div class="left-feature">
            <svg viewBox="0 0 24 24"><path d="M16 6l2.29 2.29-4.88 4.88-4-4L2 16.59 3.41 18l6-6 4 4 6.3-6.29L22 12V6z"/></svg>
            <span>Analisis Karir Mendalam</span>
          </div>
        </div>
      </div>
    </div>

    <!-- RIGHT -->
    <div class="right-panel">
      <a href="/" style="display:inline-flex; align-items:center; gap:6px; color:#064E3B; text-decoration:none; font-size:12px; font-weight:600; margin-bottom:16px;">← Kembali ke Beranda</a>
      <h2 class="form-title">Masuk ke Akun Alumni</h2>
      <p class="form-subtitle">Gunakan NIM atau email Anda untuk masuk</p>

      <!-- TABS -->
      <div class="tabs">
        <span class="tab-btn active">Alumni</span>
        <a href="/admin/login" class="tab-btn">Admin</a>
      </div>

      <!-- ERROR -->
      <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert-error">
        <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
        <%= error %>
      </div>
      <% } %>

      <!-- SUCCESS -->
      <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert-success" style="background:#e8f4ec; color:#2d6a4f; padding: 12px; border-radius: 8px; margin-bottom: 16px; font-size:12px; font-weight:600; display:flex; align-items:center; gap:8px;">
        <svg viewBox="0 0 24 24" style="width:18px;height:18px;fill:currentColor;"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
        <%= success %>
      </div>
      <% } %>

      <!-- FORM -->
      <form action="/login" method="POST" class="login-form">

        <div class="form-group">
          <label>NIM atau Email Alumni</label>
          <div class="input-wrap">
            <input
              type="text"
              name="nimOrEmail"
              placeholder="Masukkan NIM atau email Anda"
              required
              value="<%= typeof formData !== 'undefined' ? formData.nimOrEmail || '' : '' %>"
            />
            <svg class="input-icon" viewBox="0 0 24 24">
              <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
            </svg>
          </div>
        </div>

        <div class="form-group">
          <label>Password</label>
          <div class="input-wrap">
            <input
              type="password"
              name="password"
              id="pwd"
              placeholder="••••••••"
              required
            />
            <button type="button" class="eye-btn" id="eye-toggle" onclick="togglePwd()">
              <svg id="eye-icon" viewBox="0 0 24 24">
                <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
              </svg>
            </button>
          </div>
        </div>

        <div class="form-row-between">
          <label class="checkbox-wrap">
            <input type="checkbox" name="ingat"/>
            Ingat saya
          </label>
          <a href="#" onclick="openForgotModal(event)" class="link-forgot">Lupa Password?</a>
        </div>

        <button type="submit" class="btn-submit">Masuk Sebagai Alumni</button>

        <p class="form-help">
          Belum terdaftar? <a href="https://wa.me/<%= typeof whatsappAdmin !== 'undefined' ? whatsappAdmin : '6282340000000' %>?text=Halo%20Admin%20Tracer%20Study%20Sistem%20Informasi%20Fakultas%20Teknik%20Universitas%20Hamzanwadi,%20saya%20alumni%20ingin%20meminta%20bantuan/akses%20login." target="_blank" rel="noopener noreferrer" class="link-support">Hubungi Administrator</a>
        </p>

      </form>
    </div>

  </div>
</main>

<!-- FOOTER -->
<footer class="footer">
  <div class="footer-bottom">
    &copy; 2026 Information Systems Fakultas Teknik Universitas Hamzanwadi. All Rights Reserved.
  </div>
</footer>

<!-- MODAL LUPA PASSWORD -->
<div class="forgot-modal-overlay" id="forgotPwdModal">
  <div class="forgot-modal-box">
    <div class="forgot-modal-header">
      <div class="forgot-modal-title">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="#064E3B"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zM9 6c0-1.66 1.34-3 3-3s3 1.34 3 3v2H9V6zm9 14H6V10h12v10zm-6-3c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2z"/></svg>
        <h3>Lupa Kata Sandi?</h3>
      </div>
      <button type="button" onclick="closeForgotModal()" class="btn-close-forgot-modal">&times;</button>
    </div>
    <div class="forgot-modal-body">
      <p id="forgotModalDescription"></p>
      <div class="forgot-modal-actions">
        <button type="button" onclick="closeForgotModal()" class="btn-cancel-forgot">Batal</button>
        <a href="#" id="btnForgotWhatsApp" target="_blank" rel="noopener noreferrer" class="btn-whatsapp-forgot">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.003 5.324 5.328 0 11.859 0c3.161.001 6.136 1.233 8.375 3.474 2.24 2.239 3.473 5.215 3.472 8.384-.002 6.537-5.328 11.86-11.859 11.86H11.82c-2.016-.002-3.998-.534-5.748-1.543L0 24zM5.849 18.666c1.662.986 3.292 1.502 4.908 1.503 5.4 0 9.794-4.394 9.796-9.794.001-2.616-1.015-5.074-2.862-6.92C15.845 3.609 13.385 2.593 10.77 2.593c-5.402 0-9.796 4.393-9.798 9.795-.001 1.83.479 3.623 1.391 5.2l-.993 3.626 3.71-.973c1.558.85 3.109 1.425 3.769 1.425zm11.23-5.26c-.301-.15-1.78-.878-2.056-.978-.275-.1-.476-.15-.675.15-.2.299-.775.978-.95 1.178-.175.199-.35.224-.65.075-.3-.15-1.268-.467-2.417-1.493-.893-.797-1.496-1.782-1.671-2.081-.175-.299-.019-.461.13-.61.135-.133.301-.35.452-.524.15-.174.2-.299.3-.499.1-.2.05-.375-.025-.524-.075-.15-.675-1.626-.925-2.227-.243-.585-.49-.506-.675-.515-.175-.008-.375-.01-.575-.01s-.525.075-.8.375c-.275.3-.1.15-1.101.978-1 .828-1.275 2.444-1.275 2.569 0 .125.05.25.1.375 2.5 5.25 6.325 8.125 10.15 9.7 1.25.5 2.25.625 3 .5.75-.125 2.25-.925 2.5-1.78.25-.85.25-1.575.175-1.725-.075-.15-.275-.25-.575-.4z" stroke="none"/></svg>
        <span>Hubungi via WhatsApp</span>
      </a>
    </div>
  </div>
</div>

<script>
function togglePwd() {
  var input = document.getElementById('pwd');
  var icon  = document.getElementById('eye-icon');
  if (input.type === 'password') {
    input.type = 'text';
    icon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0112 20c-5 0-9.27-3.11-11-7.5a10.06 10.06 0 012.06-3.44M9.9 4.24A9.12 9.12 0 0112 4c5 0 9.27 3.11 11 7.5a10.1 10.1 0 01-4.93 5.43M3 3l18 18"/>';
  } else {
    input.type = 'password';
    icon.innerHTML = '<path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>';
  }
}

function openForgotModal(event) {
  event.preventDefault();
  const modal = document.getElementById('forgotPwdModal');
  const desc = document.getElementById('forgotModalDescription');
  const btn = document.getElementById('btnForgotWhatsApp');
  
  desc.textContent = "Silakan hubungi Administrator Tracer Study melalui WhatsApp untuk memverifikasi data diri Anda (NIM, Nama) dan mereset kata sandi akun alumni Anda.";
  
  const waNum = "<%= typeof whatsappAdmin !== 'undefined' ? whatsappAdmin : '6282340000000' %>";
  btn.href = `https://wa.me/${waNum}?text=Halo%20Admin%20Tracer%20Study%20Sistem%20Informasi%20Fakultas%20Teknik%20Universitas%20Hamzanwadi,%20saya%20alumni%20ingin%20meminta%20reset%20password%20akun%20tracer%20study%20saya.`;
  
  modal.style.display = 'flex';
  modal.offsetHeight; // force reflow
  modal.classList.add('show');
}

function closeForgotModal() {
  const modal = document.getElementById('forgotPwdModal');
  modal.classList.remove('show');
  setTimeout(() => {
    modal.style.display = 'none';
  }, 300);
}
</script>

</body>
</html>