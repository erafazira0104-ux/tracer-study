<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Login Alumni | Tracer Study</title>
  <link rel="stylesheet" href="/css/admin/login.css"/>
</head>
<body>

<!-- MAIN -->
<main class="main">
  <div class="login-card">

    <!-- LEFT -->
    <div class="left-panel">
      <!-- BRAND LOGO SECTION -->
      <div class="left-logo-row" style="display:flex; align-items:center; gap:12px; margin-bottom: 40px;">
        <div class="logo-box" style="width:38px; height:38px; background:#fff; border-radius:50%; padding:3px; display:flex; align-items:center; justify-content:center; box-shadow: 0 4px 10px rgba(0,0,0,0.15); flex-shrink: 0;"><img src="/images/LOGO.png" alt="Logo Hamzanwadi" style="width:100%; height:100%; object-fit:contain; border-radius:50%;" /></div>
        <div class="logo-text" style="display:flex; flex-direction:column; line-height:1.25;">
          <strong style="font-size:12px; font-weight:800; color:#fff; letter-spacing:1px; text-transform:uppercase;">TRACER STUDY</strong>
          <span style="font-size:10px; color:rgba(255,255,255,0.7); font-weight:500;">Sistem Informasi • FT UNHAM</span>
        </div>
      </div>

      <div class="left-content">
        <span class="left-badge-tag">Portal Tracer Study</span>
        <h1>Selamat Datang Kembali</h1>
        <p>Pantau perkembangan karir Anda dan berkontribusi bagi almamater melalui platform Tracer Study Program Studi Sistem Informasi Fakultas Teknik.</p>
        <div class="left-features">
          <div class="left-feature">
            <svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 4l5 2.18V11c0 3.5-2.33 6.79-5 7.93C9.33 17.79 7 14.5 7 11V7.18L12 5z"/></svg>
            <span>Data Keamanan Terjamin</span>
          </div>
          <div class="left-feature">
            <svg viewBox="0 0 24 24"><path d="M16 6l2.29 2.29-4.88 4.88-4-4L2 16.59 3.41 18l6-6 4 4 6.3-6.29L22 12V6z"/></svg>
            <span>Analisis Karir Mendalam</span>
          </div>
        </div>
      </div>
    </div>

    <!-- RIGHT -->
    <div class="right-panel">
      <a href="/" style="display:inline-flex; align-items:center; gap:6px; color:#064E3B; text-decoration:none; font-size:12px; font-weight:600; margin-bottom:16px;">← Kembali ke Beranda</a>
      <h2 class="form-title">Masuk ke Akun</h2>
      <p class="form-subtitle">Gunakan NIM atau email Anda untuk masuk</p>

      <!-- TABS -->
      <div class="tabs">
        <span class="tab-btn active">Alumni</span>
        <a href="/admin/login" class="tab-btn">Admin</a>
      </div>

      <!-- ERROR -->
      <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert-error">
        <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
        <%= error %>
      </div>
      <% } %>

      <!-- SUCCESS -->
      <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert-success" style="background:#e8f4ec; color:#2d6a4f; padding: 12px; border-radius: 8px; margin-bottom: 16px; font-size:12px; font-weight:600; display:flex; align-items:center; gap:8px;">
        <svg viewBox="0 0 24 24" style="width:18px;height:18px;fill:currentColor;"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
        <%= success %>
      </div>
      <% } %>

      <!-- FORM -->
      <form action="/login" method="POST" class="login-form">

        <div class="form-group">
          <label>NIM atau Email Alumni</label>
          <div class="input-wrap">
            <input
              type="text"
              name="nimOrEmail"
              placeholder="Masukkan NIM atau email Anda"
              required
              value="<%= typeof formData !== 'undefined' ? formData.nimOrEmail || '' : '' %>"
            />
            <svg class="input-icon" viewBox="0 0 24 24">
              <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
            </svg>
          </div>
        </div>

        <div class="form-group">
          <label>Password</label>
          <div class="input-wrap">
            <input
              type="password"
              name="password"
              id="pwd"
              placeholder="••••••••"
              required
            />
            <button type="button" class="eye-btn" id="eye-toggle" onclick="togglePwd()">
              <svg id="eye-icon" viewBox="0 0 24 24">
                <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
              </svg>
            </button>
          </div>
        </div>

        <div class="form-row-between">
          <label class="checkbox-wrap">
            <input type="checkbox" name="ingat"/>
            Ingat saya
          </label>
          <a href="#" class="link-forgot">Lupa Password?</a>
        </div>

        <button type="submit" class="btn-submit">Masuk Sebagai Alumni</button>

        <p class="form-help">
          Belum terdaftar? <a href="https://wa.me/6281234567890?text=Halo%20Admin%20Tracer%20Study%20Sistem%20Informasi%20Universitas%20Hamzanwadi,%20saya%20alumni%20ingin%20meminta%20bantuan/akses%20login." target="_blank" rel="noopener noreferrer" class="link-support">Hubungi Administrator</a>
        </p>

      </form>
    </div>

  </div>
</main>

<!-- FOOTER -->
<footer class="footer">
  <div class="footer-bottom">
    &copy; 2026 Information Systems Fakultas Teknik Hamzanwadi University. All Rights Reserved.
  </div>
</footer>

<script>
function togglePwd() {
  var input = document.getElementById('pwd');
  var icon  = document.getElementById('eye-icon');
  if (input.type === 'password') {
    input.type = 'text';
    icon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0112 20c-5 0-9.27-3.11-11-7.5a10.06 10.06 0 012.06-3.44M9.9 4.24A9.12 9.12 0 0112 4c5 0 9.27 3.11 11 7.5a10.1 10.1 0 01-4.93 5.43M3 3l18 18"/>';
  } else {
    input.type = 'password';
    icon.innerHTML = '<path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>';
  }
}
</script>

</body>
</html>