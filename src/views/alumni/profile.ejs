<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Lengkapi Profil | Alumni Tracer Study</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
  <!-- Reuse dashboard styles for layout & sidebar, import profile.css for page specific styles -->
  <link rel="stylesheet" href="/css/alumni/dashboard.css"/>
  <link rel="stylesheet" href="/css/alumni/profile.css"/>
  <style>
    /* Custom Styling Overrides for Profile Page */
    .profile-form-area .form-card {
      border-radius: 20px;
      border: 1px solid #e2e8f0;
      box-shadow: 0 8px 24px rgba(0,0,0,0.03);
      overflow: hidden;
      margin-bottom: 24px;
    }
    .profile-form-area .form-card-header {
      background: #ffffff;
      padding: 20px 24px;
      border-bottom: 1px solid #f1f5f9;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .profile-form-area .form-card-header h3 {
      font-size: 1.1rem;
      font-weight: 800;
      color: #064e3b;
      margin: 0;
    }
    .profile-form-area .form-card-body {
      padding: 24px;
    }
    .profile-form-area label {
      font-weight: 700;
      font-size: 0.88rem;
      color: #1e293b;
      display: block;
      margin-bottom: 8px;
    }
    .profile-form-area input[type="text"],
    .profile-form-area input[type="email"],
    .profile-form-area input[type="number"],
    .profile-form-area input[type="date"],
    .profile-form-area select,
    .profile-form-area textarea {
      width: 100%;
      padding: 12px 16px;
      border: 1.5px solid #cbd5e1;
      border-radius: 12px;
      font-size: 0.92rem;
      font-family: inherit;
      color: #0f172a;
      background-color: #f8fafc;
      transition: all 0.25s ease;
      box-sizing: border-box;
    }
    .profile-form-area input:focus,
    .profile-form-area select:focus,
    .profile-form-area textarea:focus {
      background-color: #ffffff;
      border-color: #059669;
      box-shadow: 0 0 0 4px rgba(5, 150, 105, 0.12);
      outline: none;
    }
    .profile-form-area input.readonly-input {
      background-color: #f1f5f9;
      color: #64748b;
      border-color: #e2e8f0;
      cursor: not-allowed;
    }
    
    .btn-save-draft {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #ffffff;
      color: #475569;
      border: 1.5px solid #cbd5e1;
      font-weight: 700;
      font-size: 0.88rem;
      padding: 12px 22px;
      border-radius: 12px;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .btn-save-draft:hover {
      background: #f8fafc;
      color: #0f172a;
      border-color: #94a3b8;
    }

    .btn-save-continue {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: linear-gradient(135deg, #064e3b 0%, #047857 100%);
      color: #ffffff;
      font-weight: 700;
      font-size: 0.9rem;
      padding: 12px 26px;
      border-radius: 12px;
      border: none;
      cursor: pointer;
      transition: all 0.25s ease;
      box-shadow: 0 4px 14px rgba(6, 78, 59, 0.2);
    }
    .btn-save-continue:hover {
      background: linear-gradient(135deg, #043e2f 0%, #064e3b 100%);
      box-shadow: 0 8px 20px rgba(6, 78, 59, 0.35);
      transform: translateY(-1px);
    }
  </style>
</head>
<body>

<div class="dashboard-container">
  <!-- SIDEBAR PARTIAL -->
  <%- include('../partials/alumni-sidebar') %>

  <!-- MAIN CONTENT -->
  <div class="main-content">
    
    <!-- TOP HEADER -->
    <%- include('../partials/alumni-topbar', { topbarTitle: 'Lengkapi Profil Alumni', topbarSub: 'Sistem Informasi Universitas Hamzanwadi' }) %>

    <!-- CONTENT WRAPPER -->
    <div class="content-body">
      
      <!-- BREADCRUMBS -->
      <div class="breadcrumbs">
        <a href="/alumni/dashboard">Beranda</a>
        <span>/</span>
        <span class="active">Lengkapi Profil</span>
      </div>

      <!-- HERO BANNER -->
      <div class="welcome-hero" style="background: linear-gradient(135deg, #064E3B 0%, #047857 60%, #059669 100%); border-radius: 20px; padding: 28px 32px; color: #ffffff; position: relative; overflow: hidden; box-shadow: 0 10px 30px rgba(6, 78, 59, 0.18); margin-bottom: 24px;">
        <div style="position: absolute; top: -40px; right: -40px; width: 220px; height: 220px; background: rgba(255,255,255,0.06); border-radius: 50%; pointer-events: none;"></div>
        <div style="position: relative; z-index: 2; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px;">
          <div style="display: flex; align-items: center; gap: 18px;">
            <div style="width: 60px; height: 60px; border-radius: 50%; border: 2.5px solid #a7f3d0; background: rgba(255,255,255,0.15); display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 26px;">
              👤
            </div>
            <div>
              <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px;">
                <span style="background: #ecfdf5; color: #047857; font-size: 10px; font-weight: 800; padding: 3px 10px; border-radius: 20px; text-transform: uppercase;">
                  Tahap 1: Sinkronisasi Identitas
                </span>
              </div>
              <h2 style="font-size: 1.4rem; font-weight: 800; margin: 0 0 4px 0; color: #ffffff;">Lengkapi Profil Alumni</h2>
              <p style="font-size: 0.88rem; color: #d1fae5; margin: 0; opacity: 0.95;">Perbarui data identitas pribadi dan riwayat akademik Anda untuk validasi data Tracer Study.</p>
            </div>
          </div>
          <div style="background: rgba(255,255,255,0.15); backdrop-filter: blur(4px); border: 1px solid rgba(255,255,255,0.25); padding: 10px 18px; border-radius: 14px; text-align: center;">
            <span style="font-size: 11px; font-weight: 700; color: #d1fae5; display: block; margin-bottom: 2px;">Kelengkapan Profil</span>
            <strong style="font-size: 1.25rem; font-weight: 800; color: #ffffff;"><%= profilKelengkapan %>%</strong>
          </div>
        </div>
      </div>

      <!-- PROGRESS TRACKER -->
      <div class="progress-tracker" style="border-radius: 18px; padding: 20px 28px; margin-bottom: 24px; border: 1px solid #e2e8f0;">
        <div class="tracker-step active">
          <div class="step-num-box">
            <svg viewBox="0 0 24 24" class="step-icon"><path fill="currentColor" d="M12 6c1.1 0 2 .9 2 2s-.9 2-2 2-2-.9-2-2 .9-2 2-2m0 10c2.7 0 5.8 1.29 6 2H6c.23-.72 3.3-2 6-2m0-12C9.79 4 8 5.79 8 8s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm0 10c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
          </div>
          <span>Lengkapi Profil</span>
        </div>
        <div class="tracker-line <%= isTracerFilled ? 'filled' : '' %>"></div>
        <div class="tracker-step <%= isTracerFilled ? 'done' : 'active-pending' %>">
          <div class="step-num-box">
            <svg viewBox="0 0 24 24" class="step-icon"><path fill="currentColor" d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10H7v-2h10v2zm0-4H7V7h10v2zm0 8H7v-2h10v2z"/></svg>
          </div>
          <span>Isi Kuesioner</span>
        </div>
        <div class="tracker-line <%= isTracerFilled ? 'filled' : '' %>"></div>
        <div class="tracker-step <%= isTracerFilled ? 'done' : 'todo' %>">
          <div class="step-num-box">
            <svg viewBox="0 0 24 24" class="step-icon"><path fill="currentColor" d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
          </div>
          <span>Selesai</span>
        </div>
      </div>

      <!-- Flash Alert -->
      <% if (success) { %>
        <div class="alert alert-success" style="border-radius:14px; margin-bottom:20px;">
          <div class="alert-icon">✓</div>
          <div class="alert-content"><%= success %></div>
        </div>
      <% } %>
      <% if (error) { %>
        <div class="alert alert-error" style="border-radius:14px; margin-bottom:20px;">
          <div class="alert-icon">⚠️</div>
          <div class="alert-content"><%= error %></div>
        </div>
      <% } %>

      <!-- Profile Completeness Warning -->
      <% if (typeof missingFields !== 'undefined' && missingFields.length > 0) { %>
        <div style="background: linear-gradient(135deg, #fffbeb, #fef3c7); border: 1.5px solid #fde68a; border-radius: 18px; padding: 20px 24px; margin-bottom: 24px; box-shadow: 0 4px 14px rgba(245, 158, 11, 0.08);">
          <div style="display:flex; align-items:center; gap:10px; margin-bottom:10px;">
            <span style="font-size:20px;">⚠️</span>
            <h4 style="margin:0; font-size:0.95rem; font-weight:800; color:#92400e;">Profil Belum Lengkap — Anda belum dapat mengisi Kuesioner Tracer Study</h4>
          </div>
          <p style="font-size:0.84rem; color:#78350f; margin:0 0 12px; line-height:1.5;">Harap isi field data berikut agar dapat melanjutkan ke pengisian kuesioner tracer study:</p>
          <div style="display:flex; flex-wrap:wrap; gap:6px; margin-bottom:14px;">
            <% missingFields.forEach(function(f) { %>
              <span style="background:#fef08a; color:#854d0e; font-size:0.75rem; font-weight:700; padding:4px 12px; border-radius:8px; border:1px solid #fde047;"><%= f.label %></span>
            <% }); %>
          </div>
          <div style="display:flex; align-items:center; gap:12px;">
            <div style="flex:1; height:8px; background:#fef08a; border-radius:10px; overflow:hidden;">
              <div style="height:100%; width:<%= profilKelengkapan %>%; background: linear-gradient(90deg, #f59e0b, #10b981); border-radius:10px; transition: width 0.8s ease;"></div>
            </div>
            <span style="font-size:0.8rem; font-weight:800; color:#92400e;"><%= profilKelengkapan %>% Lengkap</span>
          </div>
        </div>
      <% } %>

      <!-- FORM GRID -->
      <div class="profile-grid">
        
        <!-- LEFT: FORM DATA -->
        <div class="profile-form-area">
          <form action="/alumni/profile" method="POST" id="profileForm">
            <input type="hidden" name="redirect_to_tracer" id="redirectToTracer" value="false"/>

            <!-- SECTION 1: DATA PRIBADI -->
            <div class="form-card">
              <div class="form-card-header">
                <span style="background: #ecfdf5; color: #047857; padding: 8px; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/></svg>
                </span>
                <h3>Data Identitas Pribadi</h3>
              </div>
              <div class="form-card-body">
                <div class="form-row" style="margin-bottom: 20px;">
                  <div class="form-group" style="width:100%;">
                    <label for="nama">Nama Lengkap <span style="color:#ef4444;">*</span></label>
                    <input type="text" id="nama" name="nama" value="<%= alumni.nama %>" placeholder="Masukkan nama lengkap sesuai ijazah" required/>
                  </div>
                </div>

                <div class="form-row two-cols" style="margin-bottom: 20px;">
                  <div class="form-group">
                    <label for="jenis_kelamin">Jenis Kelamin</label>
                    <select id="jenis_kelamin" name="jenis_kelamin">
                      <option value="">Pilih Jenis Kelamin</option>
                      <option value="L" <%= alumni.jenis_kelamin === 'L' ? 'selected' : '' %>>Laki-laki</option>
                      <option value="P" <%= alumni.jenis_kelamin === 'P' ? 'selected' : '' %>>Perempuan</option>
                    </select>
                  </div>
                  <div class="form-group">
                    <label for="no_hp">Nomor HP / WhatsApp <span style="color:#ef4444;">*</span></label>
                    <input type="text" id="no_hp" name="no_hp" value="<%= alumni.no_hp || '' %>" placeholder="0812xxxx" required/>
                  </div>
                </div>

                <div class="form-row two-cols" style="margin-bottom: 20px;">
                  <div class="form-group">
                    <label for="tempat_lahir">Tempat Lahir</label>
                    <input type="text" id="tempat_lahir" name="tempat_lahir" value="<%= alumni.tempat_lahir || '' %>" placeholder="Kota Kelahiran"/>
                  </div>
                  <div class="form-group">
                    <label for="tanggal_lahir">Tanggal Lahir</label>
                    <% 
                      let dobStr = '';
                      if (alumni.tanggal_lahir) {
                        const d = new Date(alumni.tanggal_lahir);
                        const year = d.getFullYear();
                        const month = String(d.getMonth() + 1).padStart(2, '0');
                        const day = String(d.getDate()).padStart(2, '0');
                        dobStr = `${year}-${month}-${day}`;
                      }
                    %>
                    <input type="date" id="tanggal_lahir" name="tanggal_lahir" value="<%= dobStr %>"/>
                  </div>
                </div>

                <div class="form-row" style="margin-bottom: 20px;">
                  <div class="form-group" style="width:100%;">
                    <label for="email">Email Terdaftar <span style="color:#ef4444;">*</span></label>
                    <input type="email" id="email" name="email" value="<%= alumni.email %>" placeholder="alumni@email.com" required/>
                  </div>
                </div>

                <div class="form-row">
                  <div class="form-group" style="width:100%;">
                    <label for="alamat">Alamat Domisili Lengkap</label>
                    <textarea id="alamat" name="alamat" rows="3" placeholder="Alamat lengkap domisili tempat tinggal saat ini"><%= alumni.alamat || '' %></textarea>
                  </div>
                </div>
              </div>
            </div>

            <!-- SECTION 2: DATA AKADEMIK -->
            <div class="form-card">
              <div class="form-card-header">
                <span style="background: #ecfdf5; color: #047857; padding: 8px; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82zM12 3L1 9l11 6 9-4.91V17h2V9L12 3z"/></svg>
                </span>
                <h3>Data Akademik & Kelulusan</h3>
              </div>
              <div class="form-card-body">
                <div class="form-row two-cols" style="margin-bottom: 20px;">
                  <div class="form-group">
                    <label for="nim">NIM (Nomor Induk Mahasiswa)</label>
                    <input type="text" id="nim" name="nim" value="<%= alumni.nim %>" readonly class="readonly-input" title="NIM dikunci oleh sistem"/>
                  </div>
                  <div class="form-group">
                    <label for="ipk_terakhir">IPK Kelulusan</label>
                    <input type="number" step="0.01" min="0" max="4" id="ipk_terakhir" name="ipk_terakhir" value="<%= alumni.ipk_terakhir || '' %>" placeholder="Contoh: 3.75"/>
                  </div>
                </div>

                <div class="form-row two-cols" style="margin-bottom: 20px;">
                  <div class="form-group">
                    <label for="fakultas">Fakultas</label>
                    <select id="fakultas" name="fakultas">
                      <option value="">Pilih Fakultas</option>
                      <option value="Fakultas Teknik" <%= alumni.fakultas === 'Fakultas Teknik' ? 'selected' : '' %>>Fakultas Teknik</option>
                      <option value="Fakultas Kesehatan" <%= alumni.fakultas === 'Fakultas Kesehatan' ? 'selected' : '' %>>Fakultas Kesehatan</option>
                      <option value="Fakultas Keguruan" <%= alumni.fakultas === 'Fakultas Keguruan' ? 'selected' : '' %>>Fakultas Keguruan dan Ilmu Pendidikan</option>
                      <option value="Fakultas Ilmu Sosial" <%= alumni.fakultas === 'Fakultas Ilmu Sosial' ? 'selected' : '' %>>Fakultas Ilmu Sosial dan Ekonomi</option>
                    </select>
                  </div>
                  <div class="form-group">
                    <label for="program_studi">Program Studi <span style="color:#ef4444;">*</span></label>
                    <select id="program_studi" name="program_studi" required>
                      <option value="">Pilih Program Studi</option>
                      <option value="Sistem Informasi" <%= alumni.program_studi === 'Sistem Informasi' ? 'selected' : '' %>>Sistem Informasi</option>
                      <option value="Teknik Informatika" <%= alumni.program_studi === 'Teknik Informatika' ? 'selected' : '' %>>Teknik Informatika</option>
                      <option value="Pendidikan Teknologi Informasi" <%= alumni.program_studi === 'Pendidikan Teknologi Informasi' ? 'selected' : '' %>>Pendidikan Teknologi Informasi</option>
                    </select>
                  </div>
                </div>
              </div>
            </div>

            <!-- ACTION BUTTONS -->
            <div style="display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: 28px; padding-top: 20px; border-top: 1px solid #e2e8f0; flex-wrap: wrap;">
              <button type="submit" class="btn-save-draft" onclick="setRedirect(false)">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z"/></svg>
                <span>Simpan Draft</span>
              </button>
              <button type="submit" class="btn-save-continue" onclick="setRedirect(true)">
                <span>Simpan &amp; Lanjutkan Pengisian</span>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
              </button>
            </div>

          </form>

        </div>

        <!-- RIGHT: WIDGET PANELS -->
        <div class="profile-widgets-area">
          
          <!-- TIPS CARD -->
          <div class="card widget-card tips-card" style="border-radius: 20px; border: 1px solid #e2e8f0; box-shadow: 0 8px 24px rgba(0,0,0,0.03);">
            <div class="widget-header" style="display:flex; align-items:center; gap:8px; margin-bottom:16px;">
              <span style="font-size: 20px;">💡</span>
              <h4 style="font-size: 1rem; font-weight: 800; color: #064e3b; margin:0;">Tips Mengisi Data</h4>
            </div>
            <ul class="tips-list" style="display:flex; flex-direction:column; gap:12px; padding:0; margin:0; list-style:none;">
              <li style="display:flex; align-items:flex-start; gap:10px; font-size:0.84rem; color:#475569; line-height:1.5;">
                <span style="color:#059669; font-weight:800;">✓</span>
                <span><strong>Kesesuaian Ijazah:</strong> Pastikan Nama Lengkap ditulis sesuai dengan yang tertera di Ijazah resmi Anda.</span>
              </li>
              <li style="display:flex; align-items:flex-start; gap:10px; font-size:0.84rem; color:#475569; line-height:1.5;">
                <span style="color:#059669; font-weight:800;">✓</span>
                <span><strong>WhatsApp Aktif:</strong> Gunakan Nomor HP yang terhubung ke WhatsApp untuk menerima notifikasi info karir alumni.</span>
              </li>
              <li style="display:flex; align-items:flex-start; gap:10px; font-size:0.84rem; color:#475569; line-height:1.5;">
                <span style="color:#059669; font-weight:800;">✓</span>
                <span><strong>Validasi Akademik:</strong> Data akademik akan diverifikasi oleh Admin Tracer Study Fakultas Teknik.</span>
              </li>
            </ul>
          </div>

          <!-- USER META CARD -->
          <div class="card widget-card" style="border-radius: 20px; border: 1px solid #e2e8f0; background: #ffffff; padding: 20px; box-shadow: 0 8px 24px rgba(0,0,0,0.03);">
            <div style="display: flex; align-items: center; gap: 14px;">
              <div style="width: 50px; height: 50px; border-radius: 50%; background: #064e3b; color: #ffffff; font-weight: 800; font-size: 20px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <%= (alumni && alumni.nama) ? alumni.nama[0].toUpperCase() : 'A' %>
              </div>
              <div style="min-width: 0;">
                <h5 style="margin: 0 0 2px; font-size: 0.95rem; font-weight: 800; color: #0f172a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                  <%= alumni ? alumni.nama : 'Alumni' %>
                </h5>
                <p style="margin: 0; font-size: 0.78rem; color: #64748b;">NIM: <%= alumni ? alumni.nim : '-' %></p>
                <span style="display: inline-block; margin-top: 6px; background: #ecfdf5; color: #047857; font-size: 10px; font-weight: 800; padding: 2px 8px; border-radius: 12px; border: 1px solid #a7f3d0;">
                  Profil <%= profilKelengkapan %>% Lengkap
                </span>
              </div>
            </div>
          </div>

        </div>

      </div>

      <!-- BOTTOM FEATURE CARDS & HELP SECTION -->
      <div class="profile-bottom-features" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; margin-top: 24px;">
        
        <!-- CARD 1: STATUS KELENGKAPAN -->
        <div class="feature-card-item" style="background:#ffffff; border:1px solid #e2e8f0; border-radius:18px; padding:22px; box-shadow:0 6px 18px rgba(0,0,0,0.03);">
          <div class="feature-card-header" style="display:flex; align-items:center; gap:12px; margin-bottom:12px;">
            <div style="width:40px; height:40px; border-radius:12px; background:#ecfdf5; color:#047857; display:flex; align-items:center; justify-content:center; font-size:18px; flex-shrink:0;">📊</div>
            <div>
              <h4 style="margin:0; font-size:0.92rem; font-weight:800; color:#0f172a;">Status Data Alumni</h4>
              <span style="font-size:0.75rem; color:#64748b;">Verifikasi Berkelanjutan</span>
            </div>
          </div>
          <p class="feature-card-desc" style="font-size:0.82rem; color:#475569; line-height:1.55; margin-bottom:14px;">
            Data identitas dan akademik Anda digunakan untuk pencatatan rekapitulasi lulusan Program Studi Sistem Informasi FT Universitas Hamzanwadi.
          </p>
          <div class="feature-card-action">
