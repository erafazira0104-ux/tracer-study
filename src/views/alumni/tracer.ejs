        <div id="penilaianLockedBox" style="background: #f8fafc; border: 1.5px dashed #cbd5e1; border-radius: 16px; padding: 32px; text-align: center; margin-bottom: 24px;">
          <div style="font-size: 32px; margin-bottom: 10px;">🔒</div>
          <h4 style="margin: 0 0 6px; font-size: 0.95rem; font-weight: 800; color: #64748b;">Penilaian Program Studi Terkunci</h4>
          <p style="font-size: 0.82rem; color: #94a3b8; margin: 0;">Silakan pilih status karir dan lengkapi pertanyaan terlebih dahulu untuk membuka bagian ini.</p>
        </div>

        <!-- STEP 3: PENILAIAN PROGRAM STUDI (initially hidden) -->
        <div id="penilaianProdiSection" style="display: none;">
        <div class="form-card evaluation-section-card" style="border-radius:20px; overflow:hidden;">
          <div class="form-card-header-banner" style="background: linear-gradient(135deg, #064E3B, #04392b); padding:24px 32px; color:#ffffff;">
            <h3 style="font-size:18px; font-weight:800; margin:0 0 6px 0; color:#ffffff;">⭐ Langkah 2: Penilaian Program Studi</h3>
            <p style="font-size:13px; color:#a7f3d0; margin:0;">Berikan penilaian objektif Anda (skala 1–5) mengenai pengalaman selama menempuh pendidikan untuk evaluasi kurikulum prodi.</p>
          </div>
                      <div class="eval-grid">
              <% penilaianQuestions.forEach((q, idx) => { %>
                <% 
                  const icons = ["📚", "👨‍🏫", "🏫", "🎓", "🚀", "⭐"];
                  const icon = icons[idx % icons.length];
                  const scaleLabelsMap = ["Sangat Kurang", "Kurang", "Cukup", "Baik", "Sangat Baik"];
                  const currentVal = parseInt(q.jawaban) || 0;
                %>
                <% if (q.jenis_jawaban === 'essay') { %>
                  <div class="eval-card-item" style="grid-column: 1 / -1; background: #ffffff; padding: 20px; border-radius: 16px; border: 1.5px solid #e2e8f0;">
                    <div class="eval-header-flex" style="margin-bottom: 10px;">
                      <div class="eval-icon-badge">💬</div>
                      <div class="eval-info">
                        <h4 style="font-size: 14px; font-weight: 700; color: #1e293b; margin: 0 0 4px;"><%= (idx + 1) %>. <%= q.pertanyaan %> <span style="color:#ef4444;">*</span></h4>
                        <p style="font-size: 11px; color: #64748b; margin: 0;">Tuliskan jawaban atau masukan konstruktif Anda secara jelas.</p>
                      </div>
                    </div>
                    <textarea name="pertanyaan_<%= q.id %>" id="pertanyaan_<%= q.id %>" rows="3" placeholder="Tuliskan jawaban Anda di sini..." style="width:100%; border:1.5px solid #cbd5e1; border-radius:10px; padding:12px; font-family:inherit; font-size:13px; outline:none; box-sizing:border-box; transition:all 0.2s ease;"><%= q.jawaban || '' %></textarea>
                  </div>
                <% } else { %>
                  <div class="eval-card-item">
                    <div class="eval-header-flex">
                      <div class="eval-icon-badge"><%= icon %></div>
                      <div class="eval-info">
                        <h4><%= (idx + 1) %>. <%= q.pertanyaan %> <span style="color:#ef4444;">*</span></h4>
                        <p>Berikan rating bintang (1 s/d 5 bintang) sesuai pengalaman Anda.</p>
                      </div>
                    </div>
                    
                    <div class="star-rating-wrapper" data-q-id="<%= q.id %>">
                      <div class="star-rating-stars">
                        <% [1, 2, 3, 4, 5].forEach(num => { 
                             const isChecked = currentVal === num;
                        %>
                          <label class="star-rating-label <%= isChecked ? 'checked-star' : '' %>" data-val="<%= num %>" title="⭐ <%= num %>/5 - <%= scaleLabelsMap[num - 1] %>">
                            <input type="radio" name="pertanyaan_<%= q.id %>" value="<%= num %>" <%= isChecked ? 'checked' : '' %> onchange="updateStarRating(this)"/>
                            <svg class="star-icon" viewBox="0 0 24 24" width="30" height="30">
                              <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                            </svg>
                          </label>
                        <% }) %>
                      </div>
                      <div class="star-rating-text" id="star-text-<%= q.id %>">
                        <% if (currentVal > 0) { %>
                          ⭐ <%= currentVal %>/5 — <strong><%= scaleLabelsMap[currentVal - 1] %></strong>
                        <% } else { %>
                          Klik bintang untuk menilai
                        <% } %>
                      </div>
                    </div>
                  </div>
                <% } %>
              <% }) %>
            </div>
          </div>
        </div> <!-- end penilaianProdiSection -->

        <!-- Legacy fields hidden or loaded dynamically -->
        <input type="hidden" name="kompetensi_relevan" value="relevan"/>
        <input type="hidden" name="kepuasan_layanan" value="4"/>

        <div class="form-row" style="margin-top: 2rem;">
          <div class="form-group" style="width: 100%;">
            <label for="saran">Saran dan Masukan</label>
            <textarea name="saran" id="saran" rows="5" placeholder="Tuliskan saran konstruktif Anda untuk kemajuan program studi..." style="width:100%; box-sizing:border-box;"><%= tracer ? tracer.saran || '' : '' %></textarea>
          </div>
        </div>

        <div class="eval-disclaimer-alert">
          <span class="info-icon-circ">i</span>
          <p>Data ini digunakan secara anonim untuk keperluan akreditasi program studi dan peningkatan mutu pendidikan. Terima kasih atas partisipasi aktif Anda.</p>
        </div>

        <!-- HELP BANNER BOTTOM -->
        <div class="form-bottom-help-banner">
          <div class="help-banner-icon">❓</div>
          <div class="help-banner-text">
            <h5>Bingung Memilih Status?</h5>
            <p>Hubungi pusat bantuan Tracer Study untuk konsultasi terkait pengisian kuesioner.</p>
          </div>
          <a href="#" class="btn btn-outline-dark-green">Tanya Admin</a>
        </div>

        <!-- FORM ACTION BUTTONS -->
        <div class="form-actions-row">
          <a href="/alumni/dashboard" class="btn btn-outline-back">← Kembali ke Dashboard</a>
          <% if (canSubmit) { %>
            <button type="submit" class="btn btn-submit-tracer">
              <svg viewBox="0 0 24 24" class="save-icon"><path fill="currentColor" d="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z"/></svg>
              <span><%= tracer ? 'Perbarui Data Kuesioner' : 'Kirim Kuesioner Tracer' %></span>
            </button>
          <% } else { %>
            <button type="button" class="btn btn-submit-tracer" style="background:#94a3b8; border-color:#94a3b8; cursor:not-allowed;" disabled>
              <svg viewBox="0 0 24 24" class="save-icon"><path fill="currentColor" d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
              <span>Pengisian Ditutup</span>
            </button>
          <% } %>
        </div>

      </form>
      <% } %>

    </div>

    <!-- FOOTER -->
    <footer class="main-footer">
      <p>&copy; <%= new Date().getFullYear() %> Information Systems Fakultas Teknik Universitas Hamzanwadi. All Rights Reserved.</p>
    </footer>

  </div>
</div>

<!-- CUSTOM MODAL POPUPS (REPLACING BROWSER DEFAULT DIALOGS) -->
<div id="customConfirmModal" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(8px); display: none; align-items: center; justify-content: center; z-index: 10000; padding: 20px;">
  <div style="background: #ffffff; border-radius: 24px; padding: 32px 28px; max-width: 440px; width: 100%; text-align: center; border: 1.5px solid #e2e8f0; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);">
    <div style="width: 68px; height: 68px; border-radius: 50%; background: #ecfdf5; border: 2.5px solid #a7f3d0; color: #047857; font-size: 32px; display: flex; align-items: center; justify-content: center; margin: 0 auto 18px; box-shadow: 0 8px 20px rgba(5, 150, 105, 0.15);">
      🚀
    </div>
    <h3 style="font-size: 1.25rem; font-weight: 800; color: #064E3B; margin: 0 0 8px 0; letter-spacing: -0.3px;">Konfirmasi Kirim Kuesioner</h3>
    <p style="font-size: 0.88rem; color: #475569; line-height: 1.55; margin: 0 0 24px 0;" id="customConfirmMessage">
      Apakah Anda yakin seluruh data kuesioner tracer study sudah terisi dengan benar? Data yang dikirim akan disimpan sebagai rekaman resmi alumni.
    </p>
    <div style="display: flex; gap: 12px; justify-content: center;">
      <button type="button" id="btnCancelCustomConfirm" style="flex: 1; padding: 12px 18px; background: #ffffff; color: #475569; border: 1.5px solid #cbd5e1; border-radius: 12px; font-weight: 700; font-size: 0.88rem; cursor: pointer; transition: all 0.2s ease;">
        Batal
      </button>
      <button type="button" id="btnOkCustomConfirm" style="flex: 1.2; padding: 12px 20px; background: linear-gradient(135deg, #064E3B 0%, #047857 100%); color: #ffffff; border: none; border-radius: 12px; font-weight: 800; font-size: 0.88rem; cursor: pointer; transition: all 0.25s ease; box-shadow: 0 4px 14px rgba(6, 78, 59, 0.25);">
        Ya, Kirim Sekarang
      </button>
    </div>
  </div>
</div>

<div id="customAlertModal" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(8px); display: none; align-items: center; justify-content: center; z-index: 10000; padding: 20px;">
  <div style="background: #ffffff; border-radius: 24px; padding: 32px 28px; max-width: 440px; width: 100%; text-align: center; border: 1.5px solid #e2e8f0; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);">
    <div style="width: 68px; height: 68px; border-radius: 50%; background: #fffbeb; border: 2.5px solid #fde68a; color: #d97706; font-size: 32px; display: flex; align-items: center; justify-content: center; margin: 0 auto 18px; box-shadow: 0 8px 20px rgba(217, 119, 6, 0.15);">
      ⚠️
    </div>
    <h3 style="font-size: 1.25rem; font-weight: 800; color: #b45309; margin: 0 0 8px 0; letter-spacing: -0.3px;">Perhatian</h3>
    <p style="font-size: 0.88rem; color: #475569; line-height: 1.55; margin: 0 0 24px 0;" id="customAlertMessage">
      Harap lengkapi seluruh pertanyaan wajib terlebih dahulu.
    </p>
    <button type="button" onclick="closeCustomAlert()" style="width: 100%; padding: 12px 20px; background: linear-gradient(135deg, #064E3B 0%, #047857 100%); color: #ffffff; border: none; border-radius: 12px; font-weight: 800; font-size: 0.88rem; cursor: pointer; transition: all 0.25s ease; box-shadow: 0 4px 14px rgba(6, 78, 59, 0.25);">
      Mengerti
    </button>
  </div>
</div>

<script>
  function showCustomAlert(msg) {
    document.getElementById('customAlertMessage').textContent = msg;
    document.getElementById('customAlertModal').style.display = 'flex';
  }

  function closeCustomAlert() {
    document.getElementById('customAlertModal').style.display = 'none';
  }

  function showCustomConfirm(msg, onConfirm) {
    document.getElementById('customConfirmMessage').textContent = msg;
    const confirmModal = document.getElementById('customConfirmModal');
    const okBtn = document.getElementById('btnOkCustomConfirm');
    const cancelBtn = document.getElementById('btnCancelCustomConfirm');

    confirmModal.style.display = 'flex';

    okBtn.onclick = function() {
      confirmModal.style.display = 'none';
      onConfirm();
    };
    cancelBtn.onclick = function() {
      confirmModal.style.display = 'none';
    };
  }

  function openModal(modalId) {
    document.getElementById(modalId).style.display = 'flex';
  }
  
  function closeModal(modalId) {
    document.getElementById(modalId).style.display = 'none';
  }

  function validateModalQuestions(modalId) {
    const modalEl = document.getElementById(modalId);
    if (!modalEl) return { isValid: true, missedCount: 0 };

    const items = modalEl.querySelectorAll('.modal-q-item');
    let missedCount = 0;

    items.forEach(item => {
      let isAnswered = false;

      const inputs = item.querySelectorAll('textarea, input[type="text"], input[type="number"]');
      inputs.forEach(inp => {
        if (inp.value && inp.value.trim() !== '') {
          isAnswered = true;
        }
      });

      const radios = item.querySelectorAll('input[type="radio"]');
      if (radios.length > 0) {
        radios.forEach(r => {
          if (r.checked) isAnswered = true;
        });
      }

      if (!isAnswered) {
        missedCount++;
        item.style.border = '2px dashed #ef4444';
        item.style.background = '#fef2f2';
      } else {
        item.style.border = 'none';
        item.style.background = 'transparent';
      }
    });

    return { isValid: missedCount === 0, missedCount };
  }

  function saveAndUnlockNextStep(modalId, status) {
    const modalCheck = validateModalQuestions(modalId);
    if (!modalCheck.isValid) {
      showCustomAlert('Harap isi seluruh pertanyaan wajib di dalam modal ini terlebih dahulu! Ada ' + modalCheck.missedCount + ' pertanyaan yang terlewat (ditandai border merah).');
      return;
    }

    document.getElementById(modalId).style.display = 'none';
    disableUnselectedModalInputs(status);

    const radioId = 'radio' + capitalizeFirstLetter(status);
    const radio = document.getElementById(radioId);
    if (radio) radio.checked = true;

    document.querySelectorAll('.status-option-card').forEach(card => {
      card.classList.remove('selected');
    });

    const cardId = 'label' + capitalizeFirstLetter(status);
    const cardEl = document.getElementById(cardId);
    if (cardEl) {
      cardEl.classList.add('selected');
    }

    document.querySelectorAll('.edit-badge').forEach(badge => {
      badge.style.display = 'none';
    });

    const badgeId = 'edit' + capitalizeFirstLetter(status);
    const badgeEl = document.getElementById(badgeId);
    if (badgeEl) {
      badgeEl.innerText = '✓ Detail Status Terisi (Klik untuk edit)';
      badgeEl.style.display = 'inline-block';
    }

    document.getElementById('penilaianLockedBox').style.display = 'none';
    document.getElementById('stepTransitionBox').style.display = 'block';
    document.getElementById('penilaianProdiSection').style.display = 'block';

    setTimeout(() => {
      document.getElementById('penilaianProdiSection').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 150);
  }

  function showPenilaianProdi() {
    document.getElementById('penilaianProdiSection').style.display = 'block';
    document.getElementById('penilaianLockedBox').style.display = 'none';
    document.getElementById('penilaianProdiSection').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function closeModalOnBackdrop(e, modalId) {
    if (e.target === e.currentTarget) {
      closeModal(modalId);
    }
  }
  

  function openStatusModal(status) {
    disableUnselectedModalInputs(status);

    // Check radio
    const radioId = 'radio' + capitalizeFirstLetter(status);
    const radio = document.getElementById(radioId);
    if (radio) {
      radio.checked = true;
    }
    
    // Highlight option cards
    document.querySelectorAll('.status-option-card').forEach(card => {
      card.classList.remove('selected');
    });
    
    const cardId = 'label' + capitalizeFirstLetter(status);
    const cardEl = document.getElementById(cardId);
    if (cardEl) {
      cardEl.classList.add('selected');
    }
    
    // Show edit badge for this status and hide others
    document.querySelectorAll('.edit-badge').forEach(badge => {
      badge.style.display = 'none';
    });
    
    const badgeId = 'edit' + capitalizeFirstLetter(status);
    const badge = document.getElementById(badgeId);
    if (badge) {
      badge.style.display = 'inline-block';
    }
    
    // Auto-unlock Penilaian Prodi section so alumni can see and answer star rating questions right away
    const penilaianSec = document.getElementById('penilaianProdiSection');
    const lockedBox = document.getElementById('penilaianLockedBox');
    if (penilaianSec) penilaianSec.style.display = 'block';
    if (lockedBox) lockedBox.style.display = 'none';

    // Open modal
    const modalId = 'modal' + capitalizeFirstLetter(status);
    openModal(modalId);
  }

  function capitalizeFirstLetter(string) {
    if (string === 'belum_bekerja') return 'BelumBekerja';
    return string.charAt(0).toUpperCase() + string.slice(1);
  }

  const scaleLabelsMap = ["Sangat Kurang 😞", "Kurang 🙁", "Cukup 😐", "Baik 🙂", "Sangat Baik ⭐"];

  function updateStarRating(radio) {
    const val = parseInt(radio.value);
    const wrapper = radio.closest('.star-rating-wrapper');
    if (!wrapper) return;

    const cardItem = radio.closest('.eval-card-item');
    if (cardItem) {
      if (val > 0) {
        cardItem.classList.add('selected');
      } else {
        cardItem.classList.remove('selected');
      }
    }

    const labels = wrapper.querySelectorAll('.star-rating-label');
    const textDiv = wrapper.querySelector('.star-rating-text');

    labels.forEach(lbl => {
      const starVal = parseInt(lbl.getAttribute('data-val'));
      const icon = lbl.querySelector('.star-icon');
      if (starVal <= val) {
        lbl.classList.add('checked-star');
        icon.style.fill = '#f59e0b';
        icon.style.stroke = '#d97706';
        icon.style.filter = 'drop-shadow(0 2px 5px rgba(245, 158, 11, 0.4))';
      } else {
        lbl.classList.remove('checked-star');
        icon.style.fill = '#f1f5f9';
        icon.style.stroke = '#cbd5e1';
        icon.style.filter = 'none';
      }
    });

    if (textDiv) {
      textDiv.innerHTML = `⭐ ${val}/5 — <strong>${scaleLabelsMap[val - 1]}</strong>`;
      textDiv.style.background = '#ecfdf5';
      textDiv.style.color = '#047857';
      textDiv.style.borderColor = '#a7f3d0';
    }
  }

  // Run on page load to configure star rating & initially selected state
  window.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.star-rating-wrapper').forEach(wrapper => {
      const labels = wrapper.querySelectorAll('.star-rating-label');

      labels.forEach(lbl => {
        lbl.addEventListener('mouseenter', () => {
          const hoverVal = parseInt(lbl.getAttribute('data-val'));
          labels.forEach(l => {
            const v = parseInt(l.getAttribute('data-val'));
            const icon = l.querySelector('.star-icon');
            if (v <= hoverVal) {
              icon.style.fill = '#fbbf24';
              icon.style.stroke = '#d97706';
              icon.style.filter = 'drop-shadow(0 2px 4px rgba(251, 191, 36, 0.35))';
            } else {
              icon.style.fill = '#e2e8f0';
              icon.style.stroke = '#cbd5e1';
              icon.style.filter = 'none';
            }
          });
        });
      });

      wrapper.addEventListener('mouseleave', () => {
        const checkedRadio = wrapper.querySelector('input[type="radio"]:checked');
        if (checkedRadio) {
          updateStarRating(checkedRadio);
        } else {
          labels.forEach(l => {
            const icon = l.querySelector('.star-icon');
            icon.style.fill = '#e2e8f0';
            icon.style.stroke = '#cbd5e1';
            icon.style.filter = 'none';
          });
          const textDiv = wrapper.querySelector('.star-rating-text');
          if (textDiv) {
            textDiv.textContent = 'Klik bintang untuk menilai';
            textDiv.style.background = '#ffffff';
            textDiv.style.color = '#64748b';
            textDiv.style.borderColor = '#e2e8f0';
          }
        }
      });

      const initialChecked = wrapper.querySelector('input[type="radio"]:checked');
      if (initialChecked) {
        updateStarRating(initialChecked);
      }
    });

    const selectedStatus = document.querySelector('input[name="status_pekerjaan"]:checked')?.value;
    if (selectedStatus) {
      const cardId = 'label' + capitalizeFirstLetter(selectedStatus);
      const card = document.getElementById(cardId);
      if (card) card.classList.add('selected');
      
      const badgeId = 'edit' + capitalizeFirstLetter(selectedStatus);
      const badge = document.getElementById(badgeId);
      if (badge) badge.style.display = 'inline-block';

      // If editing existing tracer, show penilaian prodi directly
      <% if (tracer) { %>
        document.getElementById('penilaianProdiSection').style.display = 'block';
        document.getElementById('penilaianLockedBox').style.display = 'none';
        document.getElementById('stepTransitionBox').style.display = 'none';
      <% } %>
    }

    <% if (!canSubmit) { %>
      // Disable all inputs, textareas, selects, and status cards inside tracerForm
      const form = document.getElementById('tracerForm');
      if (form) {
        const elements = form.querySelectorAll('input, select, textarea, button:not(.btn-outline-back)');
        elements.forEach(el => {
          el.disabled = true;
          el.style.pointerEvents = 'none';
          el.style.opacity = '0.7';
        });
        
        // Also style the status cards as read-only
        document.querySelectorAll('.status-option-card').forEach(card => {
          card.style.pointerEvents = 'none';
          card.style.opacity = '0.8';
          card.style.cursor = 'default';
        });
      }
    <% } %>
  });

  // Auto dismiss flash alerts
  setTimeout(() => {
    document.querySelectorAll('.alert').forEach(el => {
      el.style.opacity = '0';
      setTimeout(() => el.remove(), 500);
    });
  }, 4000);

  function disableUnselectedModalInputs(activeStatus) {
    const modals = ['bekerja', 'wirausaha', 'kuliah', 'belum_bekerja'];
    modals.forEach(st => {
      const modalId = 'modal' + capitalizeFirstLetter(st);
      const modalEl = document.getElementById(modalId);
      if (modalEl) {
        const inputs = modalEl.querySelectorAll('input, select, textarea');
        inputs.forEach(input => {
          if (st !== activeStatus) {
            input.disabled = true;
          } else {
            input.disabled = false;
          }
        });
      }
    });
  }

  // Confirm submission and prevent double submit
  const tracerForm = document.getElementById('tracerForm');
  if (tracerForm) {
    let isSubmitting = false;
    tracerForm.addEventListener('submit', function(e) {
      if (isSubmitting) {
        e.preventDefault();
        return;
      }

      // 1. Check status selection
      const selectedStatus = document.querySelector('input[name="status_pekerjaan"]:checked')?.value;
      if (!selectedStatus) {
        e.preventDefault();
        showCustomAlert('Harap pilih status pekerjaan Anda pada Langkah 1 terlebih dahulu!');
        document.getElementById('statusSelectionSection')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
      }

      // 2. Check active modal detail questions
      const activeModalId = 'modal' + capitalizeFirstLetter(selectedStatus);
      const modalCheck = validateModalQuestions(activeModalId);
      if (!modalCheck.isValid) {
        e.preventDefault();
        openModal(activeModalId);
        showCustomAlert('Masih ada ' + modalCheck.missedCount + ' pertanyaan detail status pekerjaan yang belum diisi! Harap lengkapi seluruh pertanyaan sebelum menyimpan (ditandai border merah).');
        return;
      }

      // 3. Check Langkah 2 star rating questions
      const starWrappers = document.querySelectorAll('.star-rating-wrapper');
      let unansweredCount = 0;
      starWrappers.forEach(wrapper => {
        if (!wrapper.querySelector('input[type="radio"]:checked')) {
          unansweredCount++;
          wrapper.style.border = '2px dashed #f87171';
          wrapper.style.borderRadius = '12px';
          wrapper.style.padding = '12px';
          wrapper.style.background = '#fef2f2';
        } else {
          wrapper.style.border = 'none';
          wrapper.style.padding = '0';
          wrapper.style.background = 'transparent';
        }
      });

      if (unansweredCount > 0) {
        e.preventDefault();
        const penilaianSec = document.getElementById('penilaianProdiSection');
        if (penilaianSec) {
          penilaianSec.style.display = 'block';
          penilaianSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        showCustomAlert('Masih ada ' + unansweredCount + ' pertanyaan Penilaian Program Studi (Langkah 2) yang belum diberi rating bintang! Harap isi seluruh penilaian sebelum menyimpan (ditandai border merah).');
        return;
      }

      e.preventDefault();
      
      showCustomConfirm('Apakah Anda yakin seluruh data kuesioner tracer study sudah terisi dengan benar? Data yang dikirim akan disimpan sebagai rekaman resmi alumni.', function() {
        isSubmitting = true;
        disableUnselectedModalInputs(selectedStatus);

        const submitBtn = tracerForm.querySelector('.btn-submit-tracer');
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.style.opacity = '0.7';
          submitBtn.style.pointerEvents = 'none';
          const btnText = submitBtn.querySelector('span');
          if (btnText) btnText.textContent = 'Mengirim Data...';
        }
        tracerForm.submit();
      });
    });
  }
</script>
</body>
</html>
