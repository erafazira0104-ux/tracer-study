                  <label>Nama Universitas / Perguruan Tinggi</label>
                  <input type="text" name="nama_universitas" id="inputNamaUniversitas" value="<%= tracer && tracer.status_pekerjaan === 'kuliah' ? tracer.nama_universitas || '' : '' %>" placeholder="Universitas Indonesia"/>
                </div>
                <div class="form-group" style="flex: 1; min-width: 250px;">
                  <label>Program Studi</label>
                  <input type="text" name="program_studi_lanjut" id="inputProgramStudiLanjut" value="<%= tracer && tracer.status_pekerjaan === 'kuliah' ? tracer.program_studi_lanjut || '' : '' %>" placeholder="Magister Sistem Informasi"/>
                </div>
              </div>

              <div class="form-row">
                <div class="form-group" style="width:100%;">
                  <label>Jenjang Pendidikan Lanjut</label>
                  <select name="jenjang_lanjut" id="inputJenjangLanjut" style="width: 100%; border: 1.5px solid #e2e8f0; border-radius: 8px; padding: 10px; font-size:13px;">
                    <option value="">-- Pilih Jenjang --</option>
                    <% ['S2','S3','profesi','lainnya'].forEach(j => { %>
                      <option value="<%= j %>" <%= tracer && tracer.status_pekerjaan === 'kuliah' && tracer.jenjang_lanjut === j ? 'selected' : '' %>><%= j %></option>
                    <% }) %>
                  </select>
                </div>
              </div>
            </div>
            <div class="modal-footer-custom">
              <button type="button" class="btn-laporan-solid" onclick="closeModal('modalKuliah')" style="background:#064E3B; color:#fff; border:none; padding:10px 20px; border-radius:8px; font-weight:600; cursor:pointer; font-size:13px;">Simpan & Lanjutkan</button>
            </div>
          </div>
        </div>

        <!-- MODAL: BELUM BEKERJA -->
        <div id="modalBelumBekerja" class="modal-backdrop-custom" onclick="closeModalOnBackdrop(event, 'modalBelumBekerja')">
