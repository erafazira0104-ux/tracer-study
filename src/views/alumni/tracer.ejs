                  <div class="eval-icon-badge">📚</div>
                  <div class="eval-info">
                    <h4>Kesesuaian Kurikulum</h4>
                    <p>Relevansi kurikulum dan materi perkuliahan dengan kebutuhan industri & karir saat ini.</p>
                  </div>
                </div>
                <div>
                  <div class="eval-scale-labels">
                    <span>1: Sangat Tidak Relevan</span>
                    <span>5: Sangat Relevan</span>
                  </div>
                  <div class="eval-rating-container">
                    <% [1, 2, 3, 4, 5].forEach(num => { %>
                      <label class="rating-option" title="Skala <%= num %>">
                        <input type="radio" name="eval_kurikulum" value="<%= num %>" <%= tracer && tracer.eval_kurikulum == num ? 'checked' : '' %> required/>
                        <span><%= num %></span>
                      </label>
                    <% }) %>
                  </div>
                </div>
              </div>

              <!-- Card 2: Kompetensi Dosen -->
              <div class="eval-card-item">
                <div class="eval-header-flex">
                  <div class="eval-icon-badge">👨‍🏫</div>
                  <div class="eval-info">
                    <h4>Kompetensi Dosen</h4>
                    <p>Kualitas pengajaran, bimbingan, dan penguasaan materi oleh tenaga pendidik.</p>
                  </div>
                </div>
                <div>
                  <div class="eval-scale-labels">
                    <span>1: Sangat Kurang</span>
                    <span>5: Sangat Baik</span>
                  </div>
                  <div class="eval-rating-container">
                    <% [1, 2, 3, 4, 5].forEach(num => { %>
                      <label class="rating-option" title="Skala <%= num %>">
                        <input type="radio" name="eval_dosen" value="<%= num %>" <%= tracer && tracer.eval_dosen == num ? 'checked' : '' %> required/>
                        <span><%= num %></span>
                      </label>
                    <% }) %>
                  </div>
                </div>
              </div>

              <!-- Card 3: Fasilitas -->
