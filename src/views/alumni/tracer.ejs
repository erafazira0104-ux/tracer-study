              </div>

              <div class="form-row two-cols" style="display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 16px;">
                <div class="form-group" style="flex: 1; min-width: 250px;">
                  <label>Bidang Usaha</label>
                  <input type="text" name="bidang_perusahaan_wira" id="inputBidangPerusahaanWira" value="<%= tracer && tracer.status_pekerjaan === 'wirausaha' ? tracer.bidang_perusahaan || '' : '' %>" placeholder="Perdagangan, Jasa IT, Kuliner, dll"/>
                </div>
                <div class="form-group" style="flex: 1; min-width: 250px;">
                  <label>Lokasi Usaha</label>
                  <input type="text" name="lokasi_perusahaan_wira" id="inputLokasiPerusahaanWira" value="<%= tracer && tracer.status_pekerjaan === 'wirausaha' ? tracer.lokasi_perusahaan || '' : '' %>" placeholder="Lombok Timur, NTB"/>
                </div>
              </div>

              <div class="form-row two-cols" style="display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 16px;">
                <div class="form-group" style="flex: 1; min-width: 250px;">
                  <label>Pendapatan Rata-rata Bulanan</label>
                  <select name="gaji_pertama_wira" id="inputGajiPertamaWira" style="width: 100%; border: 1.5px solid #e2e8f0; border-radius: 8px; padding: 10px; font-size:13px;">
                    <option value="">-- Pilih Rentang Pendapatan --</option>
                    <% ['<1juta','1-2juta','2-3juta','3-5juta','5-10juta','>10juta'].forEach(g => { %>
                      <option value="<%= g %>" <%= tracer && tracer.status_pekerjaan === 'wirausaha' && tracer.gaji_pertama === g ? 'selected' : '' %>><%= g %></option>
                    <% }) %>
                  </select>
                </div>
                <div class="form-group" style="flex: 1; min-width: 250px;">
                  <label>Waktu Mempersiapkan Usaha</label>
                  <select name="lama_mencari_kerja_wira" id="inputLamaMencariKerjaWira" style="width: 100%; border: 1.5px solid #e2e8f0; border-radius: 8px; padding: 10px; font-size:13px;">
                    <option value="">-- Pilih Lama Waktu --</option>
                    <% ['<1bulan','1-3bulan','3-6bulan','6-12bulan','>12bulan'].forEach(l => { %>
                      <option value="<%= l %>" <%= tracer && tracer.status_pekerjaan === 'wirausaha' && tracer.lama_mencari_kerja === l ? 'selected' : '' %>><%= l %></option>
                    <% }) %>
                  </select>
                </div>
              </div>

              <div class="form-row" style="margin-bottom: 16px;">
                <div class="form-group" style="width:100%;">
                  <label>Sumber Modal / Cara Memulai Usaha</label>
                  <input type="text" name="media_mencari_kerja_wira" id="inputMediaMencariKerjaWira" value="<%= tracer && tracer.status_pekerjaan === 'wirausaha' ? tracer.media_mencari_kerja || '' : '' %>" placeholder="Modal sendiri, dana hibah kompetisi, pinjaman, dll" style="width:100%; box-sizing:border-box;"/>
                </div>
              </div>

              <div class="form-row">
                <div class="form-group" style="width:100%;">
                  <label>Kesesuaian Bidang Studi dengan Jenis Usaha</label>
                  <select name="kesesuaian_bidang_wira" id="inputKesesuaianBidangWira" style="width: 100%; border: 1.5px solid #e2e8f0; border-radius: 8px; padding: 10px; font-size:13px;">
                    <option value="">-- Pilih Kesesuaian --</option>
                    <option value="sangat_sesuai" <%= tracer && tracer.status_pekerjaan === 'wirausaha' && tracer.kesesuaian_bidang === 'sangat_sesuai' ? 'selected' : '' %>>Sangat Sesuai</option>
                    <option value="sesuai" <%= tracer && tracer.status_pekerjaan === 'wirausaha' && tracer.kesesuaian_bidang === 'sesuai' ? 'selected' : '' %>>Sesuai</option>
                    <option value="kurang_sesuai" <%= tracer && tracer.status_pekerjaan === 'wirausaha' && tracer.kesesuaian_bidang === 'kurang_sesuai' ? 'selected' : '' %>>Kurang Sesuai</option>
                    <option value="tidak_sesuai" <%= tracer && tracer.status_pekerjaan === 'wirausaha' && tracer.kesesuaian_bidang === 'tidak_sesuai' ? 'selected' : '' %>>Tidak Sesuai</option>
                  </select>
                </div>
              </div>
            </div>
            <div class="modal-footer-custom">
              <button type="button" class="btn-laporan-solid" onclick="closeModal('modalWirausaha')" style="background:#064E3B; color:#fff; border:none; padding:10px 20px; border-radius:8px; font-weight:600; cursor:pointer; font-size:13px;">Simpan & Lanjutkan</button>
            </div>
          </div>
        </div>

        <!-- MODAL: KULIAH / STUDI LANJUT -->
        <div id="modalKuliah" class="modal-backdrop-custom" onclick="closeModalOnBackdrop(event, 'modalKuliah')">
          <div class="modal-content-custom">
