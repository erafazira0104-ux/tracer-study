                      <label class="rating-option" title="Skala <%= num %>">
                        <input type="radio" name="eval_fasilitas" value="<%= num %>" <%= tracer && tracer.eval_fasilitas == num ? 'checked' : '' %> required/>
                        <span><%= num %></span>
                      </label>
                    <% }) %>
                  </div>
                </div>
              </div>

