<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Kuesioner Tracer Study | Alumni</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
  <!-- Reuse dashboard styles for layout & sidebar, import tracer.css for page specific styles -->
  <link rel="stylesheet" href="/css/alumni/dashboard.css"/>
  <link rel="stylesheet" href="/css/alumni/tracer.css"/>
  <style>
    /* Modal Backdrop */
    .modal-backdrop-custom {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0, 0, 0, 0.4);
      backdrop-filter: blur(4px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      padding: 20px;
    }
    
    /* Modal Content */
    .modal-content-custom {
      background: #fff;
      border-radius: 16px;
      box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1), 0 10px 10px -5px rgba(0,0,0,0.04);
      max-width: 680px;
      width: 100%;
      max-height: 85vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      animation: modalFadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    
    @keyframes modalFadeIn {
      from { transform: translateY(16px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    
    /* Modal Header */
    .modal-header-custom {
      padding: 16px 24px;
      border-bottom: 1.5px solid #e2e8f0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #fafaf9;
    }
    .modal-header-custom h3 {
      margin: 0;
      font-size: 15px;
      font-weight: 800;
      color: #064E3B;
    }
    .modal-close-btn {
      background: none;
      border: none;
      font-size: 24px;
      cursor: pointer;
      color: #94a3b8;
      line-height: 1;
      padding: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .modal-close-btn:hover {
      color: #ef4444;
    }
    
    /* Modal Body */
    .modal-body-custom {
      padding: 24px;
      overflow-y: auto;
      flex: 1;
      text-align: left;
    }
    
    /* Modal Footer */
    .modal-footer-custom {
      padding: 16px 24px;
      border-top: 1.5px solid #e2e8f0;
      display: flex;
      justify-content: flex-end;
      gap: 12px;
      background: #fafaf9;
    }
    
    /* Grid for Evaluation Program Studi */
    /* Grid for Evaluation Program Studi */
    .eval-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 24px;
      margin-top: 24px;
      text-align: left;
    }
    .eval-card-item {
      background: #ffffff;
      border: 1.5px solid #e2e8f0;
      border-radius: 16px;
      padding: 24px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 2px 8px rgba(0,0,0,0.02);
      position: relative;
    }
    .eval-card-item:hover {
      border-color: #064E3B;
      transform: translateY(-3px);
      box-shadow: 0 12px 24px -6px rgba(6, 78, 59, 0.12);
    }
    .eval-header-flex {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      margin-bottom: 16px;
    }
    .eval-icon-badge {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: #ecfdf5;
      color: #064E3B;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      flex-shrink: 0;
      border: 1px solid #a7f3d0;
    }
    .eval-info h4 {
      font-size: 14px;
      font-weight: 750;
      color: #0f172a;
      margin: 0 0 4px 0;
      line-height: 1.3;
    }
    .eval-info p {
      font-size: 12px;
      color: #64748b;
      margin: 0;
      line-height: 1.4;
    }
    .eval-scale-labels {
      display: flex;
      justify-content: space-between;
      font-size: 10px;
      font-weight: 600;
      color: #94a3b8;
      margin-bottom: 6px;
      padding: 0 2px;
    }
    .eval-rating-container {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      margin-top: 12px;
    }
    .rating-option {
      flex: 1;
      text-align: center;
    }
    .rating-option input {
      display: none;
    }
    .rating-option span {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 10px 0;
      border: 1.5px solid #e2e8f0;
      border-radius: 10px;
      font-size: 14px;
      font-weight: 700;
      color: #334155;
      cursor: pointer;
      transition: all 0.2s ease;
      background: #f8fafc;
    }
    .rating-option input:checked + span {
      background: #064E3B;
      border-color: #064E3B;
      color: #ffffff;
      box-shadow: 0 4px 12px rgba(6, 78, 59, 0.25);
      transform: scale(1.04);
    }
    .rating-option span:hover {
      border-color: #064E3B;
      background: #f0fdf4;
      color: #064E3B;
    }
    
    /* Edit Badge inside selection */
    .edit-badge {
      display: inline-block;
      padding: 4px 8px;
      background: #e8f4ec;
      border-radius: 4px;
      font-size: 10px;
      color: #064E3B;
      font-weight: 700;
      margin-top: 8px;
      border: 1px solid #d1e7d9;
    }
  </style>
</head>
<body>

<div class="dashboard-container">
  <!-- SIDEBAR PARTIAL -->
  <%- include('../partials/alumni-sidebar') %>

  <!-- MAIN CONTENT -->
  <div class="main-content">
    
    <!-- TOP HEADER -->
    <%- include('../partials/alumni-topbar', { topbarTitle: 'Alumni Tracer Study', topbarSub: 'Sistem Informasi Hamzanwadi University' }) %>

    <!-- CONTENT WRAPPER -->
    <div class="content-body">
      
      <!-- BREADCRUMBS -->
      <div class="breadcrumbs">
        <a href="/alumni/dashboard">Beranda</a>
        <span>/</span>
        <span class="active">Kuesioner</span>
      </div>

      <!-- PAGE TITLE -->
      <div class="page-title-section">
        <h2><%= riwayatList && riwayatList.length > 0 ? 'Update Tracer Study — Periode ' + periodeSaatIni : 'Tracer Study Lulusan' %></h2>
        <p><%= riwayatList && riwayatList.length > 0 ? 'Perbarui data karir Anda untuk periode ' + periodeSaatIni + '. Pengisian ke-' + pengisianKe : 'Tahap 2: Pengisian Data Karir dan Evaluasi Program Studi' %></p>
      </div>

      <!-- PROGRESS TRACKER -->
      <div class="progress-tracker">
        <div class="tracker-step done">
          <div class="step-num-box">
            <svg viewBox="0 0 24 24" class="step-icon"><path fill="currentColor" d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
          </div>
          <span>Lengkapi Profil</span>
        </div>
        <div class="tracker-line filled"></div>
        <div class="tracker-step active">
          <div class="step-num-box">
            <svg viewBox="0 0 24 24" class="step-icon"><path fill="currentColor" d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10H7v-2h10v2zm0-4H7V7h10v2zm0 8H7v-2h10v2z"/></svg>
          </div>
          <span>Isi Kuesioner</span>
        </div>
        <div class="tracker-line <%= tracer ? 'filled' : '' %>"></div>
        <div class="tracker-step <%= tracer ? 'done' : 'todo' %>">
          <div class="step-num-box">
            <svg viewBox="0 0 24 24" class="step-icon"><path fill="currentColor" d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
          </div>
          <span>Selesai</span>
        </div>
      </div>

      <!-- Flash Alert -->
      <% if (success) { %>
        <div class="alert alert-success">
          <div class="alert-icon">✓</div>
          <div class="alert-content"><%= success %></div>
        </div>
      <% } %>
      <% if (error) { %>
        <div class="alert alert-error">
          <div class="alert-icon">⚠️</div>
          <div class="alert-content"><%= error %></div>
        </div>
      <% } %>

      <!-- RIWAYAT PENGISIAN (History Timeline) -->
      <% if (riwayatList && riwayatList.length > 0) { %>
      <div class="form-card" style="border-left: 4px solid #064E3B; margin-bottom: 24px;">
        <div style="padding: 24px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 8px;">
            <div>
              <h3 style="font-size: 16px; font-weight: 800; color: #064E3B; margin: 0 0 4px 0; display: flex; align-items: center; gap: 8px;">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" style="color: #064E3B;"><path d="M13 3a9 9 0 0 0-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42A8.954 8.954 0 0 0 13 21a9 9 0 0 0 0-18zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z"/></svg>
                Riwayat Pengisian Tracer Study
              </h3>
              <p style="font-size: 12px; color: #64748b; margin: 0;">Anda telah mengisi <strong><%= riwayatList.length %></strong> kali. Scroll untuk melihat riwayat sebelumnya.</p>
            </div>
            <span style="background: linear-gradient(135deg, #064E3B, #0d7955); color: #fff; padding: 6px 14px; border-radius: 20px; font-size: 11px; font-weight: 700; white-space: nowrap;">
              Pengisian Berikutnya: Ke-<%= pengisianKe %>
            </span>
          </div>
          
          <div style="display: flex; flex-direction: column; gap: 12px; max-height: 300px; overflow-y: auto; padding-right: 8px;">
            <% riwayatList.forEach(function(rw, idx) { %>
            <div style="display: flex; gap: 16px; align-items: flex-start; padding: 16px; background: <%= idx === 0 ? '#f0fdf4' : '#fafaf9' %>; border: 1px solid <%= idx === 0 ? '#bbf7d0' : '#e2e8f0' %>; border-radius: 12px; transition: all 0.2s ease;">
              <div style="min-width: 44px; height: 44px; border-radius: 50%; background: <%= idx === 0 ? '#064E3B' : '#e2e8f0' %>; color: <%= idx === 0 ? '#fff' : '#64748b' %>; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 14px;">
                #<%= rw.pengisian_ke || (riwayatList.length - idx) %>
              </div>
              <div style="flex: 1; min-width: 0;">
                <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px; flex-wrap: wrap;">
                  <span style="font-weight: 700; font-size: 14px; color: #0f172a;">Periode <%= rw.periode || '-' %></span>
                  <% if (idx === 0) { %>
                    <span style="background: #064E3B; color: #fff; padding: 2px 8px; border-radius: 4px; font-size: 10px; font-weight: 700;">TERBARU</span>
                  <% } %>
                </div>
                <div style="display: flex; gap: 12px; flex-wrap: wrap; font-size: 12px; color: #64748b;">
                  <span>Status: <strong style="color: #0f172a; text-transform: capitalize;"><%= rw.status_pekerjaan ? rw.status_pekerjaan.replace('_', ' ') : '-' %></strong></span>
                  <% if (rw.nama_perusahaan) { %><span>• <%= rw.nama_perusahaan %></span><% } %>
                  <% if (rw.nama_universitas) { %><span>• <%= rw.nama_universitas %></span><% } %>
                  <span>• <%= rw.tanggal_isi ? new Date(rw.tanggal_isi).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) : '-' %></span>
                </div>
              </div>
            </div>
            <% }); %>
          </div>
        </div>
      </div>
      <% } %>

      <!-- FORM -->
      <form action="/alumni/tracer" method="POST" id="tracerForm" class="tracer-form-layout">
        <% if (!canSubmit) { %>
        <div class="form-card" style="border-left: 4px solid #d97706; margin-bottom: 24px; background: #fffbeb;">
          <div style="padding: 24px; display: flex; gap: 16px; align-items: flex-start;">
            <div style="font-size: 28px;">🔒</div>
            <div>
              <h3 style="font-size: 16px; font-weight: 800; color: #b45309; margin: 0 0 6px 0;">Pengisian Kuesioner Terkunci</h3>
              <p style="font-size: 13px; color: #78350f; margin: 0; line-height: 1.6;">
                <% if (!isPeriodOpen) { %>
                  <%= periodOpenMessage %>
                <% } else if (!coolDownOk) { %>
                  <%= coolDownMessage %>
                <% } %>
              </p>
              <div style="margin-top: 14px; display: inline-flex; gap: 8px;">
                <a href="/alumni/dashboard" class="btn btn-outline-back" style="background:#fff; border-color:#d97706; color:#78350f; font-size:11px; padding: 6px 12px; border-radius:8px; text-decoration:none;">&larr; Kembali ke Beranda</a>
              </div>
            </div>
          </div>
        </div>
        <% } %>
        <!-- Hidden inputs for mapping dynamic fields -->
        <input type="hidden" name="nama_perusahaan" id="hiddenNamaPerusahaan"/>
        <input type="hidden" name="jabatan" id="hiddenJabatan"/>
        <input type="hidden" name="bidang_perusahaan" id="hiddenBidangPerusahaan"/>
        <input type="hidden" name="lokasi_perusahaan" id="hiddenLokasiPerusahaan"/>
        <input type="hidden" name="gaji_pertama" id="hiddenGajiPertama"/>
        <input type="hidden" name="lama_mencari_kerja" id="hiddenLamaMencariKerja"/>
        <input type="hidden" name="media_mencari_kerja" id="hiddenMediaMencariKerja"/>
        <input type="hidden" name="kesesuaian_bidang" id="hiddenKesesuaianBidang"/>
        <!-- New Bekerja hidden fields -->
        <input type="hidden" name="kapan_mulai_cari_kerja" id="hiddenKapanMulaiCariKerja"/>
        <input type="hidden" name="jenis_instansi" id="hiddenJenisInstansi"/>
        <input type="hidden" name="penghasilan_bulanan" id="hiddenPenghasilanBulanan"/>
        <input type="hidden" name="kesesuaian_kompetensi" id="hiddenKesesuaianKompetensi"/>
        <input type="hidden" name="pendidikan_minimal_s1" id="hiddenPendidikanMinimalS1"/>

        <!-- STEP 1: DIMANA ANDA SEKARANG? -->
        <div class="form-card status-selection-card">
          <div class="form-card-header-banner">
            <h3>Dimana Anda Sekarang?</h3>
            <p>Data yang Anda berikan sangat berarti bagi pengembangan kurikulum dan kualitas lulusan Universitas Hamzanwadi.</p>
          </div>
          <div class="status-options-grid">
            
            <!-- BEKERJA -->
            <div class="status-option-card <%= tracer && tracer.status_pekerjaan === 'bekerja' ? 'selected' : '' %>" id="labelBekerja" onclick="openStatusModal('bekerja')" style="cursor: pointer;">
              <input type="radio" name="status_pekerjaan" value="bekerja" class="hidden-radio" id="radioBekerja" <%= tracer && tracer.status_pekerjaan === 'bekerja' ? 'checked' : '' %> style="display:none;"/>
              <div class="card-icon-circle accent-green">🏢</div>
              <div class="card-option-body">
                <h4>BEKERJA</h4>
                <p>Saya saat ini sudah bekerja secara penuh atau paruh waktu di sebuah instansi atau perusahaan.</p>
                <div class="edit-badge" id="editBekerja" style="display:<%= tracer && tracer.status_pekerjaan === 'bekerja' ? 'inline-block' : 'none' %>;">✓ Klik untuk edit detail</div>
              </div>
            </div>

            <!-- WIRAUSAHA -->
            <div class="status-option-card <%= tracer && tracer.status_pekerjaan === 'wirausaha' ? 'selected' : '' %>" id="labelWirausaha" onclick="openStatusModal('wirausaha')" style="cursor: pointer;">
              <input type="radio" name="status_pekerjaan" value="wirausaha" class="hidden-radio" id="radioWirausaha" <%= tracer && tracer.status_pekerjaan === 'wirausaha' ? 'checked' : '' %> style="display:none;"/>
              <div class="card-icon-circle accent-orange">🏪</div>
              <div class="card-option-body">
                <h4>WIRAUSAHA</h4>
                <p>Saya sedang menjalankan bisnis mandiri, startup, atau memiliki usaha perorangan yang sedang berjalan.</p>
                <div class="edit-badge" id="editWirausaha" style="display:<%= tracer && tracer.status_pekerjaan === 'wirausaha' ? 'inline-block' : 'none' %>;">✓ Klik untuk edit detail</div>
              </div>
            </div>

            <!-- KULIAH / STUDI LANJUT -->
            <div class="status-option-card <%= tracer && tracer.status_pekerjaan === 'kuliah' ? 'selected' : '' %>" id="labelKuliah" onclick="openStatusModal('kuliah')" style="cursor: pointer;">
              <input type="radio" name="status_pekerjaan" value="kuliah" class="hidden-radio" id="radioKuliah" <%= tracer && tracer.status_pekerjaan === 'kuliah' ? 'checked' : '' %> style="display:none;"/>
              <div class="card-icon-circle accent-blue">🎓</div>
              <div class="card-option-body">
                <h4>STUDI LANJUT</h4>
                <p>Saya sedang melanjutkan pendidikan ke jenjang Magister (S2), Doktor (S3), atau program profesi lainnya.</p>
                <div class="edit-badge" id="editKuliah" style="display:<%= tracer && tracer.status_pekerjaan === 'kuliah' ? 'inline-block' : 'none' %>;">✓ Klik untuk edit detail</div>
              </div>
            </div>

            <!-- BELUM BEKERJA -->
            <div class="status-option-card <%= tracer && tracer.status_pekerjaan === 'belum_bekerja' ? 'selected' : '' %>" id="labelBelumBekerja" onclick="openStatusModal('belum_bekerja')" style="cursor: pointer;">
              <input type="radio" name="status_pekerjaan" value="belum_bekerja" class="hidden-radio" id="radioBelumBekerja" <%= tracer && tracer.status_pekerjaan === 'belum_bekerja' ? 'checked' : '' %> style="display:none;"/>
              <div class="card-icon-circle accent-red">🔍</div>
              <div class="card-option-body">
                <h4>BELUM BEKERJA</h4>
                <p>Saya sedang dalam masa transisi, mencari lowongan pekerjaan, atau berencana melanjutkan studi dalam waktu dekat.</p>
                <div class="edit-badge" id="editBelumBekerja" style="display:<%= tracer && tracer.status_pekerjaan === 'belum_bekerja' ? 'inline-block' : 'none' %>;">✓ Klik untuk edit detail</div>
              </div>
            </div>
          </div>

          <!-- Help Box at bottom of status selection (Mockup 5) -->
          <div style="display: flex; align-items: center; justify-content: space-between; background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 8px; padding: 16px 20px; margin: 24px 20px 20px; font-size: 13px;">
            <div style="display: flex; align-items: flex-start; gap: 10px;">
              <span style="font-size: 18px; margin-top:-2px;">❓</span>
              <div style="line-height:1.4; text-align: left;">
                <strong style="color: #0f172a; font-weight:700;">Bingung Memilih Status?</strong>
                <p style="color: #64748b; font-size: 11px; margin: 2px 0 0;">Hubungi pusat bantuan Tracer Study untuk konsultasi terkait pengisian kuesioner.</p>
              </div>
            </div>
            <a href="https://wa.me/6281234567890" target="_blank" style="text-decoration: none; border: 1.5px solid #004b38; color: #004b38; font-weight:700; font-size:12px; padding: 8px 16px; border-radius: 6px; background: transparent; transition: all 0.2s;" onmouseover="this.style.background='#e8f4ec'" onmouseout="this.style.background='transparent'">
              Tanya Admin
            </a>
          </div>
        </div>

        <!-- MODAL: BEKERJA -->
        <div id="modalBekerja" class="modal-backdrop-custom" onclick="closeModalOnBackdrop(event, 'modalBekerja')">
          <div class="modal-content-custom" style="max-width: 780px;">
            <div class="modal-header-custom">
              <h3>🏢 Detail Status Bekerja</h3>
              <button type="button" class="modal-close-btn" onclick="closeModal('modalBekerja')">&times;</button>
            </div>
            <div class="modal-body-custom">
              <p style="font-size: 12px; color: #64748b; margin-bottom: 20px; border-bottom: 1px solid #e2e8f0; padding-bottom: 12px;">Silakan lengkapi seluruh detail informasi pekerjaan Anda di bawah ini. Semua pertanyaan wajib diisi untuk kelengkapan data tracer study.</p>
              
              <!-- SUBSECTION 1: MASA PENCARIAN KERJA -->
              <div style="margin-bottom: 24px;">
                <h4 style="font-size: 13px; font-weight: 700; color: #064E3B; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">⏱️ Masa Pencarian Kerja</h4>
                
                <div class="form-group" style="margin-bottom: 16px;">
                  <label for="kapan_mulai_cari_kerja_bekerja">Kapan Anda mulai mencari pekerjaan?</label>
                  <input type="text" name="kapan_mulai_cari_kerja_bekerja" id="kapan_mulai_cari_kerja_bekerja" value="<%= tracer && tracer.status_pekerjaan === 'bekerja' ? tracer.kapan_mulai_cari_kerja || '' : '' %>" placeholder="Contoh: Sejak semester 7, sebelum wisuda, setelah lulus, dll"/>
                </div>

                <div class="form-group">
                  <label>Berapa lama memperoleh pekerjaan pertama setelah lulus?</label>
                  <div class="radio-box-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; margin-top: 6px;">
                    <% ['Sebelum lulus', 'Kurang dari 3 bulan', '3–6 bulan', '7–12 bulan', 'Lebih dari 1 tahun'].forEach(opt => { %>
                      <label class="radio-box-label <%= tracer && tracer.status_pekerjaan === 'bekerja' && tracer.lama_mencari_kerja === opt ? 'selected' : '' %>">
                        <input type="radio" name="lama_mencari_kerja_bekerja" value="<%= opt %>" <%= tracer && tracer.status_pekerjaan === 'bekerja' && tracer.lama_mencari_kerja === opt ? 'checked' : '' %>/>
                        <span><%= opt %></span>
                      </label>
                    <% }) %>
                  </div>
                </div>
              </div>

              <!-- SUBSECTION 2: INFORMASI INSTANSI & JABATAN -->
              <div style="margin-bottom: 24px;">
                <h4 style="font-size: 13px; font-weight: 700; color: #064E3B; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">🏢 Informasi Instansi & Jabatan</h4>
                
                <div class="form-row two-cols" style="display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 16px;">
                  <div class="form-group" style="flex: 1; min-width: 250px;">
                    <label for="nama_perusahaan_bekerja">Nama perusahaan/instansi tempat bekerja</label>
                    <input type="text" name="nama_perusahaan_bekerja" id="nama_perusahaan_bekerja" value="<%= tracer && tracer.status_pekerjaan === 'bekerja' ? tracer.nama_perusahaan || '' : '' %>" placeholder="Contoh: PT. Teknologi Indonesia"/>
                  </div>
                  <div class="form-group" style="flex: 1; min-width: 250px;">
                    <label>Jenis instansi</label>
                    <select name="jenis_instansi_bekerja" id="jenis_instansi_bekerja" style="width: 100%; border: 1.5px solid #e2e8f0; border-radius: 8px; padding: 10px; font-size:13px; font-family: inherit; outline: none; background: #fff;">
                      <option value="">-- Pilih Jenis Instansi --</option>
                      <% ['Instansi Pemerintah', 'BUMN', 'Swasta Nasional', 'Swasta Multinasional', 'Start-up', 'Lembaga Pendidikan', 'Organisasi Non-Profit', 'Lainnya'].forEach(ji => { %>
                        <option value="<%= ji %>" <%= tracer && tracer.status_pekerjaan === 'bekerja' && tracer.jenis_instansi === ji ? 'selected' : '' %>><%= ji %></option>
                      <% }) %>
                    </select>
                  </div>
                </div>

                <div class="form-row two-cols" style="display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 16px;">
                  <div class="form-group" style="flex: 1; min-width: 250px;">
                    <label for="bidang_perusahaan_bekerja">Bidang usaha perusahaan</label>
                    <input type="text" name="bidang_perusahaan_bekerja" id="bidang_perusahaan_bekerja" value="<%= tracer && tracer.status_pekerjaan === 'bekerja' ? tracer.bidang_perusahaan || '' : '' %>" placeholder="Contoh: Teknologi Informasi, Perbankan, Pendidikan"/>
                  </div>
                  <div class="form-group" style="flex: 1; min-width: 250px;">
                    <label for="jabatan_bekerja">Jabatan saat ini</label>
                    <input type="text" name="jabatan_bekerja" id="jabatan_bekerja" value="<%= tracer && tracer.status_pekerjaan === 'bekerja' ? tracer.jabatan || '' : '' %>" placeholder="Contoh: Senior Web Developer"/>
                  </div>
                </div>

                <div class="form-group" style="margin-bottom: 16px;">
                  <label for="lokasi_perusahaan_bekerja">Lokasi tempat kerja</label>
                  <input type="text" name="lokasi_perusahaan_bekerja" id="lokasi_perusahaan_bekerja" value="<%= tracer && tracer.status_pekerjaan === 'bekerja' ? tracer.lokasi_perusahaan || '' : '' %>" placeholder="Contoh: Jakarta, Mataram, Lombok Timur"/>
                </div>
              </div>

              <!-- SUBSECTION 3: STATUS & PENGHASILAN -->
              <div style="margin-bottom: 24px;">
                <h4 style="font-size: 13px; font-weight: 700; color: #064E3B; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">💰 Status & Penghasilan</h4>
                
                <div class="form-group" style="margin-bottom: 16px;">
                  <label>Status pekerjaan</label>
                  <div class="radio-box-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 10px; margin-top: 6px;">
                    <% ['Pegawai Tetap', 'Pegawai Kontrak', 'Honorer', 'Freelance'].forEach(sp => { %>
                      <label class="radio-box-label <%= tracer && tracer.status_pekerjaan === 'bekerja' && tracer.status_kerja_detail === sp ? 'selected' : '' %>">
                        <input type="radio" name="status_kerja_detail" value="<%= sp %>" <%= tracer && tracer.status_pekerjaan === 'bekerja' && tracer.status_kerja_detail === sp ? 'checked' : '' %>/>
                        <span><%= sp %></span>
                      </label>
                    <% }) %>
                  </div>
                </div>

                <div class="form-group">
                  <label>Berapa rata-rata penghasilan Anda per bulan?</label>
                  <div class="radio-box-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 10px; margin-top: 6px;">
                    <% ['< Rp2.000.000', 'Rp2.000.000–Rp4.000.000', 'Rp4.000.001–Rp6.000.000', 'Rp6.000.001–Rp8.000.000', '> Rp8.000.000'].forEach(gj => { %>
                      <label class="radio-box-label <%= tracer && tracer.status_pekerjaan === 'bekerja' && tracer.penghasilan_bulanan === gj ? 'selected' : '' %>">
                        <input type="radio" name="penghasilan_bulanan_bekerja" value="<%= gj %>" <%= tracer && tracer.status_pekerjaan === 'bekerja' && tracer.penghasilan_bulanan === gj ? 'checked' : '' %>/>
                        <span><%= gj %></span>
                      </label>
                    <% }) %>
                  </div>
                </div>
              </div>

              <!-- SUBSECTION 4: KESESUAIAN & RELEVANSI -->
              <div>
                <h4 style="font-size: 13px; font-weight: 700; color: #064E3B; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">📊 Kesesuaian & Relevansi</h4>
                
                <div class="form-group" style="margin-bottom: 16px;">
                  <label>Apakah pekerjaan Anda sesuai dengan bidang ilmu Sistem Informasi?</label>
                  <div class="radio-box-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 10px; margin-top: 6px;">
                    <% ['Sangat Sesuai', 'Sesuai', 'Cukup Sesuai', 'Kurang Sesuai', 'Tidak Sesuai'].forEach(ks => { %>
                      <label class="radio-box-label <%= tracer && tracer.status_pekerjaan === 'bekerja' && tracer.kesesuaian_bidang === ks ? 'selected' : '' %>">
                        <input type="radio" name="kesesuaian_bidang_bekerja" value="<%= ks %>" <%= tracer && tracer.status_pekerjaan === 'bekerja' && tracer.kesesuaian_bidang === ks ? 'checked' : '' %>/>
                        <span><%= ks %></span>
                      </label>
                    <% }) %>
                  </div>
                </div>

                <!-- Rating 1-5: Kesesuaian Kompetensi -->
                <div class="form-group" style="margin-bottom: 16px;">
                  <label>Seberapa besar kesesuaian pekerjaan dengan kompetensi yang diperoleh selama kuliah?</label>
                  <div style="margin-top: 8px;">
                    <div class="eval-scale-labels" style="display: flex; justify-content: space-between; font-size: 10px; font-weight: 600; color: #94a3b8; margin-bottom: 6px; padding: 0 2px;">
                      <span>1: Sangat Tidak Sesuai</span>
                      <span>5: Sangat Sesuai</span>
                    </div>
                    <div class="eval-rating-container" style="display: flex; justify-content: space-between; gap: 10px;">
                      <% [1, 2, 3, 4, 5].forEach(num => { %>
                        <label class="rating-option" title="Skala <%= num %>" style="flex: 1; text-align: center;">
                          <input type="radio" name="kesesuaian_kompetensi_bekerja" value="<%= num %>" <%= tracer && tracer.status_pekerjaan === 'bekerja' && tracer.kesesuaian_kompetensi == num ? 'checked' : '' %> style="display:none;"/>
                          <span style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 10px 0; border: 1.5px solid #e2e8f0; border-radius: 10px; font-size: 14px; font-weight: 700; color: #334155; cursor: pointer; transition: all 0.2s ease; background: #f8fafc;"><%= num %></span>
                        </label>
                      <% }) %>
                    </div>
                  </div>
                </div>

                <div class="form-group">
                  <label>Apakah pekerjaan Anda memerlukan pendidikan minimal S1?</label>
                  <div class="radio-inline-group" style="display: flex; gap: 16px; margin-top: 6px; flex-wrap: wrap;">
                    <% ['Ya, sangat diperlukan', 'Ya, tetapi tidak harus', 'Tidak diperlukan'].forEach(pm => { %>
                      <label class="radio-box-label" style="flex: 1; min-width: 140px; <%= tracer && tracer.status_pekerjaan === 'bekerja' && tracer.pendidikan_minimal_s1 === pm ? 'border-color: #064E3B; background: #f0fdf4;' : '' %>">
                        <input type="radio" name="pendidikan_minimal_s1_bekerja" value="<%= pm %>" <%= tracer && tracer.status_pekerjaan === 'bekerja' && tracer.pendidikan_minimal_s1 === pm ? 'checked' : '' %>/>
                        <span><%= pm %></span>
                      </label>
                    <% }) %>
                  </div>
                </div>
              </div>
            </div>
            <div class="modal-footer-custom">
              <button type="button" class="btn-laporan-solid" onclick="closeModal('modalBekerja')" style="background:#064E3B; color:#fff; border:none; padding:10px 20px; border-radius:8px; font-weight:600; cursor:pointer; font-size:13px;">Simpan & Lanjutkan</button>
            </div>
          </div>
        </div>

        <!-- MODAL: WIRAUSAHA -->
        <div id="modalWirausaha" class="modal-backdrop-custom" onclick="closeModalOnBackdrop(event, 'modalWirausaha')">
          <div class="modal-content-custom">
            <div class="modal-header-custom">
              <h3>Detail Status Wirausaha</h3>
              <button type="button" class="modal-close-btn" onclick="closeModal('modalWirausaha')">&times;</button>
            </div>
            <div class="modal-body-custom">
              <p style="font-size: 12px; color: #64748b; margin-bottom: 20px; border-bottom: 1px solid #e2e8f0; padding-bottom: 12px;">Silakan lengkapi detail informasi wirausaha Anda di bawah ini:</p>
              
              <div class="form-row two-cols" style="display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 16px;">
                <div class="form-group" style="flex: 1; min-width: 250px;">
                  <label>Nama Usaha / Bisnis</label>
                  <input type="text" name="nama_perusahaan_wira" id="inputNamaPerusahaanWira" value="<%= tracer && tracer.status_pekerjaan === 'wirausaha' ? tracer.nama_perusahaan || '' : '' %>" placeholder="CV Digital Solusi"/>
