              <div class="eval-card-item">
                <div class="eval-header-flex">
                  <div class="eval-icon-badge">🎓</div>
                  <div class="eval-info">
                    <h4>Pelayanan Akademik</h4>
                    <p>Kualitas layanan administrasi prodi, surat-menyurat, dan pembimbingan skripsi.</p>
                  </div>
                </div>
                <div>
                  <div class="eval-scale-labels">
                    <span>1: Sangat Kurang</span>
                    <span>5: Sangat Baik</span>
                  </div>
                  <div class="eval-rating-container">
                    <% [1, 2, 3, 4, 5].forEach(num => { %>
                      <label class="rating-option" title="Skala <%= num %>">
                        <input type="radio" name="eval_pelayanan" value="<%= num %>" <%= tracer && tracer.eval_pelayanan == num ? 'checked' : '' %> required/>
                        <span><%= num %></span>
                      </label>
                    <% }) %>
                  </div>
                </div>
              </div>

              <!-- Card 5: Program MBKM -->
              <div class="eval-card-item">
                <div class="eval-header-flex">
                  <div class="eval-icon-badge">🚀</div>
                  <div class="eval-info">
                    <h4>Program MBKM</h4>
                    <p>Efektivitas dukungan prodi terhadap program Merdeka Belajar Kampus Merdeka & Magang.</p>
                  </div>
                </div>
                <div>
                  <div class="eval-scale-labels">
                    <span>1: Sangat Kurang</span>
                    <span>5: Sangat Baik</span>
                  </div>
                  <div class="eval-rating-container">
                    <% [1, 2, 3, 4, 5].forEach(num => { %>
                      <label class="rating-option" title="Skala <%= num %>">
                        <input type="radio" name="eval_mbkm" value="<%= num %>" <%= tracer && tracer.eval_mbkm == num ? 'checked' : '' %> required/>
                        <span><%= num %></span>
                      </label>
                    <% }) %>
                  </div>
                </div>
              </div>

            </div>

            <!-- Legacy fields hidden or loaded dynamically -->
            <input type="hidden" name="kompetensi_relevan" value="relevan"/>
            <input type="hidden" name="kepuasan_layanan" value="4"/>

            <div class="form-row" style="margin-top: 2rem;">
              <div class="form-group" style="width: 100%;">
                <label for="saran">Saran dan Masukan</label>
                <textarea name="saran" id="saran" rows="5" placeholder="Tuliskan saran konstruktif Anda untuk kemajuan program studi..." style="width:100%; box-sizing:border-box;"><%= tracer ? tracer.saran || '' : '' %></textarea>
              </div>
            </div>

          </div>
        </div>

        <div class="eval-disclaimer-alert">
          <span class="info-icon-circ">i</span>
          <p>Data ini digunakan secara anonim untuk keperluan akreditasi program studi dan peningkatan mutu pendidikan. Terima kasih atas partisipasi aktif Anda.</p>
        </div>

        <!-- HELP BANNER BOTTOM -->
        <div class="form-bottom-help-banner">
          <div class="help-banner-icon">❓</div>
          <div class="help-banner-text">
            <h5>Bingung Memilih Status?</h5>
            <p>Hubungi pusat bantuan Tracer Study untuk konsultasi terkait pengisian kuesioner.</p>
          </div>
          <a href="#" class="btn btn-outline-dark-green">Tanya Admin</a>
        </div>

        <!-- FORM ACTION BUTTONS -->
        <div class="form-actions-row">
          <a href="/alumni/dashboard" class="btn btn-outline-back">← Kembali ke Dashboard</a>
          <% if (canSubmit) { %>
            <button type="submit" class="btn btn-submit-tracer">
              <svg viewBox="0 0 24 24" class="save-icon"><path fill="currentColor" d="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z"/></svg>
              <span><%= tracer ? 'Perbarui Data Kuesioner' : 'Kirim Kuesioner Tracer' %></span>
            </button>
          <% } else { %>
            <button type="button" class="btn btn-submit-tracer" style="background:#94a3b8; border-color:#94a3b8; cursor:not-allowed;" disabled>
              <svg viewBox="0 0 24 24" class="save-icon"><path fill="currentColor" d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
              <span>Pengisian Ditutup</span>
            </button>
          <% } %>
        </div>

      </form>

    </div>

    <!-- FOOTER -->
    <footer class="main-footer">
      <p>&copy; <%= new Date().getFullYear() %> Information Systems Hamzanwadi University. All Rights Reserved.</p>
    </footer>

  </div>
</div>

<script>
  function openModal(modalId) {
    document.getElementById(modalId).style.display = 'flex';
  }
  
  function closeModal(modalId) {
    document.getElementById(modalId).style.display = 'none';
  }
  
  function closeModalOnBackdrop(e, modalId) {
    if (e.target === e.currentTarget) {
      closeModal(modalId);
    }
  }

  function openStatusModal(status) {
    // Check radio
    const radioId = 'radio' + capitalizeFirstLetter(status);
    const radio = document.getElementById(radioId);
    if (radio) {
      radio.checked = true;
    }
    
    // Highlight option cards
    document.querySelectorAll('.status-option-card').forEach(card => {
      card.classList.remove('selected');
    });
    
    const cardId = 'label' + capitalizeFirstLetter(status);
    const cardEl = document.getElementById(cardId);
    if (cardEl) {
      cardEl.classList.add('selected');
    }
    
    // Show edit badge for this status and hide others
    document.querySelectorAll('.edit-badge').forEach(badge => {
      badge.style.display = 'none';
    });
    
    const badgeId = 'edit' + capitalizeFirstLetter(status);
    const badge = document.getElementById(badgeId);
    if (badge) {
      badge.style.display = 'inline-block';
    }
    
    // Open modal
    const modalId = 'modal' + capitalizeFirstLetter(status);
    openModal(modalId);
  }

  function capitalizeFirstLetter(string) {
    if (string === 'belum_bekerja') return 'BelumBekerja';
    return string.charAt(0).toUpperCase() + string.slice(1);
  }

  // Handle form submission mapping for wirausaha and belum_bekerja to reuse DB fields
  document.getElementById('tracerForm').addEventListener('submit', function(e) {
    const selectedStatus = document.querySelector('input[name="status_pekerjaan"]:checked')?.value;
    
    // Clear all hidden fields first
    document.getElementById('hiddenNamaPerusahaan').value = '';
    document.getElementById('hiddenJabatan').value = '';
    document.getElementById('hiddenBidangPerusahaan').value = '';
    document.getElementById('hiddenLokasiPerusahaan').value = '';
    document.getElementById('hiddenGajiPertama').value = '';
    document.getElementById('hiddenLamaMencariKerja').value = '';
    document.getElementById('hiddenMediaMencariKerja').value = '';
    document.getElementById('hiddenKesesuaianBidang').value = '';
    // Clear new bekerja hidden fields
    document.getElementById('hiddenKapanMulaiCariKerja').value = '';
    document.getElementById('hiddenJenisInstansi').value = '';
    document.getElementById('hiddenPenghasilanBulanan').value = '';
    document.getElementById('hiddenKesesuaianKompetensi').value = '';
    document.getElementById('hiddenPendidikanMinimalS1').value = '';

    if (selectedStatus === 'bekerja') {
      document.getElementById('hiddenNamaPerusahaan').value = document.getElementById('nama_perusahaan_bekerja').value;
      document.getElementById('hiddenJabatan').value = document.getElementById('jabatan_bekerja').value;
      document.getElementById('hiddenBidangPerusahaan').value = document.getElementById('bidang_perusahaan_bekerja').value;
      document.getElementById('hiddenLokasiPerusahaan').value = document.getElementById('lokasi_perusahaan_bekerja').value;
      
      const masaTunggu = document.querySelector('input[name="lama_mencari_kerja_bekerja"]:checked')?.value;
      document.getElementById('hiddenLamaMencariKerja').value = masaTunggu || '';
      
      const kesesuaian = document.querySelector('input[name="kesesuaian_bidang_bekerja"]:checked')?.value;
      document.getElementById('hiddenKesesuaianBidang').value = kesesuaian || '';

      // New bekerja fields
      document.getElementById('hiddenKapanMulaiCariKerja').value = document.getElementById('kapan_mulai_cari_kerja_bekerja').value;
      document.getElementById('hiddenJenisInstansi').value = document.getElementById('jenis_instansi_bekerja').value;
      
      const penghasilan = document.querySelector('input[name="penghasilan_bulanan_bekerja"]:checked')?.value;
      document.getElementById('hiddenPenghasilanBulanan').value = penghasilan || '';
      
      const kesesuaianKompetensi = document.querySelector('input[name="kesesuaian_kompetensi_bekerja"]:checked')?.value;
      document.getElementById('hiddenKesesuaianKompetensi').value = kesesuaianKompetensi || '';
      
      const pendidikanS1 = document.querySelector('input[name="pendidikan_minimal_s1_bekerja"]:checked')?.value;
      document.getElementById('hiddenPendidikanMinimalS1').value = pendidikanS1 || '';
    } else if (selectedStatus === 'wirausaha') {
      document.getElementById('hiddenNamaPerusahaan').value = document.getElementById('inputNamaPerusahaanWira').value;
      document.getElementById('hiddenJabatan').value = document.getElementById('inputJabatanWira').value;
      document.getElementById('hiddenBidangPerusahaan').value = document.getElementById('inputBidangPerusahaanWira').value;
      document.getElementById('hiddenLokasiPerusahaan').value = document.getElementById('inputLokasiPerusahaanWira').value;
      document.getElementById('hiddenGajiPertama').value = document.getElementById('inputGajiPertamaWira').value;
      document.getElementById('hiddenLamaMencariKerja').value = document.getElementById('inputLamaMencariKerjaWira').value;
      document.getElementById('hiddenMediaMencariKerja').value = document.getElementById('inputMediaMencariKerjaWira').value;
      document.getElementById('hiddenKesesuaianBidang').value = document.getElementById('inputKesesuaianBidangWira').value;
    } else if (selectedStatus === 'belum_bekerja') {
      document.getElementById('hiddenLamaMencariKerja').value = document.getElementById('inputLamaMencariKerjaBelum').value;
    }
  });

  // Style rating options in modal when clicked (visual feedback)
  document.querySelectorAll('#modalBekerja .rating-option input[type="radio"]').forEach(radio => {
    radio.addEventListener('change', function() {
      const container = this.closest('.eval-rating-container');
      if (container) {
        container.querySelectorAll('.rating-option span').forEach(span => {
          span.style.background = '#f8fafc';
          span.style.borderColor = '#e2e8f0';
          span.style.color = '#334155';
          span.style.boxShadow = 'none';
          span.style.transform = 'scale(1)';
        });
        const checkedSpan = this.nextElementSibling;
        if (checkedSpan) {
          checkedSpan.style.background = '#064E3B';
          checkedSpan.style.borderColor = '#064E3B';
          checkedSpan.style.color = '#ffffff';
          checkedSpan.style.boxShadow = '0 4px 12px rgba(6, 78, 59, 0.25)';
          checkedSpan.style.transform = 'scale(1.04)';
        }
      }
    });
  });

  // Run on page load to configure initially selected state if editing existing tracer
  window.addEventListener('DOMContentLoaded', () => {
    const selectedStatus = document.querySelector('input[name="status_pekerjaan"]:checked')?.value;
    if (selectedStatus) {
      const cardId = 'label' + capitalizeFirstLetter(selectedStatus);
      const card = document.getElementById(cardId);
      if (card) card.classList.add('selected');
      
      const badgeId = 'edit' + capitalizeFirstLetter(selectedStatus);
      const badge = document.getElementById(badgeId);
      if (badge) badge.style.display = 'inline-block';
    }

    <% if (!canSubmit) { %>
      // Disable all inputs, textareas, selects, and status cards inside tracerForm
      const form = document.getElementById('tracerForm');
      if (form) {
        const elements = form.querySelectorAll('input, select, textarea, button:not(.btn-outline-back)');
        elements.forEach(el => {
          el.disabled = true;
          el.style.pointerEvents = 'none';
          el.style.opacity = '0.7';
        });
        
        // Also style the status cards as read-only
        document.querySelectorAll('.status-option-card').forEach(card => {
          card.style.pointerEvents = 'none';
          card.style.opacity = '0.8';
          card.style.cursor = 'default';
        });
      }
    <% } %>
  });

  // Auto dismiss flash alerts
  setTimeout(() => {
    document.querySelectorAll('.alert').forEach(el => {
      el.style.opacity = '0';
      setTimeout(() => el.remove(), 500);
    });
  }, 4000);
</script>
</body>
</html>
