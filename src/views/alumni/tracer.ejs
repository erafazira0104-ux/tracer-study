                <div class="form-group" style="flex: 1; min-width: 250px;">
                  <label>Posisi / Peran dalam Usaha</label>
                  <input type="text" name="jabatan_wira" id="inputJabatanWira" value="<%= tracer && tracer.status_pekerjaan === 'wirausaha' ? tracer.jabatan || '' : '' %>" placeholder="Owner, Co-Founder, dll"/>
