<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/css/public.css" />
  <link rel="stylesheet" href="/css/beranda.css" />
</head>

<body>

  <!-- ===== NAVBAR ===== -->
  <%- include('partials/public-navbar') %>

  <!-- ===== HERO ===== -->
  <section class="hero">
    <!-- Automatic Background Slideshow -->
    <div class="hero-slides">
      <div class="hero-slide active" style="background-image: linear-gradient(180deg, rgba(15, 23, 42, 0.65) 0%, rgba(15, 23, 42, 0.8) 100%), url('/images/students-hero.jpg');"></div>
      <div class="hero-slide" style="background-image: linear-gradient(180deg, rgba(15, 23, 42, 0.65) 0%, rgba(15, 23, 42, 0.8) 100%), url('/images/mbkm-international.png');"></div>
    </div>

    <div class="hero-container">
      <div class="hero-tag">
        <svg viewBox="0 0 24 24">
          <path d="M12 3L1 9l11 6 9-4.91V17h2V9L12 3zM5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82z" />
        </svg>
        Fakultas Teknik Hamzanwadi
      </div>

      <h1>Portal Tracer Study Alumni<br />Sistem Informasi.</h1>

      <p>Media resmi penelusuran alumni Program Studi Sistem Informasi Fakultas Teknik Universitas Hamzanwadi untuk
        mendukung monitoring lulusan, informasi karir, dan pengembangan kompetensi alumni.</p>

      <div class="hero-actions">
        <a href="/login" class="btn-primary">
          <span>Isi Tracer Study</span>
          <svg viewBox="0 0 24 24" class="btn-icon">
            <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round"
              stroke-linejoin="round" />
          </svg>
        </a>
        <a href="/lowongan" class="btn-outline">
          Lihat Lowongan Kerja
        </a>
      </div>
    </div>
  </section>

  <section class="section statistik">
    <div class="section-container">
      <!-- Floating decorative glowing blobs -->
      <div class="stat-glow-1"></div>
      <div class="stat-glow-2"></div>
      
      <div class="stat-header">
        <span class="section-badge">METRIK UTAMA</span>
        <h2>Statistik Alumni</h2>
        <p>Gambaran umum perkembangan karir lulusan Sistem Informasi.</p>
      </div>

      <div class="stat-grid">
        <div class="stat-card">
          <div class="stat-icon icon-total">
            <svg viewBox="0 0 24 24">
              <path
                d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" />
            </svg>
          </div>
          <div class="stat-number-wrap">
            <span class="stat-number counter" data-target="<%= statistik.totalAlumni %>">
              <%= statistik.totalAlumni.toLocaleString('id-ID') %>
            </span>
          </div>
          <div class="stat-label">Total Alumni</div>
        </div>

        <div class="stat-card">
          <div class="stat-icon icon-work">
            <svg viewBox="0 0 24 24">
              <path
                d="M20 6h-2.18c.07-.44.18-.88.18-1.35C18 2.53 15.47 0 12 0 8.53 0 6 2.53 6 4.65c0 .47.11.91.18 1.35H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-8 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z" />
            </svg>
          </div>
          <div class="stat-number-wrap">
            <span class="stat-number counter" data-target="<%= statistik.alumniBekerja %>">
              <%= statistik.alumniBekerja.toLocaleString('id-ID') %>
            </span>
          </div>
          <div class="stat-label">Alumni Bekerja</div>
        </div>

        <div class="stat-card">
          <div class="stat-icon icon-entrepreneur">
            <svg viewBox="0 0 24 24">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke="currentColor" stroke-width="2"
                fill="none" />
            </svg>
          </div>
          <div class="stat-number-wrap">
            <span class="stat-number counter" data-target="<%= statistik.alumniWirausaha %>">
              <%= statistik.alumniWirausaha.toLocaleString('id-ID') %>
            </span>
          </div>
          <div class="stat-label">Alumni Wirausaha</div>
        </div>

        <div class="stat-card">
          <div class="stat-icon icon-study">
            <svg viewBox="0 0 24 24">
              <path d="M5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82zM12 3L1 9l11 6 9-4.91V17h2V9L12 3z" />
            </svg>
          </div>
          <div class="stat-number-wrap">
            <span class="stat-number counter" data-target="<%= statistik.melanjutkanStudi %>">
              <%= statistik.melanjutkanStudi.toLocaleString('id-ID') %>
            </span>
          </div>
          <div class="stat-label">Melanjutkan Studi</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CHART SECTION ===== -->
  <section class="section chart-section">
    <div class="section-container">
      <div class="chart-header">
        <div class="section-badge">TREN KARIR</div>
        <h2>Penyerapan Lulusan di Dunia Kerja</h2>
        <p>Grafik persentase alumni yang langsung bekerja &lt; 6 bulan setelah wisuda (Tahun Lulus 2020 - 2025).</p>
      </div>

      <!-- Quick Metrics Summary Bar -->
      <div class="chart-metrics-row">
        <div class="metric-item">
          <div class="metric-val">93%</div>
          <div class="metric-lbl">Puncak Keterserapan (2025)</div>
        </div>
        <div class="metric-divider"></div>
        <div class="metric-item">
          <div class="metric-val">&lt; 2.8 Bln</div>
          <div class="metric-lbl">Rata-rata Masa Tunggu Kerja</div>
        </div>
        <div class="metric-divider"></div>
        <div class="metric-item">
          <div class="metric-val">96.4%</div>
          <div class="metric-lbl">Tingkat Kepuasan Pengguna</div>
        </div>
      </div>

      <div class="chart-container-wrap">
        <div class="chart-card">
          <canvas id="employmentTrendChart"></canvas>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== ALUR CARA KERJA TRACER STUDY ===== -->
  <section class="section how-it-works">
    <div class="section-container">
      <div class="how-header">
        <div class="section-badge">PANDUAN ALUMNI</div>
        <h2>3 Langkah Mudah Berpartisipasi</h2>
        <p>Proses singkat pengisian Tracer Study untuk membantu pengembangan almamater Anda.</p>
      </div>

      <div class="steps-grid">
        <div class="step-card">
          <div class="step-number">01</div>
          <div class="step-icon">
            <svg viewBox="0 0 24 24">
              <path
                d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z" />
            </svg>
          </div>
          <h3>Login Akun Alumni</h3>
          <p>Gunakan NIM / Email terdaftar untuk masuk ke portal Tracer Study Sistem Informasi.</p>
        </div>

        <div class="step-card">
          <div class="step-number">02</div>
          <div class="step-icon">
            <svg viewBox="0 0 24 24">
              <path
                d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" />
            </svg>
          </div>
          <h3>Lengkapi Kuesioner</h3>
          <p>Isi formulir tracer study mengenai pekerjaan, pengalaman, dan saran untuk program studi.</p>
        </div>

        <div class="step-card">
          <div class="step-number">03</div>
          <div class="step-icon">
            <svg viewBox="0 0 24 24">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
            </svg>
          </div>
          <h3>Nikmati Layanan Karir</h3>
          <p>Dapatkan akses eksklusif info lowongan kerja IT dan layanan konseling karir alumni.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== LAYANAN & FITUR ===== -->
  <section class="section layanan">
    <div class="section-container">
      <div class="layanan-header">
        <h2>Layanan & Fitur Portal</h2>
        <p>Kami menyediakan berbagai alat untuk mendukung kesuksesan karir dan menjaga hubungan alumni dengan program studi.</p>
      </div>

      <div class="layanan-grid">
        <div class="layanan-card">
          <div class="layanan-icon icon-emerald">
            <svg viewBox="0 0 24 24">
              <path
                d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" />
            </svg>
          </div>
          <h3>Tracer Study</h3>
          <p>Penelusuran data karir alumni untuk akreditasi dan pengembangan kurikulum Sistem Informasi.</p>
          <a href="/login" class="layanan-link">
            <span>Mulai Survei</span>
            <svg viewBox="0 0 24 24">
              <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
          </a>
        </div>

        <div class="layanan-card">
          <div class="layanan-icon icon-blue">
            <svg viewBox="0 0 24 24">
              <path d="M3 3h8v8H3zm10 0h8v8h-8zM3 13h8v8H3zm10 5h3v-3h2v3h3v2h-3v3h-2v-3h-3z" />
            </svg>
          </div>
          <h3>Dashboard Alumni</h3>
          <p>Akses profil profesional Anda, perbarui data kontak, dan lihat riwayat karir Anda.</p>
          <a href="/dashboard" class="layanan-link">
            <span>Buka Dashboard</span>
            <svg viewBox="0 0 24 24">
              <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
          </a>
        </div>

        <div class="layanan-card">
          <div class="layanan-icon icon-amber">
            <svg viewBox="0 0 24 24">
              <path
                d="M20 6h-2.18c.07-.44.18-.88.18-1.35C18 2.53 15.47 0 12 0 8.53 0 6 2.53 6 4.65c0 .47.11.91.18 1.35H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-8 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z" />
            </svg>
          </div>
          <h3>Lowongan Kerja</h3>
          <p>Dapatkan informasi peluang kerja eksklusif di bidang IT dan Sistem Informasi.</p>
          <a href="/lowongan" class="layanan-link">
            <span>Cari Loker</span>
            <svg viewBox="0 0 24 24">
              <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
          </a>
        </div>

        <div class="layanan-card">
          <div class="layanan-icon icon-purple">
            <svg viewBox="0 0 24 24">
              <path
                d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.23-.26-.38-.61-.38-.99 0-.83.67-1.5 1.5-1.5H16c2.76 0 5-2.24 5-5 0-4.42-4.03-8-9-8z" />
            </svg>
          </div>
          <h3>Konseling Karir</h3>
          <p>Layanan bimbingan karir dan persiapan dunia kerja bagi alumni muda.</p>
          <a href="/konseling" class="layanan-link">
            <span>Konsultasi</span>
            <svg viewBox="0 0 24 24">
              <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CTA BANNER ===== -->
  <section class="section cta-section">
    <div class="section-container">
      <div class="cta-banner">
        <div class="cta-content">
          <h2>Berkontribusi untuk Almamater</h2>
          <p>Data yang Anda berikan melalui Tracer Study sangat berharga bagi pengembangan kualitas akademik dan akreditasi Program Studi Sistem Informasi.</p>
          <a href="/login" class="btn-cta">
            <svg viewBox="0 0 24 24" class="btn-cta-icon">
              <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
            </svg>
            Isi Tracer Study Sekarang
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FOOTER ===== -->
  <%- include('partials/public-footer') %>

  <!-- Chart.js and Custom Script -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      // Hero Background Slideshow
      const slides = document.querySelectorAll('.hero-slide');
      let currentSlide = 0;
      if (slides.length > 0) {
        setInterval(() => {
          slides[currentSlide].classList.remove('active');
          currentSlide = (currentSlide + 1) % slides.length;
          slides[currentSlide].classList.add('active');
        }, 2000); // changes every 2 seconds
      }

      // Counter Animation
      const counters = document.querySelectorAll('.counter');
      const speed = 200;

      const animateCounters = () => {
        counters.forEach(counter => {
          const target = +counter.getAttribute('data-target');
          if (!target) return;
          const count = +counter.innerText.replace(/\D/g, '') || 0;
          const inc = target / speed;

          if (count < target) {
            let current = count + Math.ceil(inc);
            if (current > target) current = target;
            counter.innerText = current.toLocaleString('id-ID');
            setTimeout(animateCounters, 15);
          } else {
            counter.innerText = target.toLocaleString('id-ID');
          }
        });
      };

      // Intersection Observer for Counter Animation
      const statSection = document.querySelector('.statistik');
      if (statSection && 'IntersectionObserver' in window) {
        let animated = false;
        const observer = new IntersectionObserver((entries) => {
          if (entries[0].isIntersecting && !animated) {
            animated = true;
            animateCounters();
          }
        }, { threshold: 0.2 });
        observer.observe(statSection);
      } else {
        animateCounters();
      }

      // Chart setup
      const canvas = document.getElementById('employmentTrendChart');
      if (canvas) {
        const ctx = canvas.getContext('2d');
        const gradient = ctx.createLinearGradient(0, 0, 0, 300);
        gradient.addColorStop(0, 'rgba(6, 78, 59, 0.35)');
        gradient.addColorStop(1, 'rgba(6, 78, 59, 0.00)');

        new Chart(ctx, {
          type: 'line',
          data: {
            labels: ['2020', '2021', '2022', '2023', '2024', '2025'],
            datasets: [{
              label: 'Persentase Bekerja < 6 Bulan',
              data: [72, 78, 83, 85, 89, 93],
              borderColor: '#064E3B',
              borderWidth: 3.5,
              backgroundColor: gradient,
              fill: true,
              tension: 0.4,
              pointBackgroundColor: '#064E3B',
              pointBorderColor: '#ffffff',
              pointBorderWidth: 2,
              pointRadius: 6,
              pointHoverRadius: 8,
              pointHoverBackgroundColor: '#047857',
              pointHoverBorderColor: '#ffffff',
              pointHoverBorderWidth: 3
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { display: false },
              tooltip: {
                backgroundColor: '#0F172A',
                titleFont: { size: 13, weight: 'bold', family: "'Plus Jakarta Sans', sans-serif" },
                bodyFont: { size: 12, family: "'Plus Jakarta Sans', sans-serif" },
                padding: 12,
                cornerRadius: 8,
                displayColors: false,
                callbacks: {
                  label: function (context) {
                    return ` ${context.parsed.y}% Alumni Terserap Kerja`;
                  }
                }
              }
            },
            scales: {
              x: {
                grid: { display: false },
                ticks: { color: '#64748B', font: { size: 12, weight: '600', family: "'Plus Jakarta Sans', sans-serif" } }
              },
              y: {
                min: 50, max: 100,
                ticks: {
                  stepSize: 10,
                  color: '#64748B',
                  font: { size: 12, weight: '600', family: "'Plus Jakarta Sans', sans-serif" },
                  callback: function (value) { return value + '%'; }
                },
                grid: { color: 'rgba(226, 232, 240, 0.7)', borderDash: [4, 4] }
              }
            }
          }
        });
      }
    });
  </script>

</body>

</html>