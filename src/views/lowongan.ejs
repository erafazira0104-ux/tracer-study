<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/public.css" />
    <link rel="stylesheet" href="/css/lowongan.css" />
</head>

<body>

    <!-- ===== NAVBAR ===== -->
    <%- include('partials/public-navbar') %>

    <!-- ===== HERO ===== -->
    <section class="hero">
        <div class="hero-icon-wrap">
            <svg viewBox="0 0 24 24">
                <path
                    d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" />
            </svg>
        </div>
        <h1>Temukan Karir <span>Impian Anda</span></h1>
        <div class="hero-divider"></div>
        <p>Akses eksklusif bagi alumni Sistem Informasi Universitas Hamzanwadi untuk terhubung dengan jaringan
            perusahaan mitra terkemuka di industri teknologi global.</p>
    </section>

    <!-- ===== DAFTAR LOWONGAN ===== -->
    <section class="section lowongan-section">
        <div class="lowongan-list">
            <% if (lowongans && lowongans.length > 0) { %>
                <% lowongans.forEach(function(job) { %>
                    <div class="lowongan-card">
                        <div class="lowongan-img-wrap">
                            <% if (job.gambar) { %>
                                <img src="<%= job.gambar %>" alt="<%= job.judul %>" class="lowongan-img" />
                            <% } else { %>
                                <div class="lowongan-img-placeholder">
                                    <svg viewBox="0 0 24 24">
                                        <path
                                            d="M20 6h-2.18c.07-.44.18-.88.18-1.35C18 2.53 15.47 0 12 0 8.53 0 6 2.53 6 4.65c0 .47.11.91.18 1.35H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-8 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z" />
                                    </svg>
                                </div>
                            <% } %>
                        </div>
                        <div class="lowongan-info">
                            <h2 class="lowongan-title">
                                <%= job.judul %>
                            </h2>
                            <p class="lowongan-desc">
                                <%= job.deskripsi %>
                            </p>
                            <div class="lowongan-meta">
                                <svg viewBox="0 0 24 24">
                                    <path
                                        d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" />
                                </svg>
                                <span>
                                    <%= job.lokasi %>
                                </span>
                            </div>
                        </div>
                        <div class="lowongan-action">
                            <a href="#" onclick="openAksesModal(event, '<%= job.id %>', '<%= job.link || '#' %>')"
                                class="btn-lamar">Lamar Sekarang</a>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="lowongan-empty">
                    <p>Belum ada lowongan tersedia saat ini.</p>
                </div>
            <% } %>
        </div>

        <!-- PAGINATION -->
        <% if (totalHalaman > 1) { %>
            <div class="pagination">
                <a href="/lowongan?halaman=<%= halaman > 1 ? halaman - 1 : 1 %>"
                    class="page-btn nav-btn <%= halaman <= 1 ? 'disabled' : '' %>">
                    <svg viewBox="0 0 24 24">
                        <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z" />
                    </svg>
                </a>
                <% for (let i = 1; i <= totalHalaman; i++) { %>
                    <a href="/lowongan?halaman=<%= i %>" class="page-btn <%= i === halaman ? 'active' : '' %>">
                        <%= i %>
                    </a>
                <% } %>
                <a href="/lowongan?halaman=<%= halaman < totalHalaman ? halaman + 1 : totalHalaman %>"
                    class="page-btn nav-btn <%= halaman >= totalHalaman ? 'disabled' : '' %>">
                    <svg viewBox="0 0 24 24">
                        <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z" />
                    </svg>
                </a>
            </div>
        <% } %>
    </section>

    <!-- ===== FOOTER ===== -->
    <%- include('partials/public-footer') %>

    <!-- Modal Form Akses Lowongan -->
    <div class="modal-overlay" id="aksesModal">
        <div class="modal-box">
            <div class="modal-header">
                <h3>Form Akses Lowongan</h3>
                <button type="button" onclick="closeAksesModal()" class="btn-close-modal">&times;</button>
            </div>
            <form id="aksesForm" onsubmit="submitAksesForm(event)" class="modal-form">
                <input type="hidden" name="lowongan_id" id="akses_lowongan_id" />

                <div class="form-group">
                    <label>Nama Lengkap <span class="required">*</span></label>
                    <input type="text" name="nama" required placeholder="Masukkan nama lengkap Anda" />
                </div>

                <div class="form-group">
                    <label>NIM <span class="required">*</span></label>
                    <input type="text" name="nim" required placeholder="Masukkan NIM Anda" />
                </div>

                <div class="form-group">
                    <label>Email <span class="required">*</span></label>
                    <input type="email" name="email" required placeholder="name@example.com" />
                </div>

                <div class="form-group">
                    <label>Nomor HP / WhatsApp</label>
                    <input type="text" name="no_hp" placeholder="08xxxxxxxxxx" />
                </div>

                <div class="modal-actions">
                    <button type="button" onclick="closeAksesModal()" class="btn-cancel">Batal</button>
                    <button type="submit" class="btn-submit">Kirim &amp; Lanjutkan</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const alumniData = {
            nama: "<%= (typeof alumniName !== 'undefined' && alumniName) ? alumniName : (locals.alumniName || '') %>",
            nim: "<%= (typeof alumniNim !== 'undefined' && alumniNim) ? alumniNim : (locals.alumniNim || '') %>",
            email: "<%= (typeof alumniEmail !== 'undefined' && alumniEmail) ? alumniEmail : (locals.alumniEmail || '') %>"
        };

        let currentTargetUrl = '';

        function formatTargetUrl(url) {
            if (!url || url === '#' || url === 'null' || url.trim() === '') return '';
            let clean = url.trim();
            if (!/^https?:\/\//i.test(clean)) {
                clean = 'https://' + clean;
            }
            return clean;
        }

        function openAksesModal(event, jobId, jobUrl) {
            event.preventDefault();

            currentTargetUrl = formatTargetUrl(jobUrl);
            document.getElementById('akses_lowongan_id').value = jobId;

            const form = document.getElementById('aksesForm');
            if (alumniData.nama && form.nama) form.nama.value = alumniData.nama;
            if (alumniData.nim && form.nim) form.nim.value = alumniData.nim;
            if (alumniData.email && form.email) form.email.value = alumniData.email;

            // Show modal with animation
            const modal = document.getElementById('aksesModal');
            modal.style.display = 'flex';
            // Force reflow
            modal.offsetHeight;
            modal.classList.add('show');
        }

        function closeAksesModal() {
            const modal = document.getElementById('aksesModal');
            modal.classList.remove('show');
            setTimeout(() => {
                modal.style.display = 'none';
            }, 300);
        }

        function submitAksesForm(e) {
            e.preventDefault();
            const form = document.getElementById('aksesForm');
            const payload = {
                lowongan_id: document.getElementById('akses_lowongan_id').value,
                nama: form.nama.value,
                nim: form.nim.value,
                email: form.email.value,
                no_hp: form.no_hp.value
            };

            fetch('/lowongan/akses', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
                .then(r => r.json())
                .then(res => {
                    if (res.ok) {
                        closeAksesModal();
                        if (currentTargetUrl) {
                            window.open(currentTargetUrl, '_blank');
                        } else {
                            alert('Data lamaran Anda berhasil dikirim! Terima kasih.');
                        }
                    } else {
                        alert(res.message || 'Gagal menyimpan akses.');
                    }
                })
                .catch(err => {
                    console.error('Error logging access:', err);
                    alert('Terjadi kesalahan koneksi.');
                });
        }
    </script>
</body>

</html>