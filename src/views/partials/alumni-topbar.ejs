<div class="top-header" style="justify-content: space-between; height: 60px; padding: 0 24px; display:flex; align-items:center; background:#fff; border-bottom:1px solid #e2e8f0; width:100%; box-sizing: border-box;">
  <div class="header-title-area" style="text-align: left;">
    <h1 style="font-size:16px; font-weight:800; color:#064E3B; margin:0;"><%= typeof topbarTitle !== 'undefined' ? topbarTitle : 'Dashboard Overview' %></h1>
    <p style="font-size:11px; color:#666; margin:2px 0 0;"><%= typeof topbarSub !== 'undefined' ? topbarSub : 'Sistem Informasi Hamzanwadi University' %></p>
  </div>
  
  <div class="header-widgets" style="display:flex; align-items:center; gap:16px;">
    <!-- Profile Dropdown (matched to admin style) -->
    <div class="profile-dropdown" style="position:relative; display:inline-block;">
      <button class="profile-dropbtn" onclick="toggleAlumniProfileMenu(event)" style="display:flex; align-items:center; gap:8px; background:none; border:none; cursor:pointer; padding:6px 12px; border-radius:20px; transition: background 0.2s;">
        <div class="profile-avatar-img" style="width:32px; height:32px; border-radius:50%; background:#2d6a4f; color:#fff; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:13px; text-transform:uppercase; overflow:hidden; flex-shrink:0;">
          <%= alumni.nama[0].toUpperCase() %>
        </div>
        <span class="profile-name" style="font-size:12px; font-weight:600; color:#333;"><%= alumni.nama.split(' ')[0] %></span>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" style="color:#555;"><path d="M7 10l5 5 5-5z"/></svg>
      </button>
      <div id="alumniProfileDropdown" class="dropdown-content" style="display:none; position:absolute; right:0; background-color:#fff; min-width:160px; box-shadow:0px 8px 16px 0px rgba(0,0,0,0.1); border:1px solid #e2e8f0; border-radius:8px; z-index:100; margin-top:4px; overflow:hidden;">
        <a href="/alumni/change-password" style="color:#333; padding:10px 16px; text-decoration:none; display:block; font-size:12px; font-weight:500; text-align:left; transition: background 0.2s;">Ganti Sandi</a>
        <a href="#" onclick="event.preventDefault(); document.getElementById('alumni-logout-form').submit();" style="color:#333; padding:10px 16px; text-decoration:none; display:block; font-size:12px; font-weight:500; text-align:left; transition: background 0.2s;">Keluar</a>
        <form id="alumni-logout-form" action="/login/logout" method="POST" style="display:none;"></form>
      </div>
    </div>
  </div>
</div>

<script>
  function toggleAlumniProfileMenu(e) {
    e.stopPropagation();
    const dropdown = document.getElementById('alumniProfileDropdown');
    if (dropdown) {
      const isHidden = dropdown.style.display === 'none' || dropdown.style.display === '';
      dropdown.style.display = isHidden ? 'block' : 'none';
    }
  }
  window.addEventListener('click', function(event) {
    var dropdown = document.getElementById('alumniProfileDropdown');
    if (dropdown) {
      dropdown.style.display = 'none';
    }
  });
</script>
