<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <link rel="stylesheet" href="/css/public.css"/>
  <link rel="stylesheet" href="/css/riwayatkonseling.css"/>
</head>
<body>

<!-- ===== NAVBAR ===== -->
<%- include('partials/public-navbar') %>

<!-- ===== MAIN ===== -->
<main class="main">

  <!-- SUCCESS ICON -->
  <div class="success-icon-wrap">
    <div class="success-icon-ring">
      <div class="success-icon">
        <svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
      </div>
    </div>
  </div>

  <!-- SUCCESS TITLE -->
  <h1 class="success-title">Data Konsultasi Berhasil Disimpan</h1>
  <p class="success-desc">Terima kasih telah melakukan pengisian. Permintaan konsultasi Anda telah kami terima dan akan segera diproses oleh tim konselor kami.</p>

  <!-- INFO CARDS -->
  <div class="info-grid">
    <div class="info-card">
      <div class="info-card-header">
        <div class="info-icon">
          <svg viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"/></svg>
        </div>
        <span class="info-card-title">Waktu Respon</span>
      </div>
      <p class="info-card-text">Konselor akan menanggapi dalam waktu 1x24 jam pada hari kerja (Senin–Jumat).</p>
    </div>
    <div class="info-card">
      <div class="info-card-header">
        <div class="info-icon">
          <svg viewBox="0 0 24 24"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
        </div>
        <span class="info-card-title">Kerahasiaan</span>
      </div>
      <p class="info-card-text">Semua data dan isi pembicaraan konsultasi Anda dijamin kerahasiaannya sesuai kode etik.</p>
    </div>
  </div>

  <!-- ACTION BUTTONS -->
  <div class="action-wrap">
    <a href="https://wa.me/<%= typeof whatsappNumber !== 'undefined' ? whatsappNumber : '6282340000000' %>?text=<%= typeof waMessageText !== 'undefined' ? waMessageText : '' %>" target="_blank" class="btn-whatsapp">
      <svg viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg>
      Hubungi Konselor melalui WhatsApp <% if (typeof namaKonselor !== 'undefined' && namaKonselor) { %>(<%= namaKonselor %>)<% } %>
    </a>
    <a href="/beranda" class="btn-back-dashboard">
      ← Kembali ke Beranda
    </a>
  </div>

</main>

<!-- ===== FOOTER ===== -->
<%- include('partials/public-footer') %>

</body>
</html>